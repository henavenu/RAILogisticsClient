# ── Keep the Linux image clean & small ───────────────────────────────────────
# Virtual environments hold WINDOWS binaries — they must never enter the image.
**/venv/
venv/
.venv/
**/env/

# Secrets / host-specific config — NEVER bake into the image.
# Every service's .env carries live keys (GROQ/AZURE/AWS/...) and host-only values
# (e.g. Windows DB paths) that break or leak inside the container. The entrypoint
# supplies all non-secret config; real secrets are injected at runtime via
# `docker run -e ...` / Cloud Run `--set-secrets`. (.env.example templates are kept.)
.env
**/.env

# VCS / IDE / agent tooling
.git/
.gitignore
.gitattributes
.claude/
.vscode/
.idea/

# Python caches / build artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
dist/
build/

# Logs & local runtime spew (audit.jsonl can be large)
**/logs/
**/*.log
**/*.out
**/*.err
**/*.jsonl

# Docker artifacts / OS cruft
**/.DS_Store
Thumbs.db

# ── PAP databases ─────────────────────────────────────────────────────────────
# The dev pap.db is ~116 MB — almost all of it is AUDIT/runtime history
# (metric_snapshots, audit_evaluation_*, etc.), which the deployment does NOT need.
# We exclude it (and the other dev DB files) and instead ship pap.seed.db: a
# ~600 KB CONFIG-ONLY snapshot (all config_* tables seeded; audit tables present
# but empty). The entrypoint copies pap.seed.db → pap.db on boot. Regenerate the
# seed after a policy change with tools/make_seed_db.py (or export_policy_config.py
# for a text/.sql snapshot). See docs/DEPLOY_GCP_CloudRun.md.
pap/config/pap.db
pap/config/pap_old.db
pap/config/rai_trust.db
# pap/config/pap.seed.db is intentionally KEPT (it is the shipped policy seed).
# CRITICAL: never bake SQLite sidecar files. The local PAP runs in WAL mode, so
# stale pap.db-wal / pap.db-shm exist on the host; if copied in, SQLite applies the
# mismatched WAL to the freshly-seeded pap.db at boot → "database disk image is
# malformed". Exclude all WAL/SHM/journal sidecars everywhere.
**/*.db-wal
**/*.db-shm
**/*.db-journal
