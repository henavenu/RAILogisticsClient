# assurance/.env.example — Assurance Service environment template
#
# SETUP (new node / fresh clone):
#   1. Copy this file:           cp assurance/.env.example assurance/.env
#   2. Edit assurance/.env       fill in the placeholders marked <-- CHANGE THIS
#   3. Start the service:        cd assurance && start_assurance.bat
#
# LAYERING: assurance/.env is read by api/main.py via load_dotenv() at startup
# with CWD=assurance/. Anything set in repo-root .env or via start_all.bat
# process-env DOES NOT override these unless you also set them there.
#
# NOTE: .env is gitignored — never commit it. This .env.example IS committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM-as-judge provider ────────────────────────────────────────────────────
# Supported: openai | anthropic | azure_openai
# Default in code is "openai" — Azure deploys must set this explicitly.
JUDGE_PROVIDER=openai
JUDGE_MODEL=                                       # <-- CHANGE THIS  (e.g., gpt-4o-mini)

# Azure OpenAI credentials (only when JUDGE_PROVIDER=azure_openai)
# AZURE_OPENAI_API_KEY=                            # <-- CHANGE THIS
# AZURE_OPENAI_ENDPOINT=                           # <-- CHANGE THIS  (https://...openai.azure.com/)
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic credentials (only when JUDGE_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=                               # <-- CHANGE THIS

# OpenAI credentials (only when JUDGE_PROVIDER=openai)
# OPENAI_API_KEY=                                  # <-- CHANGE THIS

# ── Arize ingestion (used by arize_provider.py to pull spans) ───────────────
ARIZE_API_KEY=                                     # <-- CHANGE THIS
ARIZE_SPACE_ID=                                    # <-- CHANGE THIS

# ── Provider selection — which span source to use ──────────────────────────
# mock  — synthetic spans, no external deps (safe default for local dev)
# arize — real Arize integration (requires ARIZE_API_KEY + ARIZE_SPACE_ID)
# local — reads spans from data/spans.jsonl
ASSURANCE_PROVIDER=mock

# ── LLM-cache mode for /v1/metrics ──────────────────────────────────────────
# When true, /v1/metrics serves the 6 LLM-judge metric IDs (hallucination_rate,
# groundedness_score, response_relevance, toxicity_judge_rate,
# prompt_injection_rate, pii_exposure_rate) from the LLM-evals cache populated
# by the background scheduler.
# Without this flag, /v1/metrics only dispatches to the statistical fast-path
# (run_cycle) and the 6 LLM IDs come back as data_status=no_data.
# REQUIRED for the PAP cockpit's T2 EVAL QUALITY radar to populate.
METRICS_USE_LLM_CACHE=true

# ── Eval cache refresh cadence (minutes) ─────────────────────────────────────
# How often the background scheduler re-runs LLM-as-judge evals. Default 15.
# LLM_EVAL_CACHE_REFRESH_MIN=15

# ── Optional: network binding overrides ─────────────────────────────────────
# Default host/port for the FastAPI uvicorn process. Change if 8000 clashes.
# ASSURANCE_HOST=127.0.0.1
# ASSURANCE_PORT=8000
