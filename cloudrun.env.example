# VitaLink on Cloud Run — environment variables (copy to cloudrun.env for `docker run --env-file`;
# on Cloud Run set them on the service). RAI_APP_KEY and LLM keys belong in Secret Manager.

# ── RAI Trust SDK (names must match exactly) ──────────────────────────────────
RAI_PE_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/pe/
RAI_PAP_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/pap/
RAI_EVAL_MODE=SYNC
RAI_ENFORCEMENT_MODE=RAISE
RAI_TIMEOUT=30
RAI_PRIVACY_PROXY=regex
RAI_GOVERN_RETURNS=false

# ── App identity on the platform ──────────────────────────────────────────────
TRUST_APP_ID=pharmalogistics
RAI_APP_KEY=                       # secret: issued by onboard_trust.py / the platform team

# ── Platform URLs the app calls directly (NO trailing slash: the app appends /v1/…) ──
TRUST_PE_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/pe
PAP_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/pap
SENTINEL_URL=                      # confirm the platform route with the platform team
COORDINATOR_URL=                   # confirm the platform route with the platform team
TRUST_DASHBOARD_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/ui/dashboard
MYBANK_CALLBACK_URL=               # this service's own Cloud Run URL (PAP calls back on approval)

# ── LLM: Gemini on Vertex AI (service account needs roles/aiplatform.user) ────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# or Groq instead (leave GOOGLE_CLOUD_PROJECT empty):
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
