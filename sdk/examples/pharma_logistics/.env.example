# ════════════════════════════════════════════════════════════════════════════
# MyBank (clean) — runtime configuration TEMPLATE
# Copy to .env and fill in your values. NEVER commit real secrets to this file.
#
# Cloud/container: the platform injects the LLM credentials as environment
#   variables, which OVERRIDE anything set here.
# ════════════════════════════════════════════════════════════════════════════

# ── LLM provider selection ───────────────────────────────────────────────────
# Provider priority (resolved in graph.py, first match wins):
#   0. LLM_DISABLED=true        -> stub chat model (no external LLM calls; CI)
#   1. GOOGLE_CLOUD_PROJECT set -> Google Gemini via Vertex AI  (cloud / Cloud Run)
#   2. ANTHROPIC_API_KEY set    -> Anthropic Claude             (cloud fallback / local)
#   3. AZURE_OPENAI_API_KEY set -> Azure OpenAI                 (cloud)
#   4. GROQ_API_KEY set         -> Groq                         (local dev)
# CLOUD = Gemini / Anthropic / Azure; LOCAL = Groq or Anthropic. To force Anthropic,
# set ANTHROPIC_API_KEY and leave GOOGLE_CLOUD_PROJECT UNSET. Set exactly one set.
LLM_DISABLED=false

# 1) Google Gemini via Vertex AI (cloud) — Application Default Credentials, no key.
#    GEMINI_MODEL is the model id enabled in your project. Location defaults to
#    'global' (broadest model coverage); override with a region only if your model
#    is served regionally for your project.
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=global          # or a region, e.g. us-central1
# GEMINI_MODEL=gemini-2.5-flash

# 2) Anthropic Claude (cloud fallback / local) — key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=4096

# 3) Azure OpenAI (cloud) — selected when GCP + Anthropic are unset.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# OPENAI_API_VERSION=2024-08-01-preview

# 4) Groq (local dev) — free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# ── RAI Trust SDK ────────────────────────────────────────────────────────────
TRUST_PE_URL=http://127.0.0.1:3003
TRUST_APP_ID=pharmalogistics
TRUST_EVAL_MODE=SYNC

# Enforcement mode — what happens when a COERCIVE verdict is returned:
#   REDACT — SDK substitutes a safe refusal message (no app handling needed)
#   RAISE  — SDK raises GovernanceBlock (rich block UI; app must catch it)
#   NONE   — log only (shadow / audit mode)
# Demo default RAISE → COERCIVE verdicts raise GovernanceBlock and render the rich
# red block card (best for Scenario 3, Cold-Chain Excursion). Use REDACT for silent
# safe-substitution, or NONE for a shadow/audit-only pilot.
TRUST_ENFORCEMENT_MODE=RAISE
TRUST_HITL_THRESHOLD=2
# Optional — restrict Layer-2 eval to listed tools (default: ALL tools).
# TRUST_TOOL_FILTER=domestic_transfer,international_transfer

# ── Service URLs (local topology) ────────────────────────────────────────────
PAP_URL=http://127.0.0.1:3002
SENTINEL_URL=http://127.0.0.1:3012
# This app serves on :5001 (MyBank uses :5000) so the two demos can run side by side.
# MYBANK_CALLBACK_URL is the (legacy-named) URL PAP posts HITL decisions back to.
MYBANK_CALLBACK_URL=http://127.0.0.1:5001
MYBANK_PORT=5001

# ── OTel / Phoenix / Arize ───────────────────────────────────────────────────
# Local Phoenix — OTLP gRPC receiver on 4317 (default when running "phoenix serve"):
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Local Phoenix — OTLP HTTP receiver on 4318 (only if explicitly enabled):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http

# Arize cloud (Tier 2 / production) — inject the auth header from the cloud
# secret store at deploy time; do NOT commit a real token here.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.arize.com:443
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <ARIZE_API_KEY>,space_id=<SPACE_ID>
# OTEL_EXPORTER_OTLP_INSECURE=false

# Diversion Review Board reviewer mode: canned (instant, deterministic) | real (concurrent LLM, needs a valid LLM key)
MYBANK_COUNCIL_MODE=canned


# Fire the Diversion Review Board reviewers concurrently (atomic PE A2A counter keeps the HITL trip deterministic). Set false to revert to sequential.
MYBANK_COUNCIL_CONCURRENT=true

