# RAI Trust Platform — root environment config template
#
# SETUP:
#   cp .env.example .env
#   Edit .env — fill in any values marked  ← CHANGE THIS
#
# LAYERING: service-level .env files (pap/.env, policy-engine/.env, etc.)
#   override this file for any key defined in both.  Put provider credentials
#   in the service that owns them (guardrail-service/.env), not here.
#
# NOTE: .env is gitignored — never commit it. This .env.example IS committed.
#
# Use 127.0.0.1 everywhere instead of localhost.
# On Windows, localhost resolves via IPv6 first and adds ~2 s per request
# before falling back to IPv4.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared mode flags ─────────────────────────────────────────────────────────
MOCK_MODE=true
MOCK_SCENARIO=
FAIL_MODE=open

# ── Internal service URLs ─────────────────────────────────────────────────────
GUARDRAIL_SERVICE_URL=http://127.0.0.1:3001
GUARDRAIL_TIMEOUT_S=10
POLICY_ENGINE_URL=http://127.0.0.1:3003

# ── Trust Agent URLs ──────────────────────────────────────────────────────────
# Consumed by the Policy Engine (sentinel webhook) and by the PAP dashboard
# (/v1/ui-config endpoint → dashboard.html URL rebinding).
ASSURANCE_URL=http://127.0.0.1:3010
SENTINEL_URL=http://127.0.0.1:3012
COORDINATOR_URL=http://127.0.0.1:3013

# Sentinel webhook — Policy Engine posts evaluation summaries here.
SENTINEL_WEBHOOK_URL=http://127.0.0.1:3012/evaluate
# How often (every N turns) the Policy Engine triggers a Sentinel blind-spot scan.
SENTINEL_TRIGGER_N=5

# Cross-agent links (Sentinel ↔ Coordinator).
SENTINEL_COORDINATOR_URL=http://127.0.0.1:3013
COORDINATOR_SENTINEL_URL=http://127.0.0.1:3012

# ── LLM / provider keys ───────────────────────────────────────────────────────
# These are used by guardrail-service. Place them here as a shared fallback
# if all services share the same key; otherwise prefer guardrail-service/.env.
# GROQ_API_KEY=                           # ← CHANGE THIS
# OPENAI_API_KEY=                         # ← CHANGE THIS (if using OpenAI)
