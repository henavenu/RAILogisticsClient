# rai.env — RAI Trust SDK config for VitaLink (the SDK finds it by walking up from CWD).
# Point these at the Trust platform you want: local beta stack, or the GCP deployment.
# REQUIRED
RAI_PE_URL=http://127.0.0.1:3003          # Policy Engine (evaluate / enforce)
RAI_PAP_URL=http://127.0.0.1:3002         # PAP (agent registry, HITL queue)
# OPTIONAL
RAI_EVAL_MODE=SYNC                        # ASYNC (observe-only) | SYNC (enforcing gate)
RAI_ENFORCEMENT_MODE=RAISE                # NONE | RAISE | REDACT  (must match eval_mode)
RAI_TIMEOUT=30                            # must be >= the PE's Sentinel-sync budget (council HITL)
RAI_PRIVACY_PROXY=presidio                # none | regex | presidio (degrades to regex without spaCy)
RAI_GOVERN_RETURNS=false                  # also evaluate tool/agent RETURN values
OTEL_EXPORTER_OTLP_ENDPOINT=              # optional trace export (blank = disabled)
OTEL_EXPORTER_OTLP_PROTOCOL=grpc          # grpc | http
