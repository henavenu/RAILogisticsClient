<!-- MOCK EVALUATOR EDIT MODAL                                   -->
<!-- ============================================================ -->
<div class="modal fade" id="mockEvalModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-braces me-2 text-warning"></i>Edit Keywords — <span id="mock-eval-dim-name"></span></h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="mock-eval-dimension" />
        <label class="form-label" style="font-size:0.82rem;">
          Keywords <small class="text-muted">(one per line — case-insensitive substring match)</small>
        </label>
        <textarea class="form-control font-monospace" id="mock-eval-keywords" rows="12"
          style="font-size:0.8rem;" placeholder="one keyword or phrase per line…"></textarea>
        <small class="text-muted d-block mt-2" style="font-size:0.72rem;">
          <i class="bi bi-info-circle me-1"></i>
          Scoring bands: 0 hits → score 1 (clean) · 1 hit → score 4-6 (WARNING) · 2+ hits → score 7-9 (FLAGGED).
          Saving hot-reloads the GS MockProvider — changes take effect immediately with no restart.
        </small>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning text-dark" onclick="saveMockEvalKeywords()">
          <i class="bi bi-check2 me-1"></i>Save Keywords
        </button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// ============================================================
// API client
// ============================================================
const API = '';  // same origin

async function apiGet(path) {
  const r = await fetch(API + path);
  if (!r.ok) throw new Error(`HTTP ${r.status}: ${await r.text()}`);
  return r.json();
}
async function apiPost(path, body) {
  const r = await fetch(API + path, {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(body)
  });
  if (!r.ok) {
    const txt = await r.text();
    throw new Error(`HTTP ${r.status}: ${txt}`);
  }
  return r.json();
}
async function apiPut(path, body) {
  const r = await fetch(API + path, {
    method: 'PUT',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(body)
  });
  if (!r.ok) throw new Error(`HTTP ${r.status}: ${await r.text()}`);
  return r.json();
}
async function apiDelete(path) {
  const r = await fetch(API + path, { method: 'DELETE' });
  if (!r.ok) throw new Error(`HTTP ${r.status}: ${await r.text()}`);
  return r.json();
}
async function apiCall(method, path, body) {
  const opts = { method, headers: {} };
  if (body !== undefined) { opts.headers['Content-Type'] = 'application/json'; opts.body = JSON.stringify(body); }
  const r = await fetch(API + path, opts);
  if (!r.ok) {
    const txt = await r.text();
    let msg = txt;
    try { msg = JSON.parse(txt).error || txt; } catch {}
    throw new Error(msg);
  }
  return r.json();
}

// ============================================================
// Toast
// ============================================================
function showToast(msg, type = 'success') {
  const id = 'toast-' + Date.now();
  const icon = type === 'success' ? 'bi-check-circle-fill text-success'
             : type === 'warning' ? 'bi-exclamation-triangle-fill text-warning'
             : 'bi-x-circle-fill text-danger';
  const el = document.createElement('div');
  el.id = id;
  el.className = 'toast show align-items-center text-white border-0 mb-2';
  el.style = 'background:#1e2130; border:1px solid #2d3140!important; min-width:300px;';
  el.innerHTML = `<div class="d-flex">
    <div class="toast-body d-flex align-items-center gap-2">
      <i class="bi ${icon}"></i><span>${msg}</span>
    </div>
    <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.closest('.toast').remove()"></button>
  </div>`;
  document.getElementById('toast-container').appendChild(el);
  setTimeout(() => el.remove(), 5000);
}

// ============================================================
// Service status + Mock mode
// ============================================================
async function checkServiceStatus() {
  try {
    const data = await apiGet('/v1/proxy/services');
    const gs = data.guardrail_service || {};
    const pe = data.policy_engine || {};
    document.getElementById('dot-gs').className = `service-dot ${gs.status === 'healthy' ? 'dot-healthy' : 'dot-unhealthy'}`;
    document.getElementById('dot-pe').className = `service-dot ${pe.status === 'healthy' ? 'dot-healthy' : 'dot-unhealthy'}`;
  } catch (e) {}
}

async function refreshMockMode() {
  try {
    const data = await apiGet('/v1/proxy/mock-mode');
    const toggle = document.getElementById('mock-mode-toggle');
    const badge  = document.getElementById('mock-mode-badge');
    toggle.checked = !!data.mock_mode;
    if (data.mock_mode) {
      badge.textContent = data.scenario || 'MOCK';
      badge.className = 'badge bg-warning text-dark';
      badge.style.display = '';
    } else {
      badge.textContent = 'REAL';
      badge.className = 'badge bg-secondary';
      badge.style.display = '';
    }
  } catch (e) {
    // GS unreachable — leave toggle in indeterminate state
    document.getElementById('mock-mode-badge').style.display = 'none';
  }
}

async function setMockMode(enabled) {
  const badge = document.getElementById('mock-mode-badge');
  badge.textContent = '…';
  badge.className = 'badge bg-secondary';
  badge.style.display = '';
  try {
    const data = await apiPost('/v1/proxy/mock-mode', { enabled });
    // Refresh to confirm
    await refreshMockMode();
    showToast(`Mock mode ${enabled ? 'ENABLED' : 'DISABLED'} — no GS restart required.`, enabled ? 'warning' : 'success');
  } catch (e) {
    showToast(`Failed to toggle mock mode: ${e.message}`, 'error');
    await refreshMockMode(); // restore toggle to actual state
  }
}

// ============================================================
// POLICIES TAB
// ============================================================
let policiesCache = [];

async function loadPolicies() {
  try {
    const data = await apiGet('/v1/policies');
    policiesCache = data.policies || [];
    document.getElementById('badge-policy-count').textContent = policiesCache.length;
    renderPolicies(policiesCache);
  } catch (e) {
    document.getElementById('policies-tbody').innerHTML =
      `<tr><td colspan="6" class="text-center text-danger py-3">${e.message}</td></tr>`;
  }
}

function renderPolicies(policies) {
  const tbody = document.getElementById('policies-tbody');
  if (!policies.length) {
    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No policies found.</td></tr>';
    return;
  }

  tbody.innerHTML = policies.map(p => {
    const t = p.thresholds;
    const isPublished = p.is_published;
    const statusBadge = isPublished
      ? `<span class="badge badge-published"><i class="bi bi-check2 me-1"></i>Published</span>`
      : `<span class="badge badge-draft"><i class="bi bi-pencil me-1"></i>Draft</span>`;

    const sevClass = ['', 'severity-1', 'severity-2', 'severity-3'][p.severity] || '';
    const sevLabel = ['', 'Low', 'Medium', 'High'][p.severity] || p.severity;
    return `<tr>
      <td><strong>${p.dimension}</strong></td>
      <td><span class="${sevClass}">${sevLabel}</span></td>
      <td class="threshold-band">[${t.permissive[0]}–${t.permissive[1]}]</td>
      <td class="threshold-band">[${t.normative[0]}–${t.normative[1]}]</td>
      <td class="threshold-band">[${t.coercive[0]}–${t.coercive[1]}]</td>
      <td>${statusBadge}</td>
      <td>
        <button class="btn btn-sm btn-outline-secondary py-0 px-2" title="Edit"
          onclick='openPolicyModal(${JSON.stringify(p)})'>
          <i class="bi bi-pencil"></i>
        </button>
      </td>
    </tr>`;
  }).join('');
}

function openPolicyModal(p) {
  document.getElementById('modal-dim-name').textContent = p.dimension;
  document.getElementById('modal-dimension').value = p.dimension;
  document.getElementById('modal-severity').value = p.severity;
  const t = p.thresholds;
  document.getElementById('modal-perm-lo').value = t.permissive[0];
  document.getElementById('modal-perm-hi').value = t.permissive[1];
  document.getElementById('modal-norm-lo').value = t.normative[0];
  document.getElementById('modal-norm-hi').value = t.normative[1];
  document.getElementById('modal-coer-lo').value = t.coercive[0];
  document.getElementById('modal-coer-hi').value = t.coercive[1];
  document.getElementById('modal-rem-norm').value = (p.remediations || {}).normative || '';
  document.getElementById('modal-rem-coer').value = (p.remediations || {}).coercive || '';
  const actions = p.actions || {};
  document.getElementById('modal-human-note').value       = actions.human_note       || '';
  document.getElementById('modal-ops-alert').checked      = actions.ops_alert        || false;
  document.getElementById('modal-incident-routing').value = actions.incident_routing || 'none';
  document.getElementById('modal-version-info').textContent = `version ${p.version} · updated ${p.updated_at.substring(0,10)}`;
  new bootstrap.Modal(document.getElementById('policyModal')).show();
}

async function savePolicy() {
  const dimension = document.getElementById('modal-dimension').value;
  const body = {
    severity: parseInt(document.getElementById('modal-severity').value),
    thresholds: {
      permissive: [parseFloat(document.getElementById('modal-perm-lo').value), parseFloat(document.getElementById('modal-perm-hi').value)],
      normative:  [parseFloat(document.getElementById('modal-norm-lo').value), parseFloat(document.getElementById('modal-norm-hi').value)],
      coercive:   [parseFloat(document.getElementById('modal-coer-lo').value), parseFloat(document.getElementById('modal-coer-hi').value)],
    },
    remediation_normative: document.getElementById('modal-rem-norm').value || null,
    remediation_coercive:  document.getElementById('modal-rem-coer').value || null,
    human_note:            document.getElementById('modal-human-note').value || null,
    ops_alert:             document.getElementById('modal-ops-alert').checked,
    incident_routing:      document.getElementById('modal-incident-routing').value || 'none',
  };
  try {
    await apiPut(`/v1/policies/${dimension}`, body);
    bootstrap.Modal.getInstance(document.getElementById('policyModal')).hide();
    showToast(`Policy '${dimension}' saved. Remember to Publish.`, 'warning');
    loadPolicies();
  } catch (e) {
    showToast(`Save failed: ${e.message}`, 'error');
  }
}

async function publishPolicies() {
  const statusEl = document.getElementById('publish-status');
  statusEl.className = 'alert alert-secondary mb-3';
  statusEl.innerHTML = '<div class="spinner-border spinner-sm me-2"></div>Publishing to Policy Engine...';
  statusEl.classList.remove('d-none');
  try {
    const result = await apiPost('/v1/policies/publish', {});
    if (result.success) {
      let extra = '';
      if (result.reload_warning) {
        extra += `<br><small class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>${result.reload_warning}</small>`;
      }
      if (result.sync_warnings && result.sync_warnings.length) {
        extra += result.sync_warnings.map(w =>
          `<br><small class="text-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i>SYNC: ${w}</small>`
        ).join('');
        showToast(`${result.sync_warnings.length} dimension sync warning(s) — see publish status bar.`, 'warning');
      }
      statusEl.className = result.sync_warnings?.length ? 'alert alert-warning mb-3' : 'alert alert-success mb-3';
      statusEl.innerHTML = `<i class="bi bi-check-circle me-1"></i>Published ${result.policy_count} policies at ${result.timestamp.substring(0,19).replace('T',' ')} UTC.${extra}`;
      if (!result.sync_warnings?.length) showToast(`${result.policy_count} policies published successfully.`);
      loadPolicies();
      checkServiceStatus();
    } else {
      statusEl.className = 'alert alert-danger mb-3';
      statusEl.innerHTML = `<i class="bi bi-x-circle me-1"></i>Publish failed: ${result.error}`;
    }
  } catch (e) {
    statusEl.className = 'alert alert-danger mb-3';
    statusEl.innerHTML = `<i class="bi bi-x-circle me-1"></i>${e.message}`;
  }
}

// ============================================================
// EVALUATIONS TAB
// ============================================================
let evalLoaded = false;

async function loadEvaluations() {
  document.getElementById('eval-tbody').innerHTML =
    '<tr><td colspan="6" class="text-center text-muted py-3"><div class="spinner-border spinner-sm me-2"></div>Loading...</td></tr>';
  try {
    // Fetch evaluations, packs, and PAP policies in parallel
    const [data, packsResp, polResp] = await Promise.all([
      apiGet('/v1/proxy/evaluations'),
      apiGet('/v1/proxy/packs').catch(() => ({ packs: [] })),
      apiGet('/v1/policies').catch(() => ({ policies: [] })),
    ]);
    const evals = data.evaluations || [];
    const packs = packsResp.packs || [];

    // Build dimension → policy map directly from PAP policies (no GS dependency)
    _evalPolicyMap = {};
    _evalPolicyMapReady = true;
    for (const p of (polResp.policies || [])) {
      if (!p.app_id) {          // global policies only (app_id === null)
        _evalPolicyMap[p.dimension] = p;
      }
    }

    // Build pack reference index for table column
    const usedBy = {};
    for (const p of packs) {
      for (const d of (p.dimensions || [])) {
        if (!usedBy[d.id]) usedBy[d.id] = [];
        usedBy[d.id].push(p.id);
      }
    }

    const summaryEl = document.getElementById('eval-summary');
    summaryEl.innerHTML = `
      <div class="col-auto"><div class="card px-3 py-2"><small class="text-muted">Total</small><div class="fw-bold">${data.total || evals.length}</div></div></div>
      <div class="col-auto"><div class="card px-3 py-2"><small class="text-muted">Active</small><div class="fw-bold text-success">${data.active || 0}</div></div></div>
      <div class="col-auto"><div class="card px-3 py-2"><small class="text-muted">Deferred</small><div class="fw-bold text-warning">${data.deferred || 0}</div></div></div>
    `;
    // Group evaluators by category (preserving YAML declaration order)
    const catOrder = ['safety','security','trust','financial_crime','corporate_governance','eu_ai_act','prompt_filter','session_signals'];
    const cats = {};
    for (const e of evals) {
      const cat = e.category || 'other';
      if (!cats[cat]) cats[cat] = [];
      cats[cat].push(e);
    }
    // Render category groups
    const catRows = (cat, dims) => {
      const catSlug = cat.replace(/[^a-z0-9_]/g,'_');
      let html = `<tr class="cat-row cat-${catSlug}"><td colspan="5">${escHtml(cat)}</td></tr>`;
      for (const e of dims) {
        const badge = e.status === 'active'
          ? '<span class="badge badge-active">active</span>'
          : '<span class="badge badge-deferred">deferred</span>';
        const roles = (e.roles || []).map(r => `<code style="font-size:0.73rem">${r}</code>`).join(' ');
        const refs = (usedBy[e.dimension] || [])
          .map(pid => `<span style="font-size:0.68rem;background:#3498db22;color:#3498db;border:1px solid #3498db44;border-radius:3px;padding:1px 5px;">${escHtml(pid)}</span>`)
          .join(' ') || '<span class="text-muted" style="font-size:0.73rem;">—</span>';
        html += `<tr>
          <td style="padding-left:1.4rem;"><strong>${escHtml(e.dimension)}</strong></td>
          <td>${badge}</td>
          <td><code style="font-size:0.73rem">${escHtml(e.provider || '—')}</code></td>
          <td>${roles}</td>
          <td>${refs}</td>
        </tr>`;
      }
      return html;
    };
    // Render in canonical order, then any extra categories alphabetically
    const orderedCats = [...catOrder.filter(c => cats[c]),
                         ...Object.keys(cats).filter(c => !catOrder.includes(c)).sort()];
    document.getElementById('eval-tbody').innerHTML =
      orderedCats.map(c => catRows(c, cats[c])).join('') ||
      '<tr><td colspan="5" class="text-center text-muted py-3">No evaluators found.</td></tr>';

    // Populate the rich Evaluator Catalog below the table
    _renderEvaluatorCatalog(evals, packs, _evalPolicyMap, _evalPolicyMapReady);

    // Load mock evaluator signals (runs in parallel, non-blocking)
    loadMockEvaluators();

    evalLoaded = true;
  } catch (e) {
    document.getElementById('eval-tbody').innerHTML =
      `<tr><td colspan="5" class="text-center text-danger py-3">Could not load from Guardrail Service: ${e.message}</td></tr>`;
  }
}

// ============================================================
// MOCK EVALUATOR SIGNAL EDITOR
// ============================================================
let _mockEvalCache = {};
let _evalPolicyMap = {};         // dimension → policy object (null key = no policy)
let _evalPolicyMapReady = false; // true once /v1/policies loaded successfully

async function loadMockEvaluators() {
  const el = document.getElementById('mock-evaluators-container');
  if (!el) return;
  el.innerHTML = '<div class="text-muted" style="font-size:0.83rem;"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>';
  try {
    const data = await apiGet('/v1/proxy/mock-evaluators');
    _mockEvalCache = data.signals || {};
    _renderMockEvaluators(_mockEvalCache);
  } catch (e) {
    el.innerHTML = `<div class="text-danger" style="font-size:0.82rem;"><i class="bi bi-exclamation-triangle me-1"></i>Could not load mock signals: ${escHtml(e.message)}</div>`;
  }
}

function _renderMockEvaluators(signals) {
  const el = document.getElementById('mock-evaluators-container');
  if (!signals || !Object.keys(signals).length) {
    el.innerHTML = '<div class="text-muted">No signals defined.</div>';
    return;
  }
  el.innerHTML = `
    <div class="row g-3">
      ${Object.entries(signals).map(([dim, cfg]) => {
        const kws = (cfg.keywords || []).join(', ');
        return `
          <div class="col-md-6 col-xl-4">
            <div class="card h-100" style="border-color:#3a3200;">
              <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <strong style="font-size:0.82rem; color:#ffc06a;">${escHtml(dim)}</strong>
                  <button class="btn btn-sm py-0 px-2" style="font-size:0.7rem;color:#aaa;border:1px solid #2d3140;"
                    onclick="openMockEvalEditor('${escHtml(dim)}')">
                    <i class="bi bi-pencil"></i> Edit
                  </button>
                </div>
                <div style="font-size:0.72rem; color:#888; line-height:1.5;">
                  ${kws ? escHtml(kws.substring(0, 120)) + (kws.length > 120 ? '…' : '') : '<em>No keywords</em>'}
                </div>
                <small class="text-muted d-block mt-1" style="font-size:0.65rem;">${(cfg.keywords||[]).length} keyword${(cfg.keywords||[]).length!==1?'s':''}</small>
              </div>
            </div>
          </div>`;
      }).join('')}
    </div>`;
}

function openMockEvalEditor(dimension) {
  const cfg = _mockEvalCache[dimension] || {};
  document.getElementById('mock-eval-dim-name').textContent = dimension;
  document.getElementById('mock-eval-dimension').value     = dimension;
  document.getElementById('mock-eval-keywords').value      = (cfg.keywords || []).join('\n');
  new bootstrap.Modal(document.getElementById('mockEvalModal')).show();
}

async function saveMockEvalKeywords() {
  const dimension = document.getElementById('mock-eval-dimension').value;
  const raw       = document.getElementById('mock-eval-keywords').value;
  const keywords  = raw.split('\n').map(s => s.trim()).filter(s => s.length > 0);
  try {
    await apiPut(`/v1/proxy/mock-evaluators/${dimension}`, { keywords });
    bootstrap.Modal.getInstance(document.getElementById('mockEvalModal')).hide();
    showToast(`Keywords for '${dimension}' saved and hot-reloaded into GS (${keywords.length} entries). Effective immediately.`, 'success');
    await loadMockEvaluators();
  } catch (e) {
    showToast(`Save failed: ${e.message}`, 'error');
  }
}

// ============================================================
// APP CONFIGS TAB
// ============================================================
let appConfigLoaded = false;

async function loadAppConfigs() {
  try {
    const data = await apiGet('/v1/app-configs');
    const configs = data.app_configs || [];
    const tbody = document.getElementById('appconfig-tbody');
    if (!configs.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No app configs yet. Click "Add App Config" to create one.</td></tr>';
      return;
    }
    tbody.innerHTML = configs.map(c => {
      const tierClass = c.base_tier === 'LOW' ? 'badge-permissive' : c.base_tier === 'HIGH' ? 'badge-coercive' : 'badge-normative';
      const dynBadge = c.dynamic_evaluation
        ? '<span class="badge bg-info text-dark">Enabled</span>'
        : '<span class="text-muted">—</span>';
      return `<tr>
        <td><code>${c.app_id}</code></td>
        <td>${c.display_name || '<span class="text-muted">—</span>'}</td>
        <td><span class="badge ${tierClass}">${c.base_tier}</span></td>
        <td>${dynBadge}</td>
        <td><small class="text-muted">${c.updated_at.substring(0,10)}</small></td>
        <td>
          <button class="btn btn-sm btn-outline-secondary py-0 px-2 me-1" title="Edit"
            onclick='editAppConfig(${JSON.stringify(c)})'>
            <i class="bi bi-pencil"></i>
          </button>
          <button class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete"
            onclick="deleteAppConfig('${c.app_id}')">
            <i class="bi bi-trash"></i>
          </button>
        </td>
      </tr>`;
    }).join('');
    appConfigLoaded = true;
  } catch (e) {
    showToast(`Failed to load app configs: ${e.message}`, 'error');
  }
}

function openAppConfigModal() {
  document.getElementById('appconfig-modal-title').textContent = 'Add App Config';
  document.getElementById('ac-app-id').value = '';
  document.getElementById('ac-app-id').disabled = false;
  document.getElementById('ac-display-name').value = '';
  document.getElementById('ac-base-tier').value = 'MEDIUM';
  document.getElementById('ac-dynamic-eval').checked = false;
}

function editAppConfig(c) {
  document.getElementById('appconfig-modal-title').textContent = 'Edit App Config';
  document.getElementById('ac-app-id').value = c.app_id;
  document.getElementById('ac-app-id').disabled = true;  // can't change PK
  document.getElementById('ac-display-name').value = c.display_name || '';
  document.getElementById('ac-base-tier').value = c.base_tier;
  document.getElementById('ac-dynamic-eval').checked = c.dynamic_evaluation;
  new bootstrap.Modal(document.getElementById('appConfigModal')).show();
}

async function saveAppConfig() {
  const body = {
    app_id:             document.getElementById('ac-app-id').value.trim(),
    display_name:       document.getElementById('ac-display-name').value.trim() || null,
    base_tier:          document.getElementById('ac-base-tier').value,
    dynamic_evaluation: document.getElementById('ac-dynamic-eval').checked,
  };
  if (!body.app_id) { showToast('App ID is required', 'error'); return; }
  try {
    await apiPost('/v1/app-configs', body);
    bootstrap.Modal.getInstance(document.getElementById('appConfigModal')).hide();
    showToast(`App config '${body.app_id}' saved.`);
    loadAppConfigs();
  } catch (e) {
    showToast(`Save failed: ${e.message}`, 'error');
  }
}

async function deleteAppConfig(appId) {
  if (!confirm(`Delete app config '${appId}'?`)) return;
  try {
    await apiDelete(`/v1/app-configs/${appId}`);
    showToast(`App config '${appId}' deleted.`, 'warning');
    loadAppConfigs();
  } catch (e) {
    showToast(`Delete failed: ${e.message}`, 'error');
  }
}

// ============================================================
// AUDIT TAB
// ============================================================
async function loadAudit() {
  const action    = document.getElementById('audit-action-filter').value;
  const appFilter = document.getElementById('audit-app-filter')?.value || '';
  let qs = '?limit=200';
  if (action)    qs += `&action=${action}`;
  const tbody = document.getElementById('audit-tbody');
  tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3"><div class="spinner-border spinner-sm me-2"></div>Loading...</td></tr>';
  try {
    const data = await apiGet('/v1/audit' + qs);
    let entries = data.entries || [];

    // Populate app filter dropdown from distinct app_ids in results
    const appSel = document.getElementById('audit-app-filter');
    if (appSel) {
      const appIds = [...new Set(entries.map(e => e.app_id).filter(Boolean))].sort();
      const currentVal = appSel.value;
      appSel.innerHTML = '<option value="">All Apps</option>'
        + appIds.map(id => `<option value="${id}"${id===currentVal?' selected':''}>${id}</option>`).join('');
    }

    // Client-side app filter
    if (appFilter) entries = entries.filter(e => (e.app_id || '') === appFilter);

    if (!entries.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No audit records found.</td></tr>';
      return;
    }

    tbody.innerHTML = entries.map(e => {
      const actionClass = `audit-action-${e.action}`;
      const ts = e.timestamp.substring(0,19).replace('T',' ');
      const appBadge = e.app_id
        ? `<code style="font-size:0.72rem">${e.app_id}</code>`
        : '<span class="text-muted">platform</span>';

      let summary = e.notes || '';
      if (!summary && e.action === 'UPDATE' && e.old_values && e.new_values) {
        const changed = [];
        const fields = ['severity','permissive_lo','permissive_hi','normative_lo','normative_hi','coercive_lo','coercive_hi'];
        fields.forEach(f => {
          if (e.old_values[f] !== undefined && e.old_values[f] !== e.new_values[f]) {
            changed.push(`${f}: ${e.old_values[f]} → ${e.new_values[f]}`);
          }
        });
        summary = changed.join(', ') || 'Updated';
      } else if (!summary && e.action === 'PUBLISH') {
        const nv = e.new_values || {};
        summary = `v${nv.version || '?'} published`;
      } else if (!summary) {
        summary = '—';
      }

      return `<tr>
        <td><small class="text-muted font-monospace">${ts}</small></td>
        <td>${appBadge}</td>
        <td><span class="${actionClass} fw-semibold">${e.action}</span></td>
        <td><strong>${e.dimension}</strong></td>
        <td><small>${e.actor}</small></td>
        <td><small class="text-muted">${summary}</small></td>
      </tr>`;
    }).join('');
  } catch (e) {
    tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger py-3">${e.message}</td></tr>`;
  }
}

// ============================================================
// EVALUATION AUDIT TRAIL
// ============================================================
let _evalAuditTimer = null;

async function loadEvalAudit() {
  const verdict = document.getElementById('eval-audit-verdict-filter').value;
  const qs = verdict ? `?verdict=${verdict}&limit=20` : '?limit=20';
  const tbody = document.getElementById('eval-audit-tbody');
  try {
    const data = await apiGet('/v1/audit/evaluations' + qs);
    const records = data.records || [];
    if (!records.length) {
      const msg = data.message || 'No evaluation records yet. Run an evaluation to see results here.';
      tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted py-4">${msg}</td></tr>`;
      return;
    }
    tbody.innerHTML = records.map(r => {
      const verdictClass = r.verdict === 'PERMISSIVE' ? 'badge-permissive'
                         : r.verdict === 'NORMATIVE'  ? 'badge-normative'
                         : 'badge-coercive';
      const ts = (r.timestamp || '').substring(0, 19).replace('T', ' ');

      // ── Trust delta: what this verdict does to session trust score ────────
      // Only meaningful when session_id is present (stateless evals don't track trust).
      // COERCIVE=-0.20, NORMATIVE=-0.05, PERMISSIVE=+0.02 (from session/store.py)
      const _TRUST_DELTA = { COERCIVE: -0.20, NORMATIVE: -0.05, PERMISSIVE: 0.02 };
      const trustDelta = _TRUST_DELTA[r.verdict];
      let trustBadge = '';
      if (r.session_id && trustDelta !== undefined && r.verdict !== 'PERMISSIVE') {
        const col = r.verdict === 'COERCIVE' ? '#ff8080' : '#ffe066';
        const pct = (trustDelta * 100).toFixed(0);
        trustBadge = `<span style="color:${col};font-size:0.62rem;display:block;"
          title="Session trust impact: ${pct}% — affects threshold steps on next evaluation">session trust ${pct}%</span>`;
      }
      // Session escalation: session history caused a stricter verdict than this turn alone
      const escalationBadge = r.session_escalated
        ? `<span class="badge" style="background:#2a1a3a;color:#bf8fff;font-size:0.6rem;"
            title="Session history escalated this verdict beyond the turn-level result">↑ session</span>`
        : '';
      let detail = '';
      if (r.fail_reason) {
        detail = `<span class="badge bg-warning text-dark">${r.fail_reason}</span>`;
      } else if (r.violations && r.violations.length) {
        detail = r.violations
          .filter(v => v)
          .slice(0, 2)
          .map(v => `<small class="text-danger d-block" style="font-size:0.75rem">${v.substring(0, 100)}${v.length > 100 ? '...' : ''}</small>`)
          .join('');
      } else {
        detail = '<span class="text-muted">—</span>';
      }
      const reqId = (r.request_id || '').substring(0, 16);

      // ── Agent name (from metadata.agent_name) ─────────────────────────
      const meta      = r.metadata || {};
      const agentName = meta.agent_name;
      const agentBadge = agentName
        ? `<span style="color:#8aabdf;font-size:0.65rem;display:block;font-family:monospace;"
            title="Agent: ${agentName}">⬡ ${agentName}</span>`
        : '';

      // ── Token usage (from metadata.agent_tokens) ──────────────────────
      const agentTok   = meta.agent_tokens || {};
      const totalTok   = agentTok.total_tokens || 0;
      const costUsd    = agentTok.cost_usd    || 0;
      let tokenBadge   = '';
      if (totalTok > 0) {
        const tokStr  = _fmtNum ? _fmtNum(totalTok) : totalTok;
        const costStr = costUsd > 0
          ? ` · $${costUsd < 0.01 ? costUsd.toFixed(5) : costUsd.toFixed(4)}`
          : '';
        tokenBadge = `<span style="color:#5a8a7a;font-size:0.62rem;display:block;font-family:monospace;"
          title="${agentTok.prompt_tokens||0}P + ${agentTok.completion_tokens||0}C tokens${costStr ? ' · ' + costStr : ''}">
          🪙 ${tokStr} tok${costStr}</span>`;
      }

      // Pack trace column — show activated packs with their verdict
      let packCell = '<span class="text-muted" style="font-size:0.75rem;">—</span>';
      const trace = r.pack_trace || [];
      if (trace.length) {
        const activatedPacks  = trace.filter(t => t.activated);
        const unassignedPacks = trace.filter(t => !t.activated);
        const unassignedCount = unassignedPacks.length;
        if (activatedPacks.length) {
          const packBadges = activatedPacks.map(t => {
            const pv  = (t.pack_verdict || 'PERMISSIVE').toUpperCase();
            const cls = pv === 'COERCIVE'  ? 'badge-coercive'
                      : pv === 'NORMATIVE' ? 'badge-normative'
                      : 'badge-permissive';
            const pvIcon = pv === 'COERCIVE' ? '🔴' : pv === 'NORMATIVE' ? '🟡' : '🟢';
            const abortMark = t.aborted ? ' ⚡' : '';
            // Step-up annotation: threshold tightening already in effect for THIS evaluation
            // (reflects prior trust decay — caused by earlier NORMATIVE/COERCIVE verdicts)
            const stepsMap  = t.steps_applied || {};
            const stepVals  = Object.values(stepsMap);
            const stepTotal = stepVals.reduce((a, b) => a + b, 0);
            const stepDims  = Object.entries(stepsMap).filter(([,v]) => v !== 0).map(([k,v]) => `${k}:+${v}`).join(', ');
            const stepInfo  = stepTotal !== 0
              ? ` <span style="color:#6ea8fe;font-size:0.63rem;"
                  title="Thresholds tightened ${stepTotal} step${stepTotal!==1?'s':''} for this evaluation (low session trust)${stepDims ? ': ' + stepDims : ''}">▲${stepTotal} step${stepTotal!==1?'s':''}</span>` : '';
            const dimsInfo  = (t.dimensions_evaluated || []).length
              ? `dims: ${t.dimensions_evaluated.join(', ')}` : '';
            const tooltip   = `pack: ${t.pack_id} · layer ${t.layer} · v${t.version}${dimsInfo ? ' · ' + dimsInfo : ''}${t.activation_tags?.length ? ' · tags: ' + t.activation_tags.join(', ') : ''}`;
            return `<span class="badge ${cls} me-1" style="font-size:0.65rem;" title="${tooltip}">`
              + `${pvIcon} ${t.pack_id}${abortMark}</span>${stepInfo}`;
          }).join('');
          const unassigned = unassignedCount
            ? ` <span style="color:#6e7681;font-size:0.63rem;cursor:default;"
                  title="Not assigned to this app: ${unassignedPacks.map(t=>t.pack_id).join(', ')}"
                >${unassignedCount} not assigned</span>` : '';
          packCell = packBadges + unassigned;
        } else if (unassignedCount) {
          const names = unassignedPacks.map(t => t.pack_id).join(', ');
          packCell = `<span style="color:#6e7681;font-size:0.72rem;cursor:default;" title="${names}">${unassignedCount} pack${unassignedCount>1?'s':''} not assigned</span>`;
        }
      }

      return `<tr>
        <td><small class="text-muted font-monospace" style="font-size:0.72rem;">${ts}</small></td>
        <td>
          <span class="badge ${verdictClass}" style="font-size:0.7rem;">${r.verdict || '—'}</span>
          ${trustBadge}${escalationBadge}
        </td>
        <td><code style="font-size:0.72rem">${r.app_id || '—'}</code></td>
        <td>
          <small style="font-size:0.72rem;">${r.role || '—'}</small>
          ${agentBadge}
        </td>
        <td>
          <small class="text-muted font-monospace" style="font-size:0.72rem;" title="req=${r.request_id||''}">${r.latency_ms != null ? r.latency_ms + 'ms' : '—'}</small>
          ${tokenBadge}
        </td>
        <td>${packCell}</td>
        <td>${detail}</td>
      </tr>`;
    }).join('');
  } catch (e) {
    tbody.innerHTML = `<tr><td colspan="7" class="text-center text-danger py-3">${e.message}</td></tr>`;
  }
}

function toggleEvalAutoRefresh() {
  const enabled = document.getElementById('eval-audit-autorefresh').checked;
  if (enabled) {
    loadEvalAudit();
    _evalAuditTimer = setInterval(loadEvalAudit, 5000);
  } else {
    clearInterval(_evalAuditTimer);
    _evalAuditTimer = null;
  }
}

// ============================================================
// LIVE TAIL  (SSE-based, tab 5)
// ============================================================
let _ltEs         = null;   // EventSource
let _ltPaused     = false;
let _ltQueue      = [];     // records buffered while paused
let _ltCounts     = { total: 0, PERMISSIVE: 0, NORMATIVE: 0, COERCIVE: 0 };
let _ltAutoScroll = true;

const LT_VERDICT_STYLE = {
  PERMISSIVE: 'color:#3fb950',   // GitHub green
  NORMATIVE:  'color:#e3b341',   // amber
  COERCIVE:   'color:#f85149',   // red
};

function _ltFormatRecord(r) {
  const ts      = (r.timestamp || '').substring(0, 23).replace('T', ' ');
  const verdict = (r.verdict || 'UNKNOWN').padEnd(12);
  const style   = LT_VERDICT_STYLE[r.verdict] || 'color:#8b949e';
  const latency = r.latency_ms != null ? String(r.latency_ms).padStart(7) + 'ms' : '       —';
  const app     = (r.app_id || '—').padEnd(16).substring(0, 16);
  const role    = (r.role   || '—').padEnd(10).substring(0, 10);
  const reqId   = (r.request_id || '').substring(0, 16);

  let line = `<span style="color:#8b949e">${ts}</span>  `;
  line    += `<span style="${style};font-weight:600">${verdict}</span>  `;
  line    += `<span style="color:#58a6ff">${latency}</span>  `;
  line    += `<span style="color:#8b949e">app=</span><span style="color:#c9d1d9">${app}</span>  `;
  line    += `<span style="color:#8b949e">role=</span><span style="color:#c9d1d9">${role}</span>  `;
  line    += `<span style="color:#8b949e">req=</span><span style="color:#6e7681">${reqId}</span>`;

  if (r.fail_reason) {
    line += `\n    <span style="color:#e3b341">  fail_reason=${r.fail_reason}</span>`;
  } else if (r.violations && r.violations.length) {
    const v = r.violations.filter(x => x).slice(0, 1).join('; ');
    line += `\n    <span style="color:#f85149;font-style:italic">  ${v.substring(0, 120)}${v.length > 120 ? '…' : ''}</span>`;
  }
  return line + '\n';
}

function _ltAppendLine(r) {
  _ltCounts.total++;
  if (r.verdict in _ltCounts) _ltCounts[r.verdict]++;
  document.getElementById('lt-count-total').textContent = _ltCounts.total;
  document.getElementById('lt-count-p').textContent     = _ltCounts.PERMISSIVE;
  document.getElementById('lt-count-n').textContent     = _ltCounts.NORMATIVE;
  document.getElementById('lt-count-c').textContent     = _ltCounts.COERCIVE;

  const term = document.getElementById('lt-terminal');
  const span = document.createElement('span');
  span.innerHTML = _ltFormatRecord(r);
  term.appendChild(span);

  // Keep at most 2 000 lines to avoid memory blow-up
  while (term.children.length > 2000) term.removeChild(term.firstChild);

  if (_ltAutoScroll) term.scrollTop = term.scrollHeight;
}

// ============================================================
// POLICY PACK INSPECTOR
// ============================================================

const _LAYER_META = {
  'mandatory':              { label: 'Mandatory',       cls: 'bg-danger'              },
  'domain-mandatory':       { label: 'Domain Mandatory', cls: 'bg-danger'             },
  'domain-addon':           { label: 'Domain Add-on',   cls: 'bg-info text-dark'      },
  'regulatory':             { label: 'Regulatory',      cls: 'bg-warning text-dark'   },
  'regional':               { label: 'Regional',        cls: 'bg-secondary'           },
  'advisory':               { label: 'Advisory',        cls: 'bg-secondary'           },
  'exception':              { label: 'Exception',       cls: 'bg-secondary'           },
};
const _ENFC_META = {
  'always-on':               { label: 'Always On',          cls: 'bg-danger'            },
  'flexible':                { label: 'Flexible',            cls: 'bg-secondary'         },
  'flexible-threshold-only': { label: 'Threshold Only',      cls: 'bg-warning text-dark' },
};
const _MODE_META = {
  'abort-on-first-coercive': { label: 'Abort on COERCIVE',  cls: 'bg-danger'    },
  'collect-all':             { label: 'Collect All',        cls: 'bg-secondary' },
};

function _thresholdBar(t) {
  if (!t) return '<span class="text-muted">—</span>';
  const bands = [
    { label: 'P', range: t.permissive, color: '#2ecc71' },
    { label: 'N', range: t.normative,  color: '#f39c12' },
    { label: 'C', range: t.coercive,   color: '#e74c3c' },
  ];
  const cells = bands.map(b => {
    const w = Math.round((b.range[1] - b.range[0] + 1) / 9 * 100);
    return `<div title="${b.label}: ${b.range[0]}–${b.range[1]}"
                 style="flex:${w}; background:${b.color}20; border:1px solid ${b.color}40;
                        text-align:center; font-size:0.65rem; padding:1px 2px; color:${b.color};">
              ${b.range[0]}–${b.range[1]}
            </div>`;
  }).join('');
  return `<div style="display:flex; gap:2px; min-width:120px;">${cells}</div>`;
}

async function loadPackInspector() {
  const container = document.getElementById('pr-packs-container');
  if (!container) return;
  try {
    const data = await apiGet('/v1/proxy/packs');
    if (!data.pack_engine_active) {
      container.innerHTML = `
        <div class="card">
          <div class="card-body text-muted py-3" style="font-size:0.83rem;">
            <i class="bi bi-exclamation-circle me-2 text-warning"></i>
            Pack engine is not active. Set <code>ENABLE_PACK_ENGINE=true</code> and restart the Policy Engine.
          </div>
        </div>`;
      return;
    }

    const packs = data.packs || [];
    if (!packs.length) {
      container.innerHTML = '<div class="text-muted" style="font-size:0.83rem;">No packs loaded.</div>';
      return;
    }

    container.innerHTML = packs.map(pack => {
      const layer  = _LAYER_META[pack.layer]  || { label: pack.layer,  cls: 'bg-secondary' };
      const enfc   = _ENFC_META[pack.enforcement] || { label: pack.enforcement, cls: 'bg-secondary' };
      const mode   = _MODE_META[pack.mode]    || { label: pack.mode,   cls: 'bg-secondary' };
      const hitl   = ''; // Human review flag — hidden until remediation workflows are live

      // Dimensions table
      const dimRows = (pack.dimensions || []).map(d => {
        const sev    = ['','<span style="color:#2ecc71">●</span>','<span style="color:#f39c12">●</span>','<span style="color:#e74c3c">●</span>'][d.severity] || '';
        const abortBadge = d.abort
          ? '<span class="badge bg-danger" style="font-size:0.6rem;" title="Aborts chain on COERCIVE">ABORT</span>'
          : '';
        const roles  = (d.roles && d.roles.length)
          ? d.roles.map(r => `<code style="font-size:0.68rem;">${r.replace('_prompt','').replace('_response','_resp').replace('agent_to_agent','a2a')}</code>`).join(' ')
          : '<span class="text-muted" style="font-size:0.75rem;">all roles</span>';
        return `<tr>
          <td><strong style="font-size:0.8rem;">${d.id}</strong></td>
          <td><code style="font-size:0.72rem; color:#bf8fff;">${d.profile}</code></td>
          <td style="text-align:center;">${sev}</td>
          <td>${_thresholdBar(d.thresholds)}</td>
          <td>${roles}</td>
          <td>${abortBadge}</td>
        </tr>`;
      }).join('');

      // Context adjustments
      let adjSection = '';
      const adjs = pack.context_adjustments || [];
      if (adjs.length) {
        const adjRows = adjs.map(a => {
          const stepStr = a.step > 0 ? `<span style="color:#e74c3c;">+${a.step} (tighten)</span>`
                        : a.step < 0 ? `<span style="color:#2ecc71;">${a.step} (relax)</span>`
                        : `<span class="text-muted">0</span>`;
          const affects = a.affects && a.affects.length
            ? a.affects.map(x => `<code style="font-size:0.68rem;">${x}</code>`).join(' ')
            : '<span class="text-muted">all dims</span>';
          return `<tr>
            <td><code style="font-size:0.72rem; color:#58a6ff;">${a.signal}</code></td>
            <td style="text-align:center;"><code style="font-size:0.72rem;">${a.operator} ${a.value}</code></td>
            <td>${stepStr}</td>
            <td>${affects}</td>
          </tr>`;
        }).join('');
        adjSection = `
          <div class="mt-3 pt-3" style="border-top:1px solid #2d3140;">
            <div style="font-size:0.72rem; color:#8b949e; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:6px;">
              <i class="bi bi-sliders me-1"></i>Trust Signal Adjustments
            </div>
            <table class="table table-sm table-hover mb-0" style="font-size:0.78rem;">
              <thead><tr>
                <th style="color:#8b949e;">Signal</th>
                <th style="color:#8b949e;">Condition</th>
                <th style="color:#8b949e;">Step</th>
                <th style="color:#8b949e;">Affects</th>
              </tr></thead>
              <tbody>${adjRows}</tbody>
            </table>
          </div>`;
      }

      return `
        <div class="card mb-3">
          <div class="card-header d-flex align-items-center gap-2 flex-wrap" style="gap:6px!important;">
            <i class="bi bi-box-seam text-info"></i>
            <strong>${pack.id}</strong>
            <span class="badge ${layer.cls}">${layer.label}</span>
            <span class="badge ${enfc.cls}" style="font-size:0.65rem;">${enfc.label}</span>
            <span class="badge ${mode.cls}" style="font-size:0.65rem;">${mode.label}</span>
            ${hitl}
            <span class="ms-auto text-muted" style="font-size:0.72rem;">
              v${pack.version} · ${pack.owner}
            </span>
          </div>
          <div class="card-body p-3">
            <p class="text-muted mb-3" style="font-size:0.82rem;">${pack.description || ''}</p>
            <table class="table table-sm table-hover mb-0" style="font-size:0.78rem;">
              <thead>
                <tr>
                  <th style="color:#8b949e;">Dimension</th>
                  <th style="color:#8b949e;">Profile</th>
                  <th style="color:#8b949e; text-align:center;">Sev</th>
                  <th style="color:#8b949e;">Base Thresholds (1–9)</th>
                  <th style="color:#8b949e;">Roles</th>
                  <th style="color:#8b949e;"></th>
                </tr>
              </thead>
              <tbody>${dimRows}</tbody>
            </table>
            ${adjSection}
          </div>
        </div>`;
    }).join('');

  } catch (e) {
    container.innerHTML = `<div class="text-danger" style="font-size:0.8rem;"><i class="bi bi-x-circle me-1"></i>${e.message}</div>`;
  }
}

// ============================================================
// PLATFORM RULES TAB
// ============================================================
async function loadPlatformRules() {
  // Fail mode + session config from PE
  try {
    const cfg = await apiGet('/v1/proxy/config');

    // Fail mode badge
    const fmBadge = document.getElementById('pr-failmode-badge');
    if (fmBadge) {
      const isOpen = (cfg.fail_mode || 'open') === 'open';
      fmBadge.textContent  = cfg.fail_mode?.toUpperCase() || '–';
      fmBadge.className    = 'badge ms-auto ' + (isOpen ? 'bg-success' : 'bg-danger');
    }

    // Session body
    const sb = document.getElementById('pr-session-body');
    if (sb) {
      sb.innerHTML = `
        <div class="mb-2">
          <span class="text-muted" style="font-size:0.78rem;">Store type</span>
          <div><code>${cfg.session_store_type || '–'}</code></div>
        </div>
        <div class="mb-2">
          <span class="text-muted" style="font-size:0.78rem;">Session TTL</span>
          <div><code>${cfg.session_ttl_s ? cfg.session_ttl_s + 's (' + Math.round(cfg.session_ttl_s/60) + ' min)' : '–'}</code></div>
        </div>
        <div class="mb-2">
          <span class="text-muted" style="font-size:0.78rem;">Deferred dimensions</span>
          <div>${(cfg.deferred_dims || []).length
            ? cfg.deferred_dims.map(d => `<span class="badge badge-deferred me-1">${d}</span>`).join('')
            : '<span class="text-muted">none</span>'
          }</div>
        </div>
        <div class="mt-3 pt-2 border-top" style="border-color:#2d3140!important; font-size:0.75rem; color:#666;">
          Set via env vars · requires restart to change
        </div>`;
    }
  } catch (e) {
    const sb = document.getElementById('pr-session-body');
    if (sb) sb.innerHTML = `<span class="text-danger" style="font-size:0.8rem;">PE unreachable: ${e.message}</span>`;
  }

  // Mock mode — reuse existing refreshMockMode() + sync pr-mock-toggle
  try {
    const mm = await apiGet('/v1/proxy/mock-mode');
    const isOn = !!mm.mock_mode;

    const mmBadge = document.getElementById('pr-mockmode-badge');
    if (mmBadge) {
      mmBadge.textContent = isOn ? 'ON' : 'OFF';
      mmBadge.className   = 'badge ms-auto ' + (isOn ? 'bg-warning text-dark' : 'bg-secondary');
    }

    const prToggle = document.getElementById('pr-mock-toggle');
    if (prToggle) prToggle.checked = isOn;

    // Keep the navbar toggle in sync too
    await refreshMockMode();
  } catch (e) { /* GS unreachable — leave badges as-is */ }

  // Policy Pack Inspector — non-blocking
  loadPackInspector();
}

// ── App Trust Tracker — Evaluation Sensitivity card ──────────────────────────

async function loadAppTrust() {
  const container = document.getElementById('pr-app-trust-container');
  if (!container) return;
  container.innerHTML = `<div class="text-muted" style="font-size:0.83rem;"><div class="spinner-border spinner-sm me-2"></div>Loading app trust scores…</div>`;

  try {
    const data = await apiGet('/v1/proxy/app-trust');
    // Only show apps that have at least one recorded evaluation
    const apps = (data.apps || []).filter(a => (a.total_evaluations ?? 0) > 0);

    if (apps.length === 0) {
      container.innerHTML = `<div class="text-muted" style="font-size:0.83rem; padding:1rem 0;">
        No evaluations recorded yet. App trust scores appear here once evaluations are processed.
      </div>`;
      return;
    }

    const cards = apps.map(app => {
      const score     = app.score ?? 1.0;
      const pct       = Math.round(score * 100);
      const status    = app.status || 'maintaining';
      const counts    = app.verdict_counts || {};
      const events    = app.recent_events  || [];

      const { color, label, icon } = _trustStatusMeta(status);

      // Score bar colour matches status
      const barColor = color;

      // Recent events table (last 10, newest first)
      const evRows = events.slice().reverse().map(ev => {
        const delta     = ev.delta >= 0 ? `<span style="color:#2ecc71;">+${ev.delta.toFixed(2)}</span>`
                                        : `<span style="color:#e74c3c;">${ev.delta.toFixed(2)}</span>`;
        const vBadge    = _verdictBadge(ev.verdict);
        const ts        = ev.ts ? new Date(ev.ts).toLocaleTimeString() : '–';
        const scoreStr  = (ev.score ?? 0).toFixed(3);
        return `<tr>
          <td style="color:#888; font-size:0.75rem;">${ts}</td>
          <td>${vBadge}</td>
          <td>${delta}</td>
          <td><code style="font-size:0.78rem;">${scoreStr}</code></td>
        </tr>`;
      }).join('');

      const evTable = events.length ? `
        <table class="table table-sm mb-0" style="font-size:0.8rem;">
          <thead><tr>
            <th>Time</th><th>Verdict</th><th>Delta</th><th>Score</th>
          </tr></thead>
          <tbody>${evRows}</tbody>
        </table>` : `<div class="text-muted" style="font-size:0.78rem;">No events yet.</div>`;

      return `
      <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2" style="font-size:0.85rem;">
          <i class="bi bi-app-indicator me-1 text-info"></i>
          <strong>${app.app_id}</strong>
          <span class="ms-auto d-flex align-items-center gap-2">
            <span style="font-size:0.78rem; color:${color};">${icon} ${label}</span>
            <span class="badge" style="background:${color}20; color:${color}; border:1px solid ${color}40; font-size:0.78rem;">${pct}%</span>
            <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:0.72rem;"
                    onclick="resetAppTrust('${app.app_id}')" title="Reset score to 1.0">
              <i class="bi bi-arrow-counterclockwise"></i> Reset
            </button>
          </span>
        </div>
        <div class="card-body p-3">
          <!-- Score bar -->
          <div class="mb-3">
            <div class="d-flex justify-content-between mb-1" style="font-size:0.78rem;">
              <span class="text-muted">Trust Score</span>
              <span style="color:${barColor}; font-weight:600;">${score.toFixed(3)}</span>
            </div>
            <div style="background:#2d3140; border-radius:4px; height:8px; overflow:hidden;">
              <div style="width:${pct}%; background:${barColor}; height:100%; border-radius:4px; transition:width 0.4s ease;"></div>
            </div>
          </div>

          <!-- Verdict counts -->
          <div class="d-flex gap-4 mb-3" style="font-size:0.8rem;">
            <div>
              <span class="text-muted">Total evals</span>
              <div><strong>${app.total_evaluations ?? 0}</strong></div>
            </div>
            <div>
              <span class="text-muted">Coercive</span>
              <div style="color:#e74c3c;"><strong>${counts.COERCIVE ?? 0}</strong></div>
            </div>
            <div>
              <span class="text-muted">Normative</span>
              <div style="color:#f1c40f;"><strong>${counts.NORMATIVE ?? 0}</strong></div>
            </div>
            <div>
              <span class="text-muted">Permissive</span>
              <div style="color:#2ecc71;"><strong>${counts.PERMISSIVE ?? 0}</strong></div>
            </div>
          </div>

          <!-- Recent events -->
          <div>
            <div class="text-muted mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.05em;">
              Recent Events (last ${events.length})
            </div>
            ${evTable}
          </div>
        </div>
      </div>`;
    });

    container.innerHTML = cards.join('');

  } catch (e) {
    container.innerHTML = `<div class="alert alert-danger py-2 mb-0" style="font-size:0.82rem;">
      Failed to load app trust scores: ${e.message}
    </div>`;
  }
}

async function resetAppTrust(appId) {
  if (!confirm(`Reset trust score for "${appId}" to 1.0?\n\nThis will clear all verdict history for this app.`)) return;
  try {
    await fetch(`/v1/proxy/app-trust/${encodeURIComponent(appId)}`, { method: 'DELETE' });
    showToast(`Trust score reset for ${appId}`, 'success');
    loadAppTrust();
  } catch (e) {
    showToast(`Reset failed: ${e.message}`, 'danger');
  }
}

// ============================================================
// Agent Activity table
// ============================================================
async function loadAgentActivity() {
  const container = document.getElementById('agent-activity-container');
  if (!container) return;
  container.innerHTML = `<div class="text-muted text-center py-3" style="font-size:0.8rem;"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>`;

  try {
    const data = await apiGet('/v1/metrics/agent-activity');
    const agents = data.agents || [];

    if (agents.length === 0) {
      container.innerHTML = `<div class="text-muted" style="font-size:0.8rem;padding:0.75rem 0;">
        No agent evaluations recorded yet.<br>
        <span style="font-size:0.72rem;">Evaluations appear here once <code>agent_nodes=[]</code>
        is set in <code>instrument()</code> and the app processes a request.</span>
      </div>`;
      return;
    }

    const rows = agents.map((a, idx) => {
      const detailId = `agent-detail-${idx}`;
      const violDims = a.violation_dimensions || {};
      const warnDims = a.warning_dimensions   || {};
      const hasDetail = Object.keys(violDims).length > 0 || Object.keys(warnDims).length > 0;

      const violBadge = a.violations > 0
        ? `<span class="badge badge-coercive" style="font-size:0.65rem;">${a.violations}</span>`
        : `<span style="color:#555;font-size:0.78rem;">–</span>`;
      const warnBadge = a.warnings > 0
        ? `<span class="badge badge-normative ms-1" style="font-size:0.65rem;">${a.warnings}</span>`
        : '';
      const roles = (a.roles || []).map(r => {
        const rLabels = { tool_call: 'tool', agent_to_agent: 'a2a', llm_response: 'llm', user_prompt: 'user' };
        return `<span style="font-size:0.62rem;color:#6ea8fe;background:#12203a;border-radius:3px;padding:0 3px;">${rLabels[r] || r}</span>`;
      }).join(' ');

      const tokens = a.total_tokens > 0 ? _fmtNum(a.total_tokens) : '–';
      const cost   = a.cost_usd > 0
        ? `<span style="color:#6fcf97;font-size:0.72rem;" title="$${a.cost_usd.toFixed(6)}">$${a.cost_usd < 0.01 ? a.cost_usd.toFixed(5) : a.cost_usd.toFixed(4)}</span>`
        : `<span style="color:#555;font-size:0.72rem;">–</span>`;

      const chevron = hasDetail
        ? `<span id="${detailId}-icon" style="font-size:0.65rem;color:#6ea8fe;margin-left:4px;">▶</span>`
        : '';

      // Dimension pill builders
      const dimPill = (dim, count, color) =>
        `<span style="display:inline-block;margin:2px;padding:1px 7px;border-radius:10px;font-size:0.68rem;background:${color}22;border:1px solid ${color}66;color:${color};">
          ${dim} <strong>×${count}</strong>
        </span>`;

      const violPills = Object.entries(violDims).map(([d,c]) => dimPill(d, c, '#e05c5c')).join('');
      const warnPills = Object.entries(warnDims).map(([d,c]) => dimPill(d, c, '#e0a030')).join('');

      const passed  = a.evaluations - a.violations - a.warnings;
      const enfLine = `
        <div style="margin-top:6px;font-size:0.68rem;color:#888;">
          Enforcement:
          ${a.violations > 0 ? `<span style="color:#e05c5c;">${a.violations} blocked</span>` : ''}
          ${a.warnings   > 0 ? `<span style="color:#e0a030;margin-left:4px;">${a.warnings} warned</span>` : ''}
          ${passed > 0 ? `<span style="color:#555;margin-left:4px;">${passed} passed</span>` : ''}
        </div>`;

      const detailPanel = hasDetail ? `
        <tr id="${detailId}" style="display:none;">
          <td colspan="5" style="padding:0 0.5rem 0.5rem 2rem;border-top:none;">
            <div style="background:#0d1a2d;border-radius:6px;padding:0.6rem 0.8rem;">
              ${violPills.length ? `<div style="font-size:0.68rem;color:#888;margin-bottom:3px;">Violations by dimension</div>${violPills}` : ''}
              ${warnPills.length ? `<div style="font-size:0.68rem;color:#888;margin-top:5px;margin-bottom:3px;">Warnings by dimension</div>${warnPills}` : ''}
              ${enfLine}
            </div>
          </td>
        </tr>` : '';

      return `<tr style="cursor:${hasDetail ? 'pointer' : 'default'};" onclick="${hasDetail ? `_toggleAgentDetail('${detailId}')` : ''}">
        <td style="font-size:0.78rem;">
          <code style="color:#c8d8f0;font-size:0.75rem;">${a.agent_name}</code>${chevron}
          <div style="margin-top:2px;">${roles}</div>
        </td>
        <td class="text-center" style="font-size:0.8rem;color:#aaa;">${a.evaluations}</td>
        <td class="text-center">${violBadge}${warnBadge}</td>
        <td class="text-center" style="font-size:0.78rem;color:#aaa;" title="${a.prompt_tokens}P + ${a.completion_tokens}C">${tokens}</td>
        <td class="text-end">${cost}</td>
      </tr>${detailPanel}`;
    }).join('');

    container.innerHTML = `
      <table class="table table-sm mb-1" style="font-size:0.78rem;">
        <thead>
          <tr>
            <th>Agent</th>
            <th class="text-center">Evals</th>
            <th class="text-center">Flags</th>
            <th class="text-center" title="Total tokens (prompt + completion)">Tokens</th>
            <th class="text-end" title="Estimated cost via litellm pricing">Cost</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
      <div class="text-muted" style="font-size:0.68rem;">
        Flags: <span class="badge badge-coercive" style="font-size:0.58rem;">N</span> blocked
        <span class="badge badge-normative ms-1" style="font-size:0.58rem;">N</span> warned
        · Click a row to see violation dimensions
      </div>`;

  } catch (e) {
    container.innerHTML = `<div class="alert alert-danger py-2 mb-0" style="font-size:0.8rem;">
      Failed to load agent activity: ${e.message}
    </div>`;
  }
}

function _fmtNum(n) {
  if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
  if (n >= 1000)    return (n / 1000).toFixed(1) + 'k';
  return String(n);
}

function _toggleAgentDetail(id) {
  const panel = document.getElementById(id);
  const icon  = document.getElementById(id + '-icon');
  if (!panel) return;
  const open = panel.style.display === 'none';
  panel.style.display = open ? 'table-row' : 'none';
  if (icon) icon.textContent = open ? '▼' : '▶';
}

function _trustStatusMeta(status) {
  switch (status) {
    case 'maintaining':  return { color: '#2ecc71', label: 'Maintaining',  icon: '🟢' };
    case 'step_up':      return { color: '#f1c40f', label: 'Step-Up',      icon: '🟡' };
    case 'step_up_plus': return { color: '#e67e22', label: 'Step-Up+',     icon: '🟠' };
    case 'critical':     return { color: '#e74c3c', label: 'Critical',     icon: '🔴' };
    default:             return { color: '#888',    label: status,          icon: '⚪' };
  }
}

function _verdictBadge(verdict) {
  switch ((verdict || '').toUpperCase()) {
    case 'COERCIVE':   return `<span class="badge badge-coercive">${verdict}</span>`;
    case 'NORMATIVE':  return `<span class="badge badge-normative">${verdict}</span>`;
    case 'PERMISSIVE': return `<span class="badge badge-permissive">${verdict}</span>`;
    default:           return `<span class="badge bg-secondary">${verdict}</span>`;
  }
}

// ============================================================
// POLICY STACK TAB
// ============================================================

// Layer → tier mapping for the 5-tier template
const _TIER_DEF = [
  {
    tier: 1, key: 'mandatory',
    label: 'Tier 1 — Universal Baseline',
    desc:  'Runs on every request before any other pack. A COERCIVE result here aborts the entire chain.',
    color: '#e74c3c', fixed: true,
  },
  {
    tier: 2, key: ['domain-mandatory','domain-addon'],
    label: 'Tier 2 — Domain Packs',
    desc:  'Context-activated packs for specific domains (e.g. financial services). ' +
           'Activated by request metadata — source app, transaction type, counterparty flags.',
    color: '#3498db',
    ctxNote: 'These packs activate when request metadata matches a context rule (e.g. source app, transaction flags). ' +
             'Context rules are defined in context_routing.yaml on the Policy Engine.',
  },
  {
    tier: 3, key: ['regulatory','regional'],
    label: 'Tier 3 — Regulatory & Compliance',
    desc:  'Jurisdiction or regulation-specific packs (e.g. EU AI Act, GDPR). ' +
           'Activated by deployment context or always-on for regulated deployments.',
    color: '#9b59b6',
    ctxNote: 'Context activation uses the same mechanism as Tier 2. Regulatory packs often pair with a finapp or jurisdiction context tag.',
  },
  {
    tier: 4, key: ['exception','advisory'],
    label: 'Tier 4 — Exception & Advisory',
    desc:  'Temporary overrides or non-blocking advisory signals. Exception packs require an expiry date.',
    color: '#95a5a6',
  },
];

// Enforcement display for Policy Stack — label + tooltip
const _PS_ENFC = {
  'always-on':               { label: 'Always-On',              tip: 'Cannot be disabled. Runs on every request for this deployment.' },
  'flexible-threshold-only': { label: 'Sensitivity-Adjustable', tip: 'Cannot be disabled, but sensitivity thresholds can be tuned per app via PAP.' },
  'flexible':                { label: 'Flexible',               tip: 'Can be enabled/disabled per deployment via BundlePackConfig.' },
};

// Mode display
const _MODE_META2 = {
  'collect-all':             { label: '⊕ Collect All',       tip: 'All dimensions run. Results aggregated for final verdict.', color: '#3498db' },
  'abort-on-first-coercive': { label: '⚡ Abort on Violation', tip: 'Chain stops on first COERCIVE result.',                    color: '#e74c3c' },
};

// Strictest profile in a pack's dimensions
function _strictnessOf(dims) {
  if ((dims||[]).some(d => d.profile === 'zero_tolerance')) return { label: 'Zero-Tolerance', color: '#e74c3c', dot: '🔴' };
  if ((dims||[]).some(d => d.profile === 'strict'))         return { label: 'Strict',          color: '#f39c12', dot: '🟡' };
  return                                                             { label: 'Standard',        color: '#2ecc71', dot: '🟢' };
}

// Legacy compat — still referenced by _renderEvaluatorCatalog
const _LAYER_LABEL = {
  mandatory:            { label: 'Tier 1 · Mandatory',      color: '#e74c3c' },
  'domain-mandatory':   { label: 'Tier 2 · Domain',         color: '#3498db' },
  'domain-addon':       { label: 'Tier 2 · Domain Add-on',  color: '#3498db' },
  regulatory:           { label: 'Tier 3 · Regulatory',     color: '#9b59b6' },
  regional:             { label: 'Tier 3 · Regional',       color: '#9b59b6' },
  exception:            { label: 'Tier 4 · Exception',      color: '#f39c12' },
  advisory:             { label: 'Tier 4 · Advisory',       color: '#95a5a6' },
};
const _ENFC_LABEL = {
  'always-on':               'Always-On',
  'flexible-threshold-only': 'Sensitivity-Adjustable',
  flexible:                  'Flexible',
};
const _ALGO_LABEL = {
  worst_case:    { label: 'Worst-Case Fold',  tip: 'Any COERCIVE dimension → pack verdict is COERCIVE. Most conservative, no configuration needed.' },
  weighted_risk: { label: 'Weighted Risk',    tip: 'Weighted average of dimension scores maps to a verdict band.' },
  rule_tree:     { label: 'Rule Tree',        tip: 'Declarative conditions evaluated in order — first match wins.' },
};

async function loadPolicyStack() {
  // Fetch packs, evaluators, and policies in parallel.
  // Policies are needed to show the Define/Edit Policy buttons in the
  // Evaluator Catalog — without them _renderEvaluatorCatalog receives
  // policyMapReady=undefined (falsy) and hides the entire button row.
  let packsData = { pack_engine_active: false, packs: [] };
  let evalData  = { evaluations: [] };
  let polData   = { policies: [] };
  try {
    [packsData, evalData, polData] = await Promise.all([
      apiGet('/v1/proxy/packs'),
      apiGet('/v1/proxy/evaluations'),
      apiGet('/v1/policies').catch(() => ({ policies: [] })),
    ]);
  } catch (e) {
    ['ps-stack-container','ps-library-container','ps-evaluators-container'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = `<div class="text-danger" style="font-size:0.83rem;"><i class="bi bi-exclamation-triangle me-1"></i>Failed to load: ${escHtml(e.message)}</div>`;
    });
    return;
  }

  const packs = packsData.packs || [];
  const evals = evalData.evaluations || [];

  // Build dimension → policy map (global policies only, same as loadEvaluations)
  const policyMap = {};
  for (const p of (polData.policies || [])) {
    if (!p.app_id) policyMap[p.dimension] = p;
  }
  // Keep the module-level cache in sync so the catalog edit modal has fresh data
  // regardless of which tab triggered the render.
  _evalPolicyMap      = policyMap;
  _evalPolicyMapReady = true;

  _renderStackExecution(packs);
  _renderPolicyLibrary(packs);
  _renderEvaluatorCatalog(evals, packs, policyMap, true);
  initPackBuilder(evals, packs);
}

function _renderStackExecution(packs) {
  const el = document.getElementById('ps-stack-container');
  if (!el) return;
  if (!packs.length) {
    el.innerHTML = '<div class="text-muted" style="font-size:0.83rem;">Pack engine not active — set ENABLE_PACK_ENGINE=true and restart.</div>';
    return;
  }

  const stackOverlapMap = _buildOverlapMap(packs);

  // Build a lookup: layer value(s) → packs assigned there
  const packsByLayer = {};
  for (const p of packs) packsByLayer[p.layer] = [...(packsByLayer[p.layer]||[]), p];

  const tierBlocks = _TIER_DEF.map(tier => {
    const keys   = Array.isArray(tier.key) ? tier.key : [tier.key];
    const tierPacks = keys.flatMap(k => packsByLayer[k] || []);

    // Pack rows
    const packRows = tierPacks.map(p => {
      const mode    = _MODE_META2[p.mode] || { label: p.mode, color: '#888', tip: '' };
      const enfc    = _PS_ENFC[p.enforcement] || { label: p.enforcement, tip: '' };
      const strict  = _strictnessOf(p.dimensions);
      const hasOverlap = stackOverlapMap[p.id];
      const hasHitl    = p.hitl_trigger;

      const packIsActive  = p.active !== false;
      const hitlBadge     = hasHitl ? `<span style="font-size:0.63rem;color:#9b59b6;background:#9b59b618;border:1px solid #9b59b633;border-radius:3px;padding:1px 5px;" title="Human-in-the-loop review triggered on COERCIVE">⚑ HITL</span>` : '';
      const overlapBadge  = hasOverlap ? `<span style="font-size:0.63rem;color:#f39c12;background:#f39c1218;border:1px solid #f39c1233;border-radius:3px;padding:1px 5px;" title="${hasOverlap.size} evaluator(s) shared with another pack — open Pack Library for details">⚠ overlap</span>` : '';
      const stackToggleBtn = p.layer === 'mandatory' ? '' :
        `<label style="display:inline-flex;align-items:center;gap:5px;cursor:pointer;margin:0;" title="${packIsActive?'Click to disable this pack':'Click to enable this pack'}">
          <div onclick="togglePackActive('${escHtml(p.id)}')" style="position:relative;width:30px;height:16px;background:${packIsActive?'#2ecc71':'#444'};border-radius:8px;transition:background 0.2s;flex-shrink:0;">
            <div style="position:absolute;top:2px;left:${packIsActive?'15px':'2px'};width:12px;height:12px;background:#fff;border-radius:50%;transition:left 0.2s;"></div>
          </div>
        </label>`;

      const activationLabel = (p.layer === 'mandatory')
        ? `<span style="font-size:0.7rem;color:#666;font-style:italic;">every request</span>`
        : `<span style="font-size:0.7rem;color:#666;font-style:italic;" title="${escHtml(tier.ctxNote||'')}">context-activated <i class="bi bi-info-circle" style="font-style:normal;"></i></span>`;

      return `
        <div style="display:flex;align-items:center;gap:8px;padding:7px 14px;border-bottom:1px solid #1a1d2b;flex-wrap:wrap;${hasOverlap?'background:#f39c1206;':''}${!packIsActive?'opacity:0.55;':''}">>
          <span style="font-size:0.82rem;font-weight:600;color:${packIsActive?'#ddd':'#666'};min-width:160px;font-family:monospace;">${escHtml(p.id)}</span>
          ${!packIsActive?`<span style="font-size:0.63rem;color:#666;background:#66666618;border:1px solid #66666633;border-radius:3px;padding:0 5px;">○ disabled</span>`:''}
          <span style="font-size:0.65rem;color:${mode.color};background:${mode.color}18;border:1px solid ${mode.color}33;border-radius:3px;padding:1px 6px;" title="${escHtml(mode.tip)}">${mode.label}</span>
          <span style="font-size:0.65rem;color:#888;background:#ffffff0a;border-radius:3px;padding:1px 6px;" title="${escHtml(enfc.tip)}">${escHtml(enfc.label)}</span>
          <span style="font-size:0.65rem;" title="Strictest profile in this pack: ${strict.label}">${strict.dot} ${strict.label}</span>
          ${hitlBadge} ${overlapBadge}
          <span style="margin-left:auto;font-size:0.7rem;color:#555;">${activationLabel}</span>
          ${stackToggleBtn}
          <button onclick="editPack('${escHtml(p.id)}')" style="font-size:0.63rem;background:#1a2a3a;color:#3498db;border:1px solid #3498db33;border-radius:3px;padding:0 6px;cursor:pointer;">
            ${p.layer==='mandatory'?'Inspect':'Edit'}
          </button>
        </div>`;
    }).join('');

    const emptySlot = !tierPacks.length ? `
      <div style="padding:8px 14px;display:flex;align-items:center;gap:8px;">
        <span style="font-size:0.75rem;color:#2d3140;border:1px dashed #2d3140;border-radius:4px;padding:4px 12px;">
          No packs assigned — go to Pack Library to add
        </span>
      </div>` : '';

    const ctxNote = tier.ctxNote ? `
      <div style="padding:4px 14px 8px;font-size:0.7rem;color:#555;">
        <i class="bi bi-info-circle me-1"></i>${escHtml(tier.ctxNote)}
      </div>` : '';

    return `
      <div style="border:1px solid ${tier.color}33;border-radius:6px;margin-bottom:10px;overflow:hidden;">
        <div style="background:${tier.color}12;padding:8px 14px;display:flex;align-items:baseline;gap:10px;">
          <span style="font-size:0.78rem;font-weight:700;color:${tier.color};">${escHtml(tier.label)}</span>
          <span style="font-size:0.72rem;color:#555;">${escHtml(tier.desc)}</span>
        </div>
        ${packRows}${emptySlot}${ctxNote}
      </div>`;
  });

  el.innerHTML = tierBlocks.join('');
}

// Build a map of dim id → list of pack ids that contain it (for overlap detection)
function _buildOverlapMap(packs) {
  const dimToPacks = {};
  for (const p of packs) {
    for (const d of (p.dimensions || [])) {
      if (!dimToPacks[d.id]) dimToPacks[d.id] = [];
      dimToPacks[d.id].push(p.id);
    }
  }
  // { packId → Set<dimId> } for dims that appear in >1 pack
  const result = {};
  for (const [dimId, packIds] of Object.entries(dimToPacks)) {
    if (packIds.length > 1) {
      for (const pid of packIds) {
        if (!result[pid]) result[pid] = new Set();
        result[pid].add(dimId);
      }
    }
  }
  return result;
}

function _renderPolicyLibrary(packs) {
  const el = document.getElementById('ps-library-container');
  if (!el) return;
  if (!packs.length) {
    el.innerHTML = '<div class="text-muted" style="font-size:0.83rem;">No packs loaded.</div>';
    return;
  }

  const overlapMap = _buildOverlapMap(packs);

  const cards = packs.map(p => {
    const layerMeta   = _LAYER_LABEL[p.layer]    || { label: p.layer,    color: '#888' };
    const enfcMeta    = _PS_ENFC[p.enforcement] || { label: p.enforcement, tip: '' };
    const modeMeta    = _MODE_META2[p.mode]       || { label: p.mode, color: '#888', tip: '' };
    const strict      = _strictnessOf(p.dimensions);
    const overlapDims = overlapMap[p.id];  // Set<dimId> or undefined

    const dimRows = (p.dimensions || []).map(d => {
      const isOverlap  = overlapDims && overlapDims.has(d.id);
      const abortBadge = d.abort
        ? `<span style="font-size:0.63rem;color:#e74c3c;background:#e74c3c18;border-radius:3px;padding:1px 4px;" title="Aborts chain on COERCIVE">⚡ abort</span>` : '';
      const overlapBadge = isOverlap
        ? `<span style="font-size:0.62rem;color:#f39c12;background:#f39c1218;border-radius:3px;padding:1px 4px;" title="This evaluator is referenced by more than one pack — resolve the overlap in Pack Builder">⚠ overlap</span>` : '';
      const bands = d.thresholds ? `
        <span title="Permissive" style="font-size:0.63rem;color:#2ecc71;">[1–${d.thresholds.permissive[1]}]</span>
        <span title="Normative"  style="font-size:0.63rem;color:#f39c12;">[${d.thresholds.normative[0]}–${d.thresholds.normative[1]}]</span>
        <span title="Coercive"   style="font-size:0.63rem;color:#e74c3c;">[${d.thresholds.coercive[0]}–9]</span>` : '';
      const profileColor = d.profile==='zero_tolerance'?'#e74c3c': d.profile==='strict'?'#f39c12':'#2ecc71';
      const roleStr = (d.roles||[]).map(r =>
        `<span style="font-size:0.62rem;background:#ffffff0a;border-radius:3px;padding:0 4px;color:#777;">${r.replace('_prompt','').replace('_response','_resp').replace('agent_to_agent','a2a')}</span>`
      ).join(' ');
      return `
        <div style="display:flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px solid #0d1017;font-size:0.78rem;flex-wrap:wrap;${isOverlap?'background:#f39c1208;':''}">
          <span style="min-width:210px;color:${isOverlap?'#f39c12':'#ccc'};font-family:monospace;font-size:0.75rem;">${escHtml(d.id)}</span>
          <span style="font-size:0.68rem;color:${profileColor};background:${profileColor}18;border-radius:3px;padding:0 5px;">${escHtml(d.profile||'')}</span>
          <span style="font-size:0.65rem;color:#666;">sev ${d.severity}</span>
          ${bands} ${abortBadge} ${overlapBadge}
          <span style="margin-left:auto;">${roleStr}</span>
        </div>`;
    }).join('');

    const adjRows = (p.context_adjustments||[]).filter(a => a.signal).map(a =>
      `<div style="font-size:0.72rem;color:#888;padding:2px 0;">
        if <span style="color:#aaa;">${escHtml(a.signal)}</span> ${escHtml(a.operator)} ${escHtml(String(a.value))}
        → step <span style="color:#f39c12;">${a.step > 0 ? '+' : ''}${a.step}</span>
        on [${(a.affects||[]).join(', ')}]
      </div>`
    ).join('') || '<div style="font-size:0.72rem;color:#444;">No trust-signal adjustments defined.</div>';

    const isActive     = p.active !== false;
    const isMandatory  = p.layer === 'mandatory';
    const hitlBadge    = p.hitl_trigger
      ? `<span style="font-size:0.65rem;color:#9b59b6;background:#9b59b618;border:1px solid #9b59b633;border-radius:4px;padding:1px 6px;" title="Human-in-the-loop: a COERCIVE result on this pack routes the decision to a human reviewer before the response is returned">⚑ HITL</span>` : '';
    const overlapAlert = overlapDims
      ? `<span style="font-size:0.65rem;color:#f39c12;background:#f39c1218;border:1px solid #f39c1233;border-radius:4px;padding:1px 6px;" title="This pack shares ${overlapDims.size} evaluator(s) with another pack. Shared evaluators are highlighted below. Remove the duplicate from one pack in the Pack Builder.">⚠ ${overlapDims.size} evaluator overlap${overlapDims.size>1?'s':''}</span>` : '';
    const activeBadge  = isActive
      ? `<span style="font-size:0.65rem;color:#2ecc71;background:#2ecc7118;border:1px solid #2ecc7133;border-radius:4px;padding:1px 6px;" title="Pack is loaded and active — all dimensions will be evaluated">● ACTIVE</span>`
      : `<span style="font-size:0.65rem;color:#888;background:#88888818;border:1px solid #88888833;border-radius:4px;padding:1px 6px;" title="Pack is disabled — dimensions will be skipped during evaluation">○ DISABLED</span>`;
    const toggleBtn    = isMandatory ? '' :
      `<label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin:0;" title="${isActive?'Click to disable this pack':'Click to enable this pack'}">
        <div onclick="togglePackActive('${escHtml(p.id)}')" style="position:relative;width:34px;height:18px;background:${isActive?'#2ecc71':'#444'};border-radius:9px;transition:background 0.2s;flex-shrink:0;">
          <div style="position:absolute;top:2px;left:${isActive?'17px':'2px'};width:14px;height:14px;background:#fff;border-radius:50%;transition:left 0.2s;box-shadow:0 1px 3px #0005;"></div>
        </div>
        <span style="font-size:0.65rem;color:${isActive?'#2ecc71':'#666'};">${isActive?'On':'Off'}</span>
      </label>`;

    return `
      <div style="border:1px solid ${overlapDims?'#f39c1244':isActive?'#2d3140':'#88888833'};border-radius:6px;margin-bottom:14px;overflow:hidden;${isActive?'':'opacity:0.75;'}">
        <div style="background:#1a1d2b;padding:10px 16px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
          <span style="font-size:0.88rem;font-weight:700;color:${isActive?'#fff':'#888'};font-family:monospace;">${escHtml(p.id)}</span>
          ${activeBadge}
          <span style="font-size:0.68rem;background:${layerMeta.color}22;color:${layerMeta.color};border:1px solid ${layerMeta.color}44;border-radius:4px;padding:1px 7px;">${layerMeta.label}</span>
          <span style="font-size:0.68rem;color:${modeMeta.color};background:${modeMeta.color}15;border-radius:4px;padding:1px 7px;" title="${escHtml(modeMeta.tip)}">${modeMeta.label}</span>
          <span style="font-size:0.68rem;color:#888;background:#ffffff0a;border-radius:4px;padding:1px 7px;" title="${escHtml(enfcMeta.tip)}">${escHtml(enfcMeta.label)}</span>
          <span style="font-size:0.68rem;" title="Strictest profile across all dimensions">${strict.dot} ${strict.label}</span>
          ${hitlBadge} ${overlapAlert}
          <span style="margin-left:auto;font-size:0.65rem;color:#444;">v${escHtml(p.version||'?')} · ${escHtml(p.owner||'')}</span>
          ${toggleBtn}
          <button onclick="editPack('${escHtml(p.id)}')" style="font-size:0.68rem;background:#1a2a3a;color:#3498db;border:1px solid #3498db44;border-radius:4px;padding:1px 8px;cursor:pointer;white-space:nowrap;">
            <i class="bi bi-pencil me-1"></i>${isMandatory ? 'Inspect' : 'Edit'}
          </button>
        </div>
        <div style="padding:8px 16px 4px;font-size:0.77rem;color:#666;">${escHtml(p.description||'')}</div>
        <div style="padding:4px 16px 10px;">
          <div style="font-size:0.65rem;color:#444;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px;">${(p.dimensions||[]).length} Dimensions</div>
          ${dimRows || '<div style="color:#444;font-size:0.78rem;">No dimensions.</div>'}
        </div>
        <div style="padding:8px 16px;background:#0a0c12;border-top:1px solid #2d3140;">
          <div style="font-size:0.65rem;color:#444;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px;display:flex;align-items:center;gap:4px;">
            Trust-Signal Adjustments
            <span style="cursor:help;color:#555;font-size:0.75rem;text-transform:none;letter-spacing:0;"
              title="Runtime threshold shifts driven by session or app trust scores. When a signal (e.g. session_trust_score) falls below a configured threshold, the pack tightens sensitivity on specified dimensions by applying a positive step shift — pushing scores into NORMATIVE or COERCIVE bands more readily. zero_tolerance dimensions are unaffected (their step is always 0). Configured via context_adjustments in the pack YAML.">ⓘ</span>
          </div>
          ${adjRows}
        </div>
      </div>`;
  }).join('');

  el.innerHTML = cards;
}

function _renderEvaluatorCatalog(evals, packs, policyMap, policyMapReady) {
  // policyMap: dimension → policy object (absent key = no policy defined)
  policyMap = policyMap || {};
  // policyMapReady: false means /v1/policies hasn't loaded yet → hide badges

  // Render into the Evaluations tab catalog container (primary) and the
  // legacy ps-evaluators-container if it still exists.
  const el = document.getElementById('eval-evaluators-container')
          || document.getElementById('ps-evaluators-container');
  if (!el) return;

  // Build reverse index: evaluator id → list of pack ids that reference it
  const usedBy = {};
  for (const p of packs) {
    for (const d of (p.dimensions || [])) {
      if (!usedBy[d.id]) usedBy[d.id] = [];
      usedBy[d.id].push(p.id);
    }
  }

  if (!evals.length) {
    el.innerHTML = '<div class="text-muted" style="font-size:0.83rem;">No evaluators returned from Guardrail Service.</div>';
    return;
  }

  // Count how many evaluators are missing a policy (for the header callout)
  const totalEvals = evals.length;
  const withPolicy = evals.filter(e => Object.prototype.hasOwnProperty.call(policyMap, e.dimension)).length;
  const withoutPolicy = totalEvals - withPolicy;

  // Category accent colours
  const CAT_COLOR = {
    safety:               '#e74c3c',
    security:             '#e67e22',
    trust:                '#9b59b6',
    financial_crime:      '#f39c12',
    corporate_governance: '#3498db',
    eu_ai_act:            '#2ecc71',
    prompt_filter:        '#1abc9c',
    session_signals:      '#8e9cc0',
  };
  const CAT_ORDER = ['safety','security','trust','financial_crime','corporate_governance','eu_ai_act','prompt_filter','session_signals'];
  const catColor  = cat => CAT_COLOR[cat] || '#6ea8fe';

  const providerColor = p =>
    p === 'mock_provider'       ? '#f39c12' :
    p === 'aws_bedrock_guardrail'? '#3498db' :
    p === 'local_policy_classifier' ? '#2ecc71' :
    p === 'azure_content_safety'? '#e74c3c' : '#6ea8fe';

  // Group by category
  const cats = {};
  for (const e of evals) {
    const cat = e.category || 'other';
    if (!cats[cat]) cats[cat] = [];
    cats[cat].push(e);
  }

  const orderedCats = [...CAT_ORDER.filter(c => cats[c]),
                       ...Object.keys(cats).filter(c => !CAT_ORDER.includes(c)).sort()];

  // Policy coverage summary banner
  let coverageHtml = '';
  if (policyMapReady) {
    const pct = totalEvals > 0 ? Math.round(withPolicy / totalEvals * 100) : 0;
    const coverageColor = pct === 100 ? '#2ecc71' : pct >= 50 ? '#f39c12' : '#e74c3c';
    coverageHtml = `
      <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded" style="background:#12151f;border:1px solid #2d3140;">
        <span style="font-size:0.75rem;color:#aaa;"><i class="bi bi-shield-half me-1"></i>Policy coverage:</span>
        <span style="font-size:0.8rem;font-weight:600;color:${coverageColor};">${withPolicy} / ${totalEvals}</span>
        <div style="flex:1;height:4px;background:#2d3140;border-radius:2px;max-width:120px;">
          <div style="width:${pct}%;height:100%;background:${coverageColor};border-radius:2px;"></div>
        </div>
        ${withoutPolicy > 0
          ? `<span style="font-size:0.72rem;color:#e74c3c;"><i class="bi bi-exclamation-triangle me-1"></i>${withoutPolicy} evaluator${withoutPolicy>1?'s':''} without a policy</span>`
          : `<span style="font-size:0.72rem;color:#2ecc71;"><i class="bi bi-check-circle me-1"></i>All evaluators have policies</span>`
        }
      </div>`;
  }

  let html = coverageHtml;
  for (const cat of orderedCats) {
    const cc = catColor(cat);
    html += `
      <div class="mb-4">
        <div class="d-flex align-items-center mb-2 pb-1" style="border-bottom:1px solid ${cc}44;">
          <span style="width:10px;height:10px;border-radius:50%;background:${cc};margin-right:8px;flex-shrink:0;"></span>
          <span style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.09em;color:${cc};font-weight:600;">${escHtml(cat)}</span>
          <span style="margin-left:8px;font-size:0.68rem;color:#555;">${cats[cat].length} dimension${cats[cat].length>1?'s':''}</span>
        </div>
        <div class="row g-2">`;

    for (const e of cats[cat]) {
      const pc   = providerColor(e.provider || '');
      const refs = (usedBy[e.dimension] || []).map(pid =>
        `<span style="font-size:0.63rem;background:#3498db22;color:#3498db;border:1px solid #3498db44;border-radius:3px;padding:1px 5px;">${escHtml(pid)}</span>`
      ).join(' ');
      const roles = (e.roles || []).map(r =>
        `<span style="font-size:0.62rem;background:#ffffff0a;border-radius:3px;padding:0 4px;color:#777;">${r}</span>`
      ).join(' ');
      const statusBadge = e.status === 'active'
        ? `<span style="font-size:0.62rem;color:#2ecc71;"><i class="bi bi-circle-fill me-1" style="font-size:0.45rem;vertical-align:middle;"></i>active</span>`
        : `<span style="font-size:0.62rem;color:#95a5a6;"><i class="bi bi-circle me-1" style="font-size:0.45rem;vertical-align:middle;"></i>deferred</span>`;

      // Policy status badge + action button
      const hasPol = Object.prototype.hasOwnProperty.call(policyMap, e.dimension);
      const polBadge = hasPol
        ? `<span style="font-size:0.6rem;color:#2ecc71;background:#0f3b1e;border:1px solid #2ecc7133;border-radius:3px;padding:1px 5px;"><i class="bi bi-shield-check me-1"></i>Policy</span>`
        : `<span style="font-size:0.6rem;color:#e74c3c;background:#3b0f0f;border:1px solid #e74c3c33;border-radius:3px;padding:1px 5px;"><i class="bi bi-shield-x me-1"></i>No policy</span>`;
      const polBtn = hasPol
        ? `<button onclick='openDefineEvalPolicy(${JSON.stringify(e.dimension)}, true)'
             style="font-size:0.6rem;padding:1px 7px;background:#1a3050;border:1px solid #2a5080;color:#6ea8fe;border-radius:3px;cursor:pointer;">
             <i class="bi bi-pencil me-1"></i>Edit Policy</button>`
        : `<button onclick='openDefineEvalPolicy(${JSON.stringify(e.dimension)}, false)'
             style="font-size:0.6rem;padding:1px 7px;background:#0f2b18;border:1px solid #1a7a40;color:#6fcf97;border-radius:3px;cursor:pointer;">
             <i class="bi bi-plus-lg me-1"></i>Define Policy</button>`;

      html += `
          <div class="col-md-6 col-xl-4">
            <div style="background:#1a1d27;border:1px solid ${cc}28;border-left:3px solid ${cc};border-radius:6px;padding:10px 12px;">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <span style="font-family:monospace;font-size:0.8rem;color:#dde;">${escHtml(e.dimension||'')}</span>
                ${statusBadge}
              </div>
              <div class="d-flex align-items-center gap-2 mb-1">
                <span style="font-size:0.63rem;background:${pc}22;color:${pc};border:1px solid ${pc}44;border-radius:3px;padding:1px 5px;">${escHtml(e.provider||'—')}</span>
                ${roles}
              </div>
              ${refs ? `<div class="mt-1">${refs}</div>` : ''}
              ${policyMapReady ? `<div class="d-flex justify-content-between align-items-center mt-2 pt-1" style="border-top:1px solid #2d314066;">${polBadge}${polBtn}</div>` : ''}
            </div>
          </div>`;
    }

    html += `</div></div>`;
  }

  el.innerHTML = html;
}

function escHtml(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ============================================================
// EVALUATOR POLICY DEFINE / EDIT (from Evaluator Catalog)
// ============================================================

function openDefineEvalPolicy(dimension, hasPolicy) {
  // _evalPolicyMap stores the policy object directly when present; absent key = no policy
  const pol = Object.prototype.hasOwnProperty.call(_evalPolicyMap, dimension)
              ? _evalPolicyMap[dimension] : null;

  // Header
  document.getElementById('ep-modal-title').textContent =
    hasPolicy ? `Edit Policy — ${dimension}` : `Define Policy — ${dimension}`;
  document.getElementById('ep-dimension').value = dimension;

  // Severity
  const sev = pol ? (pol.severity || 2) : 2;
  document.getElementById('ep-severity').value = sev;

  // Thresholds — use existing or schema defaults
  const t = pol && pol.thresholds ? pol.thresholds : {};
  const perm = t.permissive || [1.0, 4.0];
  const norm = t.normative  || [5.0, 6.0];
  const coer = t.coercive   || [7.0, 9.0];
  document.getElementById('ep-perm-lo').value = perm[0];
  document.getElementById('ep-perm-hi').value = perm[1];
  document.getElementById('ep-norm-lo').value = norm[0];
  document.getElementById('ep-norm-hi').value = norm[1];
  document.getElementById('ep-coer-lo').value = coer[0];
  document.getElementById('ep-coer-hi').value = coer[1];

  // Remediations  (policy.remediations.{normative,coercive}; policy.actions.{human_note,...})
  const rems    = pol && pol.remediations ? pol.remediations : {};
  const actions = pol && pol.actions     ? pol.actions      : {};
  document.getElementById('ep-rem-norm').value   = rems.normative    || '';
  document.getElementById('ep-rem-coer').value   = rems.coercive     || '';
  document.getElementById('ep-human-note').value = actions.human_note || '';
  document.getElementById('ep-ops-alert').checked = !!(actions.ops_alert);
  document.getElementById('ep-incident-routing').value = actions.incident_routing || 'none';

  // Publish flag default on
  document.getElementById('ep-publish').checked = true;

  // Version info footer
  document.getElementById('ep-version-info').textContent =
    pol ? `version ${pol.version} · updated ${(pol.updated_at||'').substring(0,10)}` : 'New policy';

  new bootstrap.Modal(document.getElementById('evalPolicyModal')).show();
}

async function saveEvalPolicy() {
  const dimension = document.getElementById('ep-dimension').value;
  const isExisting = Object.prototype.hasOwnProperty.call(_evalPolicyMap, dimension);
  const publish    = document.getElementById('ep-publish').checked;

  const thresholds = {
    permissive: [parseFloat(document.getElementById('ep-perm-lo').value), parseFloat(document.getElementById('ep-perm-hi').value)],
    normative:  [parseFloat(document.getElementById('ep-norm-lo').value), parseFloat(document.getElementById('ep-norm-hi').value)],
    coercive:   [parseFloat(document.getElementById('ep-coer-lo').value), parseFloat(document.getElementById('ep-coer-hi').value)],
  };
  const shared = {
    severity:              parseInt(document.getElementById('ep-severity').value) || 2,
    thresholds,
    remediation_normative: document.getElementById('ep-rem-norm').value.trim()  || null,
    remediation_coercive:  document.getElementById('ep-rem-coer').value.trim()  || null,
    human_note:            document.getElementById('ep-human-note').value.trim() || null,
    ops_alert:             document.getElementById('ep-ops-alert').checked,
    incident_routing:      document.getElementById('ep-incident-routing').value,
  };

  const saveBtn = document.getElementById('ep-save-btn');
  saveBtn.disabled = true;
  try {
    // Create or update via the standard policy endpoints (always available)
    if (isExisting) {
      await apiPut(`/v1/policies/${encodeURIComponent(dimension)}`, shared);
    } else {
      await apiPost('/v1/policies', { dimension, ...shared });
    }
    const action = isExisting ? 'updated' : 'created';

    // Optionally publish immediately
    let pubMsg = '';
    if (publish) {
      try {
        await apiPost('/v1/policies/publish', {});
        pubMsg = ' · published to Policy Engine';
      } catch(pe) {
        pubMsg = ' (publish failed — check PE connection)';
      }
    }

    bootstrap.Modal.getInstance(document.getElementById('evalPolicyModal')).hide();
    showToast(`Policy for '${dimension}' ${action}${pubMsg}.`, publish ? 'success' : 'warning');

    // Reload the Evaluations tab to refresh coverage badges
    evalLoaded = false;
    loadEvaluations();
  } catch(e) {
    showToast(`Error saving policy: ${e.message}`, 'danger');
  } finally {
    saveBtn.disabled = false;
  }
}

// ============================================================
// PACK BUILDER
// ============================================================

let _builderEvals              = [];   // all evaluators from GS
let _builderDims               = {};   // { evalId → { profile, severity, abort, roles[] } }
let _editingPackId             = null; // null = new pack, string = editing existing
let _builderPacksCache         = [];   // last-fetched pack list for editPack()
let _builderContextAdjustments = [];   // preserved from existing pack; read-only in UI
let _builderIsLocked           = false; // true when inspecting a mandatory pack

const _ALL_ROLES = ['user_prompt', 'llm_response', 'agent_to_agent', 'tool_call'];

function initPackBuilder(evals, packs) {
  _builderEvals      = evals  || [];
  _builderPacksCache = packs  || [];
  _renderBuilderLibrary();
}

// ── Evaluator Library panel ───────────────────────────────────────────────────

function _filterBuilderLibrary() {
  _renderBuilderLibrary();
}

// Returns the set of evaluator ids already allocated to packs OTHER than the one being edited.
function _getDimsInOtherPacks() {
  const locked = new Set();
  for (const pack of _builderPacksCache) {
    if (pack.id === _editingPackId) continue;
    for (const d of (pack.dimensions || [])) locked.add(d.id);
  }
  return locked;
}

function _renderBuilderLibrary() {
  const el = document.getElementById('pb-eval-library');
  if (!el) return;
  const filter = (document.getElementById('pb-eval-filter')?.value || '').toLowerCase();
  const lockedInOtherPack = _getDimsInOtherPacks();

  // Group by category
  const cats = {};
  for (const e of _builderEvals) {
    if (filter && !e.dimension.toLowerCase().includes(filter)) continue;
    const cat = e.category || 'other';
    if (!cats[cat]) cats[cat] = [];
    cats[cat].push(e);
  }

  if (!Object.keys(cats).length) {
    el.innerHTML = '<div style="padding:10px 12px;color:#555;font-size:0.78rem;">No evaluators match filter.</div>';
    return;
  }

  let html = '';
  for (const [cat, evals] of Object.entries(cats).sort()) {
    html += `<div style="padding:3px 12px;font-size:0.62rem;color:#555;text-transform:uppercase;letter-spacing:0.05em;background:#0a0c12;border-bottom:1px solid #1a1d2b;">${escHtml(cat)}</div>`;
    for (const e of evals) {
      const inPack   = !!_builderDims[e.dimension];
      const locked   = lockedInOtherPack.has(e.dimension);  // used in another pack
      const inactive = e.status !== 'active';
      const pc       = e.provider === 'mock_provider' ? '#f39c12' : e.provider === 'aws_bedrock_guardrail' ? '#3498db' : '#2ecc71';

      let btnStyle, btnLabel, btnDisabled, nameStyle, rowOpacity, tooltip, rowBg, lockBadge;
      if (locked) {
        // Find which pack owns this evaluator so we can tell the user exactly why it's locked.
        const ownerPack = _builderPacksCache.find(
          p => p.id !== _editingPackId && (p.dimensions || []).some(d => d.id === e.dimension)
        );
        const ownerLabel = ownerPack ? ownerPack.id : 'another pack';
        btnStyle   = 'background:#1a1010;color:#555;border:1px solid #33222244;cursor:not-allowed;';
        btnLabel   = '🔒';
        btnDisabled = 'disabled';
        nameStyle  = 'color:#888;';
        rowOpacity = '1';
        rowBg      = 'background:#1a1510;';
        lockBadge  = `<span style="font-size:0.6rem;color:#7a5a30;background:#3a2a1022;border:1px solid #3a2a1066;border-radius:3px;padding:0 4px;margin-left:4px;" title="Assigned to pack: ${ownerLabel}">in use: ${ownerLabel}</span>`;
        tooltip    = `title="Already in pack '${ownerLabel}' — each evaluator can only belong to one pack"`;
      } else if (inPack) {
        btnStyle   = 'background:#0d2a1a;color:#2ecc71;border:1px solid #2ecc7144;cursor:pointer;';
        btnLabel   = '✓';
        btnDisabled = '';
        nameStyle  = 'color:#2ecc71;';
        rowOpacity = '1';
        rowBg      = 'background:#0a1f12;';
        lockBadge  = '';
        tooltip    = 'title="Assigned to this pack — click to remove. These evaluators will appear locked when building a different pack."';
      } else {
        btnStyle   = 'background:#1a2a3a;color:#3498db;border:1px solid #3498db44;cursor:pointer;';
        btnLabel   = '+';
        btnDisabled = inactive ? 'disabled' : '';
        nameStyle  = 'color:#ddd;';
        rowOpacity = inactive ? '0.45' : '1';
        rowBg      = '';
        lockBadge  = '';
        tooltip    = inactive ? 'title="Evaluator is deferred/inactive"' : '';
      }

      html += `
        <div style="display:flex;align-items:center;gap:6px;padding:5px 12px;border-bottom:1px solid #13151f;opacity:${rowOpacity};${rowBg}" ${tooltip}>
          <span style="font-size:0.75rem;${nameStyle}font-family:monospace;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
            title="${escHtml(e.dimension)}">${escHtml(e.dimension)}${lockBadge||''}</span>
          <span style="font-size:0.6rem;background:${pc}22;color:${pc};border-radius:3px;padding:0 4px;flex-shrink:0;">${escHtml((e.provider||'').replace('_provider',''))}</span>
          <button onclick="${locked ? '' : inPack ? `_removeDimFromBuilder('${escHtml(e.dimension)}')` : `_addDimToBuilder('${escHtml(e.dimension)}')`}"
            style="font-size:0.7rem;${btnStyle}border-radius:3px;padding:0 7px;flex-shrink:0;"
            ${btnDisabled}>
            ${btnLabel}
          </button>
        </div>`;
    }
  }
  el.innerHTML = html;
}

// ── Dimension management ──────────────────────────────────────────────────────

function _addDimToBuilder(evalId) {
  if (_builderDims[evalId]) return;
  const ev = _builderEvals.find(e => e.dimension === evalId);
  _builderDims[evalId] = {
    profile:  'standard',
    severity: 2,
    abort:    false,
    roles:    ev ? [...(ev.roles || [])] : [..._ALL_ROLES],
  };
  _renderBuilderDims();
  _renderBuilderLibrary();
}

function _removeDimFromBuilder(evalId) {
  delete _builderDims[evalId];
  _renderBuilderDims();
  _renderBuilderLibrary();
}

function _setDimField(evalId, field, value) {
  if (_builderDims[evalId]) _builderDims[evalId][field] = value;
}

function _toggleDimRole(evalId, role, checked) {
  if (!_builderDims[evalId]) return;
  const roles = _builderDims[evalId].roles || [];
  if (checked && !roles.includes(role)) roles.push(role);
  else _builderDims[evalId].roles = roles.filter(r => r !== role);
}

function _renderBuilderDims() {
  const el = document.getElementById('pb-dims-container');
  const countEl = document.getElementById('pb-dim-count');
  if (!el) return;

  const dimIds = Object.keys(_builderDims);
  if (countEl) countEl.textContent = dimIds.length ? `(${dimIds.length})` : '';

  if (!dimIds.length) {
    el.innerHTML = '<p style="color:#555;font-size:0.78rem;font-style:italic;padding:8px 0;">No evaluators added yet — click <strong style="color:#2ecc71;">+</strong> in the library to add.</p>';
    return;
  }

  const rows = dimIds.map(id => {
    const d = _builderDims[id];
    const roleCbs = _ALL_ROLES.map(r => {
      const checked = (d.roles || []).includes(r) ? 'checked' : '';
      const short   = { user_prompt: 'prompt', llm_response: 'response', agent_to_agent: 'a2a', tool_call: 'tool' }[r] || r;
      return `<label style="font-size:0.65rem;color:#888;display:flex;align-items:center;gap:2px;cursor:pointer;">
        <input type="checkbox" ${checked} onchange="_toggleDimRole('${id}','${r}',this.checked)" style="width:11px;height:11px;cursor:pointer;"/>
        ${short}
      </label>`;
    }).join('');

    return `
      <div style="border:1px solid #2d3140;border-radius:5px;padding:8px 10px;margin-bottom:6px;background:#0a0c12;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
          <span style="font-size:0.78rem;color:#ddd;font-family:monospace;flex:1;">${escHtml(id)}</span>
          <button onclick="_removeDimFromBuilder('${id}')"
            style="font-size:0.72rem;background:#2a1010;color:#e74c3c;border:1px solid #e74c3c33;border-radius:3px;padding:0 7px;cursor:pointer;">×</button>
        </div>
        <div style="display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap;">
          <div>
            <div style="font-size:0.62rem;color:#555;margin-bottom:2px;">Profile</div>
            <select onchange="_setDimField('${id}','profile',this.value)"
              style="font-size:0.72rem;background:#1a1d2b;color:#ccc;border:1px solid #2d3140;border-radius:3px;padding:2px 5px;">
              <option value="standard"       ${d.profile==='standard'?'selected':''}>standard</option>
              <option value="strict"         ${d.profile==='strict'?'selected':''}>strict</option>
              <option value="zero_tolerance" ${d.profile==='zero_tolerance'?'selected':''}>zero_tolerance</option>
            </select>
          </div>
          <div>
            <div style="font-size:0.62rem;color:#555;margin-bottom:2px;">Severity</div>
            <select onchange="_setDimField('${id}','severity',Number(this.value))"
              style="font-size:0.72rem;background:#1a1d2b;color:#ccc;border:1px solid #2d3140;border-radius:3px;padding:2px 5px;">
              <option value="1" ${d.severity===1?'selected':''}>1 — Low</option>
              <option value="2" ${d.severity===2?'selected':''}>2 — Med</option>
              <option value="3" ${d.severity===3?'selected':''}>3 — High</option>
            </select>
          </div>
          <div style="display:flex;flex-direction:column;align-items:center;">
            <div style="font-size:0.62rem;color:#555;margin-bottom:4px;display:flex;align-items:center;gap:3px;">
              Abort
              <span style="cursor:help;color:#444;font-size:0.7rem;"
                title="Per-evaluator abort flag. When checked: a COERCIVE result on this dimension immediately stops the pack — even if the pack mode is Collect All. Takes priority over pack-level execution mode. Redundant when pack mode is already Abort on Violation.">ⓘ</span>
            </div>
            <input type="checkbox" ${d.abort?'checked':''} onchange="_setDimField('${id}','abort',this.checked)"
              style="width:15px;height:15px;cursor:pointer;" title="Per-evaluator abort: stops the pack on COERCIVE regardless of pack execution mode"/>
          </div>
          <div>
            <div style="font-size:0.62rem;color:#555;margin-bottom:3px;">Roles</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">${roleCbs}</div>
          </div>
        </div>
      </div>`;
  }).join('');

  el.innerHTML = rows;
}

// ── Edit existing pack ────────────────────────────────────────────────────────

function _setBuilderLock(locked) {
  _builderIsLocked = locked;
  const ids = ['pb-layer','pb-enforcement','pb-mode','pb-version','pb-owner','pb-description'];
  for (const id of ids) {
    const el = document.getElementById(id);
    if (el) { el.disabled = locked; el.style.opacity = locked ? '0.45' : '1'; }
  }
  const banner  = document.getElementById('pb-locked-banner');
  if (banner)  banner.style.display  = locked ? 'block' : 'none';
  const saveBtn = document.getElementById('pb-save-btn');
  if (saveBtn) { saveBtn.style.display = locked ? 'none' : 'inline-block'; }
}

function _renderBuilderAdjustments(adjs) {
  const section = document.getElementById('pb-adj-section');
  const rows    = document.getElementById('pb-adj-rows');
  if (!section || !rows) return;
  if (!adjs || !adjs.length) { section.style.display = 'none'; return; }
  section.style.display = 'block';
  rows.innerHTML = adjs.filter(a => a.signal).map(a =>
    `<div style="padding:2px 0;">
      if <span style="color:#aaa;">${escHtml(a.signal)}</span> ${escHtml(a.operator)} ${escHtml(String(a.value))}
      → step <span style="color:#f39c12;">${a.step > 0 ? '+' : ''}${a.step}</span>
      on [${(a.affects||[]).join(', ')}]
    </div>`
  ).join('') || '<div style="color:#555;">No signal rules defined.</div>';
}

function editPack(packId) {
  const pack = _builderPacksCache.find(p => p.id === packId);
  if (!pack) { showToast('Pack data not loaded — refresh Policy Stack first', 'warning'); return; }

  _editingPackId             = packId;
  _builderContextAdjustments = pack.context_adjustments || [];

  const idEl = document.getElementById('pb-pack-id');
  if (idEl) { idEl.value = packId; idEl.disabled = true; }

  const set = (id, val) => { const el = document.getElementById(id); if (el) el.value = String(val); };
  set('pb-layer',       pack.layer       || 'domain-addon');
  set('pb-enforcement', pack.enforcement || 'flexible');
  set('pb-mode',        pack.mode        || 'collect-all');
  set('pb-version',     pack.version     || '1.0.0');
  set('pb-owner',       pack.owner       || '');
  set('pb-description', pack.description || '');

  _builderDims = {};
  for (const d of (pack.dimensions || [])) {
    _builderDims[d.id] = {
      profile:  d.profile  || 'standard',
      severity: d.severity || 2,
      abort:    !!d.abort,
      roles:    [...(d.roles || [])],
    };
  }

  const isMandatory = pack.layer === 'mandatory';
  _setBuilderLock(isMandatory);
  _renderBuilderAdjustments(_builderContextAdjustments);
  _renderBuilderDims();
  _renderBuilderLibrary();

  const titleEl = document.getElementById('pb-composer-title');
  if (titleEl) titleEl.textContent = isMandatory ? `Inspecting: ${packId}` : `Editing: ${packId}`;

  const saveBtn = document.getElementById('pb-save-btn');
  if (saveBtn) saveBtn.textContent = 'Update Pack';

  const delBtn = document.getElementById('pb-delete-btn');
  if (delBtn) delBtn.style.display = isMandatory ? 'none' : 'inline-block';

  _deleteCancel();   // reset any pending delete state
  _switchToBuilder();
}

function _switchToBuilder() {
  // Activate the Pack Builder sub-tab programmatically
  const tabEl = document.getElementById('ps-builder-subtab');
  if (tabEl) {
    const bsTab = new bootstrap.Tab(tabEl);
    bsTab.show();
  }
  document.getElementById('ps-builder-container')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── Reset / New pack ──────────────────────────────────────────────────────────

function resetPackBuilder() {
  _editingPackId             = null;
  _builderDims               = {};
  _builderContextAdjustments = [];

  const idEl = document.getElementById('pb-pack-id');
  if (idEl) { idEl.value = ''; idEl.disabled = false; }

  const set = (id, val) => { const el = document.getElementById(id); if (el) el.value = val; };
  set('pb-layer',       'domain-addon');
  set('pb-enforcement', 'flexible');
  set('pb-mode',        'collect-all');
  set('pb-version',     '1.0.0');
  set('pb-owner',       '');
  set('pb-description', '');

  _setBuilderLock(false);
  _renderBuilderAdjustments([]);
  _renderBuilderDims();
  _renderBuilderLibrary();

  const titleEl = document.getElementById('pb-composer-title');
  if (titleEl) titleEl.textContent = 'New Pack';

  const saveBtn = document.getElementById('pb-save-btn');
  if (saveBtn) { saveBtn.textContent = 'Save Pack'; saveBtn.disabled = false; }

  const delBtn = document.getElementById('pb-delete-btn');
  if (delBtn) delBtn.style.display = 'none';

  _deleteCancel();
}

// ── Toggle pack active ────────────────────────────────────────────────────────

async function togglePackActive(packId) {
  try {
    const data = await apiCall('PATCH', `/v1/proxy/packs/${packId}/toggle`);
    const state = data.active ? 'enabled' : 'disabled';
    showToast(`Pack '${packId}' ${state}`, data.active ? 'success' : 'warning');
    await loadPolicyStack();
  } catch (e) {
    showToast(`Toggle failed: ${e.message}`, 'error');
  }
}

// ── Save / Delete ─────────────────────────────────────────────────────────────

async function savePackBuilder() {
  const packId = _editingPackId || (document.getElementById('pb-pack-id')?.value.trim());
  if (!packId) { showToast('Pack ID is required', 'error'); return; }

  const dimIds = Object.keys(_builderDims);
  if (!dimIds.length) { showToast('Add at least one evaluator before saving', 'warning'); return; }

  // Client-side overlap guard — block save if any evaluator is already in another pack
  const alreadyTaken = _getDimsInOtherPacks();
  const overlapping  = dimIds.filter(id => alreadyTaken.has(id));
  if (overlapping.length) {
    showToast(
      `Cannot save — evaluator${overlapping.length > 1 ? 's' : ''} already in another pack: ${overlapping.join(', ')}. Remove them first.`,
      'error'
    );
    return;
  }

  const definition = {
    layer:               document.getElementById('pb-layer')?.value       || 'domain-addon',
    enforcement:         document.getElementById('pb-enforcement')?.value || 'flexible',
    mode:                document.getElementById('pb-mode')?.value        || 'collect-all',
    combining_algorithm: 'worst_case',   // default — not exposed in UI yet
    hitl_trigger:        false,           // default — surfaced once remediations are live
    version:             document.getElementById('pb-version')?.value.trim() || '1.0.0',
    owner:               document.getElementById('pb-owner')?.value.trim()   || 'unknown',
    description:         document.getElementById('pb-description')?.value.trim() || '',
    dimensions: dimIds.map(id => ({
      id,
      profile:  _builderDims[id].profile,
      severity: _builderDims[id].severity,
      abort:    _builderDims[id].abort,
      roles:    _builderDims[id].roles,
    })),
    context_adjustments: _builderContextAdjustments,
  };

  const saveBtn = document.getElementById('pb-save-btn');
  if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Saving…'; }

  try {
    if (_editingPackId) {
      await apiPut(`/v1/proxy/packs/${_editingPackId}`, { definition });
      showToast(`Pack '${packId}' updated — stack reloaded`, 'success');
    } else {
      await apiPost('/v1/proxy/packs', { id: packId, definition });
      showToast(`Pack '${packId}' created — stack reloaded`, 'success');
      resetPackBuilder();
    }
    await loadPolicyStack();
  } catch (e) {
    showToast(`Save failed: ${e.message}`, 'error');
    if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = _editingPackId ? 'Update Pack' : 'Save Pack'; }
  }
}

function _deleteStep1() {
  const confirmEl = document.getElementById('pb-delete-confirm');
  const deleteBtn = document.getElementById('pb-delete-btn');
  if (confirmEl) confirmEl.style.display = 'flex';
  if (deleteBtn) deleteBtn.style.display  = 'none';
}

function _deleteCancel() {
  const confirmEl = document.getElementById('pb-delete-confirm');
  const deleteBtn = document.getElementById('pb-delete-btn');
  if (confirmEl) confirmEl.style.display = 'none';
  // Only show delete btn if we're editing a non-mandatory pack
  if (deleteBtn && _editingPackId) {
    const pack = _builderPacksCache.find(p => p.id === _editingPackId);
    if (pack && pack.layer !== 'mandatory') deleteBtn.style.display = 'inline-block';
  }
}

async function deletePackBuilder() {
  const packId = _editingPackId;
  if (!packId) return;

  try {
    await apiDelete(`/v1/proxy/packs/${packId}`);
    showToast(`Pack '${packId}' deleted`, 'success');
    // Evict the deleted pack from the cache immediately so that
    // _getDimsInOtherPacks() no longer sees its evaluators as locked
    // when resetPackBuilder() re-renders the library below.
    // loadPolicyStack() will do a full server refresh afterwards.
    _builderPacksCache = _builderPacksCache.filter(p => p.id !== packId);
    resetPackBuilder();
    await loadPolicyStack();
  } catch (e) {
    showToast(`Delete failed: ${e.message}`, 'error');
    _deleteCancel();
  }
}

// ============================================================
// TIER 1 METRICS TAB
// ============================================================
async function _populateMetricsAppFilter() {
  try {
    const d = await apiGet('/v1/app-configs');
    const sel = document.getElementById('metrics-app');
    if (!sel) return;
    const current = sel.value;
    sel.innerHTML = '<option value="">All apps</option>';
    (d.configs || []).forEach(cfg => {
      const opt = document.createElement('option');
      opt.value = cfg.app_id;
      opt.textContent = cfg.app_id;
      if (cfg.app_id === current) opt.selected = true;
      sel.appendChild(opt);
    });
  } catch(_) {}
}

// Active tile state — source of truth for app filter (avoids browser select issues
// when the app is not yet in the onboarded app-configs list, e.g. pending apps)
let _activeTileApp = null;   // null = all apps; string = specific app_id

async function loadMetrics() {
  _populateMetricsAppFilter();
  _renderAppTiles();                          // Phoenix-style per-app tiles
  const windowVal = document.getElementById('metrics-window')?.value;

  // Use tile-driven state when set; fall back to dropdown for manual changes
  const appVal = _activeTileApp !== null
    ? _activeTileApp
    : (document.getElementById('metrics-app')?.value || '');

  const params = [];
  if (windowVal) params.push(`window_minutes=${windowVal}`);
  if (appVal)    params.push(`app_id=${encodeURIComponent(appVal)}`);
  const url = `/v1/metrics/tier1` + (params.length ? '?' + params.join('&') : '');
  document.getElementById('metrics-grid').innerHTML =
    '<div class="col-12 text-center text-muted py-4"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>';
  try {
    const data = await apiGet(url);
    _renderMetricsBreakdown(data);
    _renderMetricsGrid(data.metrics || {});
    const el = document.getElementById('metrics-computed-from');
    const appLabel = appVal ? ` · ${appVal}` : ' · all apps';
    if (el) el.textContent = `${data.computed_from} records analysed${appLabel}`;
  } catch (e) {
    document.getElementById('metrics-grid').innerHTML =
      `<div class="col-12 text-danger">${e.message}</div>`;
  }
}

async function _renderAppTiles() {
  const container = document.getElementById('metrics-app-tiles');
  if (!container) return;

  const windowVal = document.getElementById('metrics-window')?.value;
  // Active = null means "FinApp" aggregate tile is selected
  const activeApp = _activeTileApp;
  const params = windowVal ? `?window_minutes=${windowVal}` : '';

  try {
    const data = await apiGet(`/v1/metrics/apps-summary${params}`);
    const apps = data.apps || [];

    if (apps.length === 0) {
      container.innerHTML = '<div class="text-muted" style="font-size:0.8rem;padding:8px 0;">No evaluation data yet.</div>';
      return;
    }

    // Individual per-app tiles
    container.innerHTML = apps.map(a => {
      const total = a.total || 0;
      const p = a.permissive || 0;
      const n = a.normative  || 0;
      const c = a.coercive   || 0;
      const pw = total ? Math.round(p / total * 100) : 0;
      const nw = total ? Math.round(n / total * 100) : 0;
      const cw = total ? 100 - pw - nw : 0;
      const isActive = activeApp === a.app_id;
      return `
        <div class="app-tile${isActive ? ' active' : ''}" onclick="_tileClick('${a.app_id}')" title="Filter metrics to ${a.app_id}">
          <div class="app-tile-name"><i class="bi bi-cpu me-1"></i>${escHtml(a.app_id)}</div>
          <div class="app-tile-total">${total.toLocaleString()}</div>
          <div class="app-tile-bar">
            ${pw > 0 ? `<div style="width:${pw}%;background:#2ecc71;"></div>` : ''}
            ${nw > 0 ? `<div style="width:${nw}%;background:#f1c40f;"></div>` : ''}
            ${cw > 0 ? `<div style="width:${cw}%;background:#e74c3c;"></div>` : ''}
          </div>
          <div class="app-tile-verdicts">
            <span class="atv-p"><i class="bi bi-check-circle-fill me-1"></i>${p}</span>
            <span class="atv-n"><i class="bi bi-exclamation-circle-fill me-1"></i>${n}</span>
            <span class="atv-c"><i class="bi bi-x-circle-fill me-1"></i>${c}</span>
          </div>
        </div>`;
    }).join('');

    // FinApp aggregate tile (prepended) — cross-app composite, named for the platform
    const allTotal = apps.reduce((s, a) => s + a.total, 0);
    const allP     = apps.reduce((s, a) => s + a.permissive, 0);
    const allN     = apps.reduce((s, a) => s + a.normative, 0);
    const allC     = apps.reduce((s, a) => s + a.coercive, 0);
    const aPw = allTotal ? Math.round(allP / allTotal * 100) : 0;
    const aNw = allTotal ? Math.round(allN / allTotal * 100) : 0;
    const aCw = allTotal ? 100 - aPw - aNw : 0;
    const allActive = activeApp === null;   // null = platform aggregate selected
    const allTile = `
      <div class="app-tile${allActive ? ' active' : ''}" onclick="_tileClick(null)" title="Platform aggregate — all applications combined">
        <div class="app-tile-name"><i class="bi bi-layers me-1"></i>All Apps</div>
        <div class="app-tile-total">${allTotal.toLocaleString()}</div>
        <div class="app-tile-bar">
          ${aPw > 0 ? `<div style="width:${aPw}%;background:#2ecc71;"></div>` : ''}
          ${aNw > 0 ? `<div style="width:${aNw}%;background:#f1c40f;"></div>` : ''}
          ${aCw > 0 ? `<div style="width:${aCw}%;background:#e74c3c;"></div>` : ''}
        </div>
        <div class="app-tile-verdicts">
          <span class="atv-p"><i class="bi bi-check-circle-fill me-1"></i>${allP}</span>
          <span class="atv-n"><i class="bi bi-exclamation-circle-fill me-1"></i>${allN}</span>
          <span class="atv-c"><i class="bi bi-x-circle-fill me-1"></i>${allC}</span>
        </div>
      </div>`;
    container.innerHTML = allTile + container.innerHTML;

  } catch (_) {
    container.innerHTML = '';
  }
}

function _tileClick(appId) {
  // appId = null  → FinApp aggregate (no filter)
  // appId = string → specific app
  _activeTileApp = appId;

  // Keep dropdown in sync where possible (best-effort)
  const sel = document.getElementById('metrics-app');
  if (sel && appId !== null) {
    if (!Array.from(sel.options).some(o => o.value === appId)) {
      const opt = document.createElement('option');
      opt.value = appId;
      opt.textContent = appId;
      sel.appendChild(opt);
    }
    sel.value = appId;
  } else if (sel) {
    sel.value = '';
  }

  loadMetrics();
}

function _renderMetricsBreakdown(data) {
  const el = document.getElementById('metrics-breakdown');
  if (!el) return;
  const rb = data.role_breakdown || {};
  const items = [
    { label: 'User Prompts',   count: rb.user_prompt   || 0, color: '#1a3a5c', icon: 'bi-person-fill' },
    { label: 'LLM Responses',  count: rb.llm_response  || 0, color: '#1a3a20', icon: 'bi-robot' },
    { label: 'Agent→Agent',    count: rb.agent_to_agent|| 0, color: '#3a2a00', icon: 'bi-arrow-left-right' },
    { label: 'Tool Calls',     count: rb.tool_call     || 0, color: '#2a1a3a', icon: 'bi-tools' },
  ];
  el.innerHTML = items.map(i => `
    <div class="col-auto">
      <div class="card px-3 py-2" style="background:${i.color}; border-color:#2d3140;">
        <div style="font-size:0.7rem; color:#aaa;"><i class="bi ${i.icon} me-1"></i>${i.label}</div>
        <div class="fw-bold" style="font-size:1.1rem;">${i.count}</div>
      </div>
    </div>`).join('');
}

function _statusMeta(status) {
  switch (status) {
    case 'available':            return { color: '#0f5132', text: '#75b798', label: 'Available' };
    case 'no_data':              return { color: '#2a2000', text: '#ffc06a', label: 'No Data Yet' };
    case 'no_a2a_traffic':       return { color: '#1a3a5c', text: '#6ea8fe', label: 'A2A Pending' };
    case 'no_tool_traffic':      return { color: '#2a2000', text: '#ffc06a', label: 'No Tool Traffic' };
    case 'deferred_dim':         return { color: '#4a3200', text: '#ffc06a', label: 'Dim Deferred' };
    case 'requires_otel':        return { color: '#1a3a5c', text: '#6ea8fe', label: 'Needs Phoenix' };
    case 'requires_arize':       return { color: '#2a1a3a', text: '#bf8fff', label: 'Needs Integration' };
    case 'requires_integration': return { color: '#2a1a3a', text: '#bf8fff', label: 'Needs Integration' };
    default:                     return { color: '#1e2130', text: '#aaa',    label: status };
  }
}

function _metricValue(m) {
  // Latency metric — check first (ms, not 0-1)
  if (m.label && m.label.includes('Latency')) {
    if (m.avg === null || m.avg === undefined) return `<span class="text-muted" style="font-style:italic;">–</span>`;
    const latAvg = Math.round(m.avg);
    const col = latAvg < 200 ? '#2ecc71' : latAvg < 800 ? '#f39c12' : '#e74c3c';
    return `<div class="mb-1">
        <span style="font-size:1.4rem; font-weight:700; color:${col};">${latAvg}</span>
        <span class="text-muted ms-1" style="font-size:0.8rem;">ms avg</span>
      </div>
      <small class="text-muted">p95: ${m.p95 ?? '–'}ms · ${m.sample} samples</small>`;
  }
  // Integer count metric (e.g. token usage — raw count, not 0-1 scale)
  if (m.type === 'integer' && m.avg !== undefined && m.avg !== null) {
    return `<div class="mb-1">
        <span style="font-size:1.4rem; font-weight:700; color:#c8d8f0;">${Math.round(m.avg).toLocaleString()}</span>
        <span class="text-muted ms-1" style="font-size:0.8rem;">avg / request</span>
      </div>
      <small class="text-muted">${m.sample} session${m.sample !== 1 ? 's' : ''}</small>`;
  }
  // Float metric (has avg, 0-1 scale)
  if (m.avg !== undefined && m.avg !== null) {
    const pct = Math.round(m.avg * 100);
    const barColor = m.scale && m.scale.includes('0.0=toxic')
      ? (pct > 50 ? '#e74c3c' : '#f39c12')
      : (pct > 70 ? '#2ecc71' : pct > 40 ? '#f39c12' : '#e74c3c');
    return `
      <div class="d-flex align-items-center gap-2 mb-1">
        <span style="font-size:1.4rem; font-weight:700; color:#e0e0e0;">${m.avg.toFixed(2)}</span>
        <span class="text-muted" style="font-size:0.72rem;">${m.scale || '0–1'}</span>
      </div>
      <div style="height:4px; background:#2d3140; border-radius:2px; margin-bottom:4px;">
        <div style="height:4px; background:${barColor}; width:${Math.min(pct, 100)}%; border-radius:2px; transition:width 0.5s;"></div>
      </div>
      <small class="text-muted">${m.sample} sample${m.sample !== 1 ? 's' : ''}</small>`;
  }
  // Flag metric (has flagged + total)
  if (m.flagged !== undefined) {
    const rate = m.flag_rate_pct ?? 0;
    const col = rate > 5 ? '#e74c3c' : rate > 0 ? '#f39c12' : '#2ecc71';
    return `
      <div class="d-flex align-items-center gap-2 mb-1">
        <span style="font-size:1.4rem; font-weight:700; color:${col};">${m.flagged}</span>
        <span class="text-muted" style="font-size:0.75rem;">/ ${m.total} (${rate}%)</span>
      </div>
      <div style="height:4px; background:#2d3140; border-radius:2px; margin-bottom:4px;">
        <div style="height:4px; background:${col}; width:${Math.min(rate*5, 100)}%; border-radius:2px;"></div>
      </div>`;
  }
  // Agent step success
  if (m.total_steps !== undefined) {
    const rate = m.success_rate_pct ?? 0;
    const col = rate > 90 ? '#2ecc71' : rate > 70 ? '#f39c12' : '#e74c3c';
    return `
      <div class="mb-1">
        <span style="font-size:1.4rem; font-weight:700; color:${col};">${rate ?? '–'}%</span>
        <span class="text-muted ms-1" style="font-size:0.72rem;">success</span>
      </div>
      <small class="text-muted">${m.total_steps} steps · ${m.blocked_steps} blocked</small>`;
  }
  // Token usage / unavailable
  return `<span class="text-muted" style="font-size:0.85rem; font-style:italic;">–</span>`;
}

function _renderMetricsGrid(metrics) {
  const el = document.getElementById('metrics-grid');
  if (!el || !Object.keys(metrics).length) {
    el.innerHTML = '<div class="col-12 text-muted text-center py-4">No metrics data available.</div>';
    return;
  }
  el.innerHTML = Object.entries(metrics).map(([key, m]) => {
    const st = _statusMeta(m.status);
    return `
      <div class="col-md-6 col-xl-4">
        <div class="card h-100" style="border-color:#2d3140;">
          <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div style="font-size:0.82rem; font-weight:600; color:#c0c8d8;">${m.label}</div>
              <span class="badge" style="background:${st.color}; color:${st.text}; font-size:0.65rem; white-space:nowrap;">
                ${st.label}
              </span>
            </div>
            <div class="my-2">${_metricValue(m)}</div>
            <div class="text-muted mt-2" style="font-size:0.7rem; border-top:1px solid #2d3140; padding-top:6px;">
              <i class="bi bi-info-circle me-1"></i>${m.note}
            </div>
          </div>
        </div>
      </div>`;
  }).join('');
}

function ltConnect() {
  if (_ltEs) ltDisconnect();

  const verdict = document.getElementById('lt-verdict-filter').value;
  const url     = '/v1/audit/stream' + (verdict ? `?verdict=${verdict}` : '');

  _ltEs = new EventSource(url);
  _ltPaused = false;
  _ltQueue  = [];

  _ltEs.onopen = () => {
    document.getElementById('lt-btn-connect').classList.add('d-none');
    document.getElementById('lt-btn-pause').classList.remove('d-none');
    document.getElementById('lt-btn-disconnect').classList.remove('d-none');
    document.getElementById('lt-live-badge').classList.remove('d-none');
    document.getElementById('lt-paused-badge').classList.add('d-none');
    document.getElementById('livetail-badge').classList.remove('d-none');
    document.getElementById('lt-status-msg').textContent = 'Connected — streaming';

    const term = document.getElementById('lt-terminal');
    const div  = document.createElement('span');
    div.style.color = '#238636';
    div.textContent = `── Connected at ${new Date().toISOString().substring(0,19).replace('T',' ')} (UTC) ──\n`;
    term.appendChild(div);
    if (_ltAutoScroll) term.scrollTop = term.scrollHeight;
  };

  _ltEs.onmessage = e => {
    try {
      const rec = JSON.parse(e.data);
      if (_ltPaused) {
        _ltQueue.push(rec);
      } else {
        _ltAppendLine(rec);
      }
    } catch (_) {}
  };

  _ltEs.onerror = () => {
    document.getElementById('lt-status-msg').textContent = 'Connection lost — reconnecting…';
    document.getElementById('lt-live-badge').classList.add('d-none');
  };
}

function ltDisconnect() {
  if (_ltEs) { _ltEs.close(); _ltEs = null; }
  _ltQueue  = [];
  _ltPaused = false;
  document.getElementById('lt-btn-connect').classList.remove('d-none');
  document.getElementById('lt-btn-pause').classList.add('d-none');
  document.getElementById('lt-btn-disconnect').classList.add('d-none');
  document.getElementById('lt-live-badge').classList.add('d-none');
  document.getElementById('lt-paused-badge').classList.add('d-none');
  document.getElementById('livetail-badge').classList.add('d-none');
  document.getElementById('lt-status-msg').textContent = 'Disconnected';

  const term = document.getElementById('lt-terminal');
  const span = document.createElement('span');
  span.style.color = '#8b949e';
  span.textContent = `── Disconnected at ${new Date().toISOString().substring(0,19).replace('T',' ')} (UTC) ──\n`;
  term.appendChild(span);
  if (_ltAutoScroll) term.scrollTop = term.scrollHeight;
}

function ltTogglePause() {
  const btn = document.getElementById('lt-btn-pause');
  if (_ltPaused) {
    // Resume — flush queued records
    _ltPaused = false;
    _ltQueue.forEach(_ltAppendLine);
    _ltQueue = [];
    btn.innerHTML = '<i class="bi bi-pause-fill me-1"></i>Pause';
    btn.className = 'btn btn-sm btn-warning';
    document.getElementById('lt-live-badge').classList.remove('d-none');
    document.getElementById('lt-paused-badge').classList.add('d-none');
    document.getElementById('lt-status-msg').textContent = 'Connected — streaming';
  } else {
    _ltPaused = true;
    btn.innerHTML = '<i class="bi bi-play-fill me-1"></i>Resume';
    btn.className = 'btn btn-sm btn-success';
    document.getElementById('lt-live-badge').classList.add('d-none');
    document.getElementById('lt-paused-badge').classList.remove('d-none');
    document.getElementById('lt-status-msg').textContent = 'Paused — buffering…';
  }
}

function ltClear() {
  const term = document.getElementById('lt-terminal');
  term.innerHTML = '<span style="color:#8b949e">── cleared ──\n</span>';
  _ltCounts = { total: 0, PERMISSIVE: 0, NORMATIVE: 0, COERCIVE: 0 };
  document.getElementById('lt-count-total').textContent = '0';
  document.getElementById('lt-count-p').textContent     = '0';
  document.getElementById('lt-count-n').textContent     = '0';
  document.getElementById('lt-count-c').textContent     = '0';
}

// Auto-scroll: if user scrolled up, stop chasing; resume when back at bottom
document.addEventListener('DOMContentLoaded', () => {
  const term = document.getElementById('lt-terminal');
  term.addEventListener('scroll', () => {
    _ltAutoScroll = term.scrollHeight - term.scrollTop - term.clientHeight < 40;
  });
});

// Disconnect SSE when user navigates away from Live Tail tab
document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
  tab.addEventListener('hide.bs.tab', e => {
    if (e.target.getAttribute('href') === '#tab-livetail' && _ltEs) ltDisconnect();
  });
});

// ============================================================
// APP STACKS TAB
// ============================================================

let _asSelectedApp   = null;   // currently-selected app_id
let _asPacksCache    = [];     // full pack list (from /v1/proxy/packs)
let _asStacksCache   = {};     // all app stacks from API  { app_id → {assignments} }
let _asAppConfigIds  = [];     // app IDs known from App Config
let _asPendingApps   = new Set(); // app_ids seen in audit log but not in stacks
let _asPropContext   = null;   // { app_id, pack_id } for propagation dialog

// ── Loaders ───────────────────────────────────────────────────────────────────

async function loadAppStacks() {
  try {
    // Fetch packs, stacks, app-configs, and recent audit records in parallel
    const [packsData, stacksData, appConfigData, auditData] = await Promise.all([
      apiGet('/v1/proxy/packs'),
      apiGet('/v1/proxy/app-stacks'),
      apiGet('/v1/app-configs').catch(() => ({ app_configs: [] })),
      apiGet('/v1/audit/evaluations?limit=200').catch(() => ({ records: [] })),
    ]);

    _asPacksCache  = (packsData.packs || []).filter(p => p.layer !== 'mandatory');
    _asStacksCache = stacksData.app_stacks || {};

    // Merge app IDs from stacks + app-configs into deduplicated onboarded list
    const configIds = (appConfigData.app_configs || []).map(a => a.app_id);
    const stackIds  = Object.keys(_asStacksCache);
    const onboarded = [...new Set([...stackIds, ...configIds])].sort();
    _asAppConfigIds = onboarded;

    // Detect apps active in audit log but not yet onboarded
    const auditAppIds = (auditData.records || [])
      .map(r => r.app_id).filter(Boolean);
    _asPendingApps = new Set(
      auditAppIds.filter(id => !_asStacksCache[id] && !configIds.includes(id))
    );

    _renderAsAppList(onboarded);
    if (_asSelectedApp) {
      _renderAsStack(_asSelectedApp);
    }
  } catch (e) {
    document.getElementById('as-app-list').innerHTML =
      `<div style="padding:12px;color:#e74c3c;font-size:0.78rem;">Failed: ${escHtml(e.message)}</div>`;
  }
}

// ── Render app list ───────────────────────────────────────────────────────────

function _renderAsAppList(onboardedIds) {
  const el = document.getElementById('as-app-list');
  const pendingIds = [..._asPendingApps].sort();
  const allEmpty   = !onboardedIds.length && !pendingIds.length;

  if (allEmpty) {
    el.innerHTML = '<div style="padding:16px 12px;color:#8899aa;font-size:0.8rem;">No apps yet.<br><small>Send a request from an app or use Onboard New App.</small></div>';
    return;
  }

  let html = '';

  // Pending apps (detected from audit, not yet registered)
  if (pendingIds.length) {
    html += `<div style="padding:6px 12px 4px;font-size:0.62rem;color:#e67e22;text-transform:uppercase;letter-spacing:0.06em;border-bottom:1px solid #2d2010;">
      <i class="bi bi-exclamation-triangle me-1"></i>Pending Registration
    </div>`;
    html += pendingIds.map(id => {
      const isSelected = id === _asSelectedApp;
      return `
        <div onclick="_asSelectApp('${escHtml(id)}')"
          style="padding:9px 12px;cursor:pointer;border-bottom:1px solid #1a1510;
                 ${isSelected ? 'background:#1a1000;border-left:3px solid #e67e22;' : 'border-left:3px solid transparent;'}">
          <div style="font-size:0.82rem;color:${isSelected ? '#e67e22' : '#aa8866'};font-family:monospace;">${escHtml(id)}</div>
          <div style="font-size:0.68rem;color:#665544;margin-top:2px;">
            <i class="bi bi-activity me-1"></i>active · not registered
          </div>
        </div>`;
    }).join('');
  }

  // Registered apps
  if (onboardedIds.length) {
    html += `<div style="padding:6px 12px 4px;font-size:0.62rem;color:#6699aa;text-transform:uppercase;letter-spacing:0.06em;border-bottom:1px solid #1a2030;">
      <i class="bi bi-check2-circle me-1"></i>Registered
    </div>`;
    html += onboardedIds.map(id => {
      const isSelected  = id === _asSelectedApp;
      const hasStack    = !!_asStacksCache[id];
      const assignCount = hasStack ? Object.keys(_asStacksCache[id].assignments || {}).length : 0;
      return `
        <div onclick="_asSelectApp('${escHtml(id)}')"
          style="padding:9px 12px;cursor:pointer;border-bottom:1px solid #1a1d2b;
                 ${isSelected ? 'background:#0d1a2a;border-left:3px solid #3498db;' : 'border-left:3px solid transparent;'}">
          <div style="font-size:0.82rem;color:${isSelected ? '#3498db' : '#c0d0e0'};font-family:monospace;">${escHtml(id)}</div>
          <div style="font-size:0.68rem;color:#6688aa;margin-top:2px;">
            <i class="bi bi-check-circle me-1" style="color:#2ecc7188;"></i>${assignCount} pack${assignCount !== 1 ? 's' : ''} assigned
          </div>
        </div>`;
    }).join('');
  }

  el.innerHTML = html;
}

// ── Select app ────────────────────────────────────────────────────────────────

function _asSelectApp(appId) {
  _asSelectedApp = appId;
  _renderAsAppList(_asAppConfigIds);
  _renderAsStack(appId);
}

function _asShowNewAppInput() {
  const bar = document.getElementById('as-new-app-bar');
  bar.style.display = bar.style.display === 'none' ? 'flex' : 'none';
  if (bar.style.display !== 'none') {
    setTimeout(() => document.getElementById('as-new-app-id')?.focus(), 50);
  }
}

function _asStartOnboarding(appId) {
  if (!appId) { showToast('Enter an App ID first', 'warning'); return; }
  document.getElementById('as-new-app-bar').style.display = 'none';
  // Add to local list so the app appears in the sidebar immediately,
  // even before the first pack is assigned (which creates the YAML entry).
  if (!_asAppConfigIds.includes(appId)) {
    _asAppConfigIds = [..._asAppConfigIds, appId].sort();
  }
  _asSelectedApp = appId;
  _renderAsAppList(_asAppConfigIds);
  _renderAsStack(appId);
}

// ── Render stack panel for selected app ───────────────────────────────────────

function _renderAsStack(appId) {
  const panel  = document.getElementById('as-stack-panel');
  const stack  = _asStacksCache[appId];
  const assignments = stack ? (stack.assignments || {}) : {};

  const isRegistered = !!stack;
  const assignedIds  = new Set(Object.keys(assignments));
  const available    = _asPacksCache.filter(p => !assignedIds.has(p.id));

  // Pack library: group unassigned packs by tier
  // platform-addon (e.g. session_guard) shows as Tier 1 alongside mandatory
  const libTier1 = available.filter(p => p.layer === 'platform-addon');
  const libTier2 = available.filter(p => p.layer && p.layer.startsWith('domain'));
  const libTier3 = available.filter(p => p.layer === 'regulatory' || p.layer === 'regional');
  const libTier4 = available.filter(p => p.layer === 'advisory' || p.layer === 'exception');
  const noLibPacks = !libTier1.length && !libTier2.length && !libTier3.length && !libTier4.length;

  const _libTierSection = (tierLabel, tierColor, packs) => {
    if (!packs.length) return '';
    return `
      <div style="margin-bottom:10px;">
        <div style="font-size:0.62rem;color:${tierColor};text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;padding-bottom:3px;border-bottom:1px solid #2a3050;">
          ${tierLabel}
        </div>
        ${packs.map(p => {
          const dc = (p.dimensions || []).length;
          return `
            <div style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:#0d0f18;border:1px solid #2a3050;border-radius:4px;margin-bottom:5px;">
              <div style="flex:1;min-width:0;">
                <span style="font-size:0.78rem;color:#8899bb;font-family:monospace;">${escHtml(p.id)}</span>
                <span style="font-size:0.65rem;color:#446;margin-left:6px;">${dc} dim${dc !== 1 ? 's' : ''}</span>
              </div>
              <button onclick="_asAssignPack('${escHtml(appId)}','${escHtml(p.id)}')"
                style="font-size:0.7rem;background:#1a2a3a;color:#3498db;border:1px solid #3498db44;border-radius:3px;padding:2px 10px;cursor:pointer;flex-shrink:0;">
                + Assign
              </button>
            </div>`;
        }).join('')}
      </div>`;
  };

  // Badge: green "Registered" when stack entry exists, amber "Configuring" when new
  const badge = isRegistered
    ? `<span style="font-size:0.7rem;color:#2ecc7188;background:#2ecc7110;border:1px solid #2ecc7130;border-radius:3px;padding:1px 8px;margin-left:10px;">
         <i class="bi bi-check2-circle me-1"></i>Registered
       </span>`
    : `<span style="font-size:0.7rem;color:#e67e22;background:#3a200010;border:1px solid #e67e2233;border-radius:3px;padding:1px 8px;margin-left:10px;">
         <i class="bi bi-tools me-1"></i>Configuring — assign packs from the library
       </span>`;

  // Sort assigned packs: Tier 1 (platform-addon) first, then Tier 2, then rest
  const _tierOrder = layer => ({ 'platform-addon':0, 'domain-addon':1, regulatory:2, regional:2, advisory:3, exception:3 }[layer] ?? 9);
  const sortedAssignments = Object.entries(assignments).sort(([aId], [bId]) => {
    const aLayer = (_asPacksCache.find(p => p.id === aId) || {}).layer || '';
    const bLayer = (_asPacksCache.find(p => p.id === bId) || {}).layer || '';
    return _tierOrder(aLayer) - _tierOrder(bLayer);
  });

  let html = `
    <div style="padding:10px 16px;border-bottom:1px solid #2d3140;display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:center;flex-wrap:wrap;gap:4px;">
        <span style="font-size:0.88rem;color:#c0d0e0;font-family:monospace;font-weight:600;">${escHtml(appId)}</span>
        ${badge}
      </div>
      <span style="font-size:0.7rem;color:#5566aa;white-space:nowrap;">${assignedIds.size} pack${assignedIds.size !== 1 ? 's' : ''} assigned</span>
    </div>

    <div style="display:flex;gap:0;min-height:300px;">

      <!-- LEFT: Pack Library — always visible, fixed width -->
      <div style="width:230px;flex-shrink:0;padding:14px 14px;background:#0a0c14;border-right:1px solid #1e2235;overflow-y:auto;">
        <div style="font-size:0.6rem;color:#3498db99;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:10px;">
          <i class="bi bi-collection me-1"></i>Pack Library
        </div>
        ${noLibPacks
          ? `<div style="color:#334;font-size:0.75rem;font-style:italic;padding:4px 0;">All available packs are assigned.</div>`
          : _libTierSection('Tier 1 — Platform', '#2ecc71', libTier1)
            + _libTierSection('Tier 2 — Domain', '#3498db', libTier2)
            + _libTierSection('Tier 3 — Regulatory', '#9b59b6', libTier3)
            + _libTierSection('Tier 4 — Advisory', '#7f8c8d', libTier4)
        }
      </div>

      <!-- RIGHT: App Policy Stack — mandatory locked + assigned packs with toggles -->
      <div style="flex:1;padding:14px 16px;min-width:0;overflow-y:auto;">

        <!-- Tier 1 system — always on, not toggleable -->
        <div style="font-size:0.6rem;color:#2ecc7166;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:6px;">
          <i class="bi bi-shield-fill me-1"></i>Tier 1 — System
        </div>
        <div style="background:#091208;border:1px solid #2ecc7118;border-radius:4px;padding:7px 12px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
          <span style="font-size:0.78rem;color:#2ecc71;font-family:monospace;">mandatory</span>
          <span style="font-size:0.62rem;color:#2ecc7170;background:#2ecc7110;border:1px solid #2ecc7125;border-radius:3px;padding:1px 6px;">🔒 always on</span>
        </div>

        <!-- Assigned packs with toggles, sorted by tier -->
        <div style="font-size:0.6rem;color:#6688aa;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:6px;">
          <i class="bi bi-layers me-1"></i>App Policy Stack
        </div>
        <div>
          ${sortedAssignments.length === 0
            ? `<div style="color:#3a4060;font-size:0.78rem;padding:10px 0;font-style:italic;">No packs assigned — select from the Pack Library.</div>`
            : sortedAssignments.map(([packId, asgn]) => _renderAsAssignedPack(appId, packId, asgn)).join('')
          }
        </div>
      </div>

    </div>`;

  html += '<div style="height:8px;"></div>';
  panel.innerHTML = html;
}

function _asTierLabel(layer) {
  const m = { mandatory:'Tier 1', 'platform-addon':'Tier 1', 'domain-addon':'Tier 2', regulatory:'Tier 3', regional:'Tier 3', exception:'Tier 4', advisory:'Tier 4' };
  return m[layer] || layer;
}

// ── Render one assigned pack row (with expand for overrides) ──────────────────

function _renderAsAssignedPack(appId, packId, asgn) {
  const pack             = _asPacksCache.find(p => p.id === packId);
  const dimCount         = pack ? (pack.dimensions || []).length : 0;
  const overrides        = asgn.overrides || [];
  const isActive         = asgn.active !== false;           // stored app-level intent
  const packGlobalActive = !pack || pack.active !== false;  // global kill-switch (Policy Packs tab)
  const effectivelyOn    = isActive && packGlobalActive;    // what actually runs
  const ovCount          = overrides.length;
  const rowId            = `as-row-${appId}-${packId}`.replace(/[^a-z0-9-]/g, '_');
  const expandId         = `as-expand-${appId}-${packId}`.replace(/[^a-z0-9-]/g, '_');

  let overrideSummary = '';
  if (ovCount > 0) {
    overrideSummary = `<span style="font-size:0.67rem;color:#f39c12;background:#f39c1215;border:1px solid #f39c1230;border-radius:3px;padding:1px 6px;margin-left:6px;">${ovCount} override${ovCount > 1 ? 's' : ''}</span>`;
  }

  // Row colours reflect effective state
  const activeBg     = effectivelyOn ? '#0a1f12' : '#0d0f18';
  const activeBorder = effectivelyOn ? '#2ecc7130' : '#2d3140';
  const nameColor    = effectivelyOn ? '#ccc' : '#555';
  // Dim entire row when globally disabled so hierarchy is obvious
  const rowOpacity   = packGlobalActive ? '1' : '0.55';

  // Toggle — locked/non-interactive when globally disabled; normal when global is ON
  const toggleHtml = packGlobalActive
    ? `<label class="as-toggle" onclick="_asTogglePack('${escHtml(appId)}','${escHtml(packId)}'); return false;"
         title="${isActive ? 'Click to disable for this app' : 'Click to enable for this app'}">
         <input type="checkbox" ${isActive ? 'checked' : ''} onclick="return false;">
         <div class="as-toggle-track"><div class="as-toggle-thumb"></div></div>
       </label>`
    : `<label class="as-toggle" style="cursor:not-allowed;opacity:0.45;"
         title="Pack is globally disabled in Policy Packs — re-enable it there to restore app-level control.">
         <input type="checkbox" onclick="return false;">
         <div class="as-toggle-track"><div class="as-toggle-thumb"></div></div>
       </label>`;

  // Lock badge replaces the old amber warning — only shown when globally off
  const globalOffBadge = packGlobalActive ? '' :
    `<span style="font-size:0.63rem;color:#666;background:#18181f;border:1px solid #2d3140;border-radius:3px;padding:1px 7px;margin-left:4px;"
       title="Global kill-switch is OFF in Policy Packs. The stored app intent (${isActive ? 'enabled' : 'disabled'}) will be restored automatically when the pack is re-enabled globally.">
       🔒 Globally disabled</span>`;

  return `
    <div id="${rowId}" style="margin:0 0 6px;background:${activeBg};border:1px solid ${activeBorder};border-radius:4px;opacity:${rowOpacity};transition:opacity 0.2s;">
      <div style="padding:9px 12px;display:flex;align-items:center;gap:8px;">
        ${toggleHtml}
        <!-- Pack name + meta -->
        <div style="flex:1;min-width:0;">
          <span style="font-size:0.8rem;color:${nameColor};font-family:monospace;">${escHtml(packId)}</span>
          <span style="font-size:0.68rem;color:#555;margin-left:6px;">${pack ? _asTierLabel(pack.layer) : ''} · ${dimCount} dim${dimCount !== 1 ? 's' : ''}</span>
          ${overrideSummary}${globalOffBadge}
        </div>
        <!-- Tune / Remove -->
        <button onclick="_asToggleExpand('${expandId}')"
          style="font-size:0.7rem;background:#1a2a3a;color:#3498db;border:1px solid #3498db44;border-radius:3px;padding:1px 10px;cursor:pointer;flex-shrink:0;"
          title="Tune per-dimension threshold profiles for this app">
          <i class="bi bi-sliders2 me-1"></i>Tune
        </button>
        <button onclick="_asRemovePack('${escHtml(appId)}','${escHtml(packId)}')"
          style="font-size:0.7rem;background:#2a1010;color:#e74c3c;border:1px solid #e74c3c33;border-radius:3px;padding:1px 8px;cursor:pointer;flex-shrink:0;"
          title="Remove from this app">✕</button>
      </div>

      <!-- Override editor (hidden by default) -->
      <div id="${expandId}" style="display:none;border-top:1px solid #2d3140;padding:10px 12px;">
        ${_renderAsOverrideEditor(appId, packId, pack, overrides)}
      </div>
    </div>`;
}

function _asToggleExpand(expandId) {
  const el = document.getElementById(expandId);
  if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

// ── Override editor ───────────────────────────────────────────────────────────

function _renderAsOverrideEditor(appId, packId, pack, overrides) {
  if (!pack) return '<div style="color:#555;font-size:0.78rem;">Pack definition not available.</div>';

  const dims = pack.dimensions || [];
  if (!dims.length) return '<div style="color:#555;font-size:0.78rem;">No dimensions to override.</div>';

  const ovMap = {};
  for (const ov of overrides) ovMap[ov.dimension_id] = ov;

  const profileOptions = ['standard','strict','zero_tolerance']
    .map(p => `<option value="${p}">${p}</option>`).join('');

  let rows = dims.map(dim => {
    const ov = ovMap[dim.id] || {};
    const hasOv = !!ov.dimension_id;
    return `
      <tr style="font-size:0.75rem;border-bottom:1px solid #1a1d2b;">
        <td style="padding:5px 8px;color:${hasOv ? '#f39c12' : '#aaa'};font-family:monospace;">${escHtml(dim.id)}</td>
        <td style="padding:5px 8px;color:#555;">${escHtml(dim.profile)}</td>
        <td style="padding:5px 4px;">
          <select id="as-ov-profile-${escHtml(appId)}-${escHtml(packId)}-${escHtml(dim.id)}"
            style="font-size:0.72rem;background:#0a0c12;color:${hasOv ? '#f39c12' : '#666'};border:1px solid ${hasOv ? '#f39c1244':'#2d3140'};border-radius:3px;padding:1px 4px;width:100%;">
            <option value="">— inherit —</option>
            ${['standard','strict','zero_tolerance'].map(p =>
              `<option value="${p}" ${ov.profile === p ? 'selected' : ''}>${p}</option>`
            ).join('')}
          </select>
        </td>
        <td style="padding:5px 4px;color:#555;">${dim.severity}</td>
        <td style="padding:5px 4px;">
          <select id="as-ov-sev-${escHtml(appId)}-${escHtml(packId)}-${escHtml(dim.id)}"
            style="font-size:0.72rem;background:#0a0c12;color:${hasOv && ov.severity ? '#f39c12' : '#666'};border:1px solid ${hasOv && ov.severity ? '#f39c1244':'#2d3140'};border-radius:3px;padding:1px 4px;width:100%;">
            <option value="">— inherit —</option>
            ${[1,2,3].map(s =>
              `<option value="${s}" ${ov.severity === s ? 'selected' : ''}>${s === 1 ? '1 — Low' : s === 2 ? '2 — Med' : '3 — High'}</option>`
            ).join('')}
          </select>
        </td>
      </tr>`;
  }).join('');

  // Threshold profile band legend (1-9 scale)
  const bandLegend = `
    <div style="margin-bottom:10px;padding:8px 10px;background:#0a0c12;border:1px solid #2d3140;border-radius:4px;">
      <div style="font-size:0.62rem;color:#555;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">
        Threshold Profile Reference — score 1–9
      </div>
      ${[
        { name:'standard',      perm:'1–3',  norm:'4–6',  coer:'7–9' },
        { name:'strict',        perm:'1–2',  norm:'3–5',  coer:'6–9' },
        { name:'zero_tolerance',perm:'1',    norm:'2–3',  coer:'4–9' },
      ].map(p => `
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
          <span style="font-size:0.68rem;color:#888;width:90px;flex-shrink:0;">${p.name}</span>
          <div style="flex:1;display:flex;height:10px;border-radius:3px;overflow:hidden;gap:1px;">
            <div style="background:#27ae6088;flex:${p.name==='zero_tolerance'?1:(p.name==='strict'?2:3)};" title="PERMISSIVE ${p.perm}"></div>
            <div style="background:#f39c1288;flex:${p.name==='zero_tolerance'?2:(p.name==='strict'?3:3)};" title="NORMATIVE ${p.norm}"></div>
            <div style="background:#e74c3c88;flex:${p.name==='zero_tolerance'?6:(p.name==='strict'?4:3)};" title="COERCIVE ${p.coer}"></div>
          </div>
          <span style="font-size:0.6rem;color:#555;white-space:nowrap;">
            <span style="color:#27ae60">P${p.perm}</span>
            <span style="color:#f39c12;margin:0 3px;">N${p.norm}</span>
            <span style="color:#e74c3c">C${p.coer}</span>
          </span>
        </div>`).join('')}
    </div>`;

  return `
    ${bandLegend}
    <table style="width:100%;border-collapse:collapse;">
      <thead>
        <tr style="font-size:0.65rem;color:#444;text-transform:uppercase;letter-spacing:0.05em;">
          <th style="padding:4px 8px;text-align:left;">Dimension</th>
          <th style="padding:4px 8px;text-align:left;">Global Profile</th>
          <th style="padding:4px 4px;text-align:left;">App Profile Override</th>
          <th style="padding:4px 8px;text-align:left;">Global Sev</th>
          <th style="padding:4px 4px;text-align:left;">App Sev Override</th>
        </tr>
      </thead>
      <tbody>${rows}</tbody>
    </table>
    <div style="display:flex;gap:8px;margin-top:10px;justify-content:flex-end;">
      <button onclick="_asOpenPropagateDialog('${escHtml(appId)}','${escHtml(packId)}')"
        style="font-size:0.72rem;background:#1a2030;color:#3498db;border:1px solid #3498db44;border-radius:3px;padding:3px 10px;cursor:pointer;">
        <i class="bi bi-share me-1"></i>Propagate…
      </button>
      <button onclick="_asClearOverrides('${escHtml(appId)}','${escHtml(packId)}')"
        style="font-size:0.72rem;background:#1a1010;color:#e74c3c;border:1px solid #e74c3c33;border-radius:3px;padding:3px 10px;cursor:pointer;">
        Reset to Global
      </button>
      <button onclick="_asSaveOverrides('${escHtml(appId)}','${escHtml(packId)}')"
        style="font-size:0.72rem;background:#1a3a2a;color:#2ecc71;border:1px solid #2ecc7144;border-radius:3px;padding:3px 12px;cursor:pointer;">
        <i class="bi bi-cloud-upload me-1"></i>Save Overrides
      </button>
    </div>`;
}

// ── Actions ───────────────────────────────────────────────────────────────────

async function _asAssignPack(appId, packId) {
  try {
    await apiCall('POST', `/v1/proxy/app-stacks/${encodeURIComponent(appId)}/packs/${encodeURIComponent(packId)}`, { active: true });
    showToast(`Pack '${packId}' assigned to '${appId}'`, 'success');
    await loadAppStacks();
    _asSelectApp(appId);
  } catch (e) { showToast(`Assign failed: ${e.message}`, 'error'); }
}

async function _asRemovePack(appId, packId) {
  try {
    await apiDelete(`/v1/proxy/app-stacks/${encodeURIComponent(appId)}/packs/${encodeURIComponent(packId)}`);
    showToast(`Pack '${packId}' removed from '${appId}'`, 'warning');
    await loadAppStacks();
    _asSelectApp(appId);
  } catch (e) { showToast(`Remove failed: ${e.message}`, 'error'); }
}

async function _asTogglePack(appId, packId) {
  try {
    const data = await apiCall('PATCH', `/v1/proxy/app-stacks/${encodeURIComponent(appId)}/packs/${encodeURIComponent(packId)}/toggle`);
    showToast(`Pack '${packId}' ${data.active ? 'enabled' : 'disabled'} for '${appId}'`, data.active ? 'success' : 'warning');
    await loadAppStacks();
    _asSelectApp(appId);
  } catch (e) { showToast(`Toggle failed: ${e.message}`, 'error'); }
}

async function _asSaveOverrides(appId, packId) {
  const pack = _asPacksCache.find(p => p.id === packId);
  if (!pack) return;

  const overrides = [];
  for (const dim of (pack.dimensions || [])) {
    const profileEl = document.getElementById(`as-ov-profile-${appId}-${packId}-${dim.id}`);
    const sevEl     = document.getElementById(`as-ov-sev-${appId}-${packId}-${dim.id}`);
    const profile   = profileEl?.value || '';
    const severity  = sevEl?.value ? parseInt(sevEl.value) : null;
    if (profile || severity !== null) {
      const entry = { dimension: dim.id };
      if (profile)           entry.profile  = profile;
      if (severity !== null) entry.severity = severity;
      overrides.push(entry);
    }
  }

  try {
    await apiPut(
      `/v1/proxy/app-stacks/${encodeURIComponent(appId)}/packs/${encodeURIComponent(packId)}/overrides`,
      { overrides }
    );
    showToast(`Overrides saved for '${packId}' in '${appId}'`, 'success');
    await loadAppStacks();
    _asSelectApp(appId);
  } catch (e) { showToast(`Save failed: ${e.message}`, 'error'); }
}

async function _asClearOverrides(appId, packId) {
  try {
    await apiDelete(`/v1/proxy/app-stacks/${encodeURIComponent(appId)}/packs/${encodeURIComponent(packId)}/overrides`);
    showToast(`Overrides cleared for '${packId}' in '${appId}'`, 'warning');
    await loadAppStacks();
    _asSelectApp(appId);
  } catch (e) { showToast(`Clear failed: ${e.message}`, 'error'); }
}

// ── Propagation dialog ────────────────────────────────────────────────────────

function _asOpenPropagateDialog(appId, packId) {
  _asPropContext = { appId, packId };
  const descEl = document.getElementById('as-prop-desc');
  if (descEl) descEl.textContent =
    `Copy '${appId}' overrides for pack '${packId}' to:`;

  const otherApps = _asAppConfigIds.filter(id => id !== appId);
  const listEl = document.getElementById('as-prop-app-list');
  if (listEl) {
    if (!otherApps.length) {
      listEl.innerHTML = '<div style="font-size:0.8rem;color:#555;">No other apps available.</div>';
    } else {
      listEl.innerHTML = otherApps.map(id => {
        const hasAssignment = !!(_asStacksCache[id]?.assignments?.[packId]);
        return `
          <label style="display:flex;align-items:center;gap:8px;font-size:0.82rem;cursor:pointer;">
            <input type="checkbox" value="${escHtml(id)}" ${hasAssignment ? '' : 'disabled'}
              style="accent-color:#3498db;">
            <span style="color:${hasAssignment ? '#ccc' : '#555'};">${escHtml(id)}</span>
            ${hasAssignment ? '' : '<span style="font-size:0.68rem;color:#444;">(pack not assigned)</span>'}
          </label>`;
      }).join('');
    }
  }

  const modal = new bootstrap.Modal(document.getElementById('as-propagate-modal'));
  modal.show();
}

async function _asPropagateConfirm() {
  if (!_asPropContext) return;
  const { appId, packId } = _asPropContext;

  const checked = [...document.querySelectorAll('#as-prop-app-list input[type=checkbox]:checked')]
    .map(cb => cb.value);
  if (!checked.length) { showToast('Select at least one target app', 'warning'); return; }

  try {
    await apiPost(
      `/v1/proxy/app-stacks/${encodeURIComponent(appId)}/packs/${encodeURIComponent(packId)}/propagate`,
      { to_apps: checked }
    );
    bootstrap.Modal.getInstance(document.getElementById('as-propagate-modal'))?.hide();
    showToast(`Overrides propagated to: ${checked.join(', ')}`, 'success');
    await loadAppStacks();
    _asSelectApp(appId);
  } catch (e) { showToast(`Propagate failed: ${e.message}`, 'error'); }
}

// ============================================================
// CORPORATE POLICY TAB
// ============================================================

let _cpKeywords    = [];
let _cpEnforceMode = 'warn';

async function loadCorpPolicy() {
  document.getElementById('cp-status').textContent = '';
  document.getElementById('cp-chips').innerHTML    = '<span style="color:#555;font-size:0.8rem;">Loading…</span>';
  try {
    const data = await apiGet('/v1/corporate-policy/signals');
    _cpKeywords    = data.keywords || [];
    _cpEnforceMode = data.enforce_mode || 'warn';
    _cpRender();
    _cpUpdateEnforceToggle();
    const src = data.source === 'file' ? 'Loaded from policy_signals.yaml' : 'Using built-in defaults (no file saved yet)';
    document.getElementById('cp-status').textContent = src;
    document.getElementById('cp-count').textContent  = `${_cpKeywords.length} signal${_cpKeywords.length !== 1 ? 's' : ''}`;
  } catch (e) {
    document.getElementById('cp-chips').innerHTML = `<span style="color:#e74c3c;font-size:0.8rem;">Failed to load: ${escHtml(e.message)}</span>`;
  }
}

function _cpRender() {
  const el = document.getElementById('cp-chips');
  if (!_cpKeywords.length) {
    el.innerHTML = '<span style="color:#555;font-size:0.78rem;font-style:italic;">No signals defined. Add one below.</span>';
    return;
  }
  el.innerHTML = _cpKeywords.map((kw, i) => `
    <span style="display:inline-flex;align-items:center;gap:5px;background:#1a2030;border:1px solid #2d3140;
                 border-radius:14px;padding:3px 10px 3px 12px;font-size:0.78rem;color:#c0d0e0;margin:3px 4px 3px 0;">
      ${escHtml(kw)}
      <button onclick="_cpRemove(${i})" title="Remove"
        style="background:none;border:none;color:#e74c3c;cursor:pointer;font-size:0.85rem;line-height:1;padding:0 0 1px 2px;">✕</button>
    </span>`).join('');
}

function _cpRemove(i) {
  _cpKeywords.splice(i, 1);
  _cpRender();
  document.getElementById('cp-count').textContent = `${_cpKeywords.length} signal${_cpKeywords.length !== 1 ? 's' : ''}`;
}

function _cpAddSignal() {
  const inp = document.getElementById('cp-new-signal');
  const val = (inp.value || '').trim().toLowerCase();
  if (!val) return;
  if (_cpKeywords.includes(val)) {
    showToast('Signal already in list', 'warning');
    inp.value = '';
    return;
  }
  _cpKeywords.push(val);
  _cpRender();
  document.getElementById('cp-count').textContent = `${_cpKeywords.length} signal${_cpKeywords.length !== 1 ? 's' : ''}`;
  inp.value = '';
  inp.focus();
}

function _cpUpdateEnforceToggle() {
  const tog = document.getElementById('cp-enforce-toggle');
  const lbl = document.getElementById('cp-enforce-label');
  if (!tog) return;
  tog.checked  = (_cpEnforceMode === 'block');
  lbl.textContent = _cpEnforceMode === 'block'
    ? 'Block (COERCIVE on 2+ signals)'
    : 'Warn only (NORMATIVE, no hard block)';
  lbl.style.color = _cpEnforceMode === 'block' ? '#e74c3c' : '#ffe066';
}

function _cpToggleEnforce(checked) {
  _cpEnforceMode = checked ? 'block' : 'warn';
  _cpUpdateEnforceToggle();
}

async function _cpSave() {
  const btn = document.getElementById('cp-save-btn');
  btn.disabled    = true;
  btn.textContent = 'Saving…';
  try {
    await apiPut('/v1/corporate-policy/signals', {
      keywords:     _cpKeywords,
      enforce_mode: _cpEnforceMode,
    });
    showToast(`Saved — ${_cpKeywords.length} signals, enforce_mode=${_cpEnforceMode}`, 'success');
    document.getElementById('cp-status').textContent =
      `Saved to policy_signals.yaml · ${new Date().toLocaleTimeString()}`;
  } catch (e) {
    showToast(`Save failed: ${e.message}`, 'error');
  } finally {
    btn.disabled    = false;
    btn.textContent = 'Save & Reload Classifier';
  }
}

// ============================================================
// SESSION POLICY EDITOR
// ============================================================

async function loadSessionPolicy() {
  const alertEl = document.getElementById('sp-alert');
  alertEl.className = 'alert d-none mb-3';
  try {
    const data = await apiGet('/v1/session-policy');
    const d = data.trust_deltas || {};
    document.getElementById('sp-delta-coercive').value   = d.COERCIVE  ?? -0.20;
    document.getElementById('sp-delta-normative').value  = d.NORMATIVE  ?? -0.05;
    document.getElementById('sp-delta-permissive').value = d.PERMISSIVE ?? 0.02;
    document.getElementById('sp-trust-floor').value      = data.trust_floor   ?? 0.20;
    document.getElementById('sp-trust-ceiling').value    = data.trust_ceiling ?? 1.0;
    document.getElementById('sp-ttl').value              = data.session_ttl_seconds ?? 1800;
    const dd = data.dedup || {};
    document.getElementById('sp-dedup-exact').checked      = dd.exact_block          ?? true;
    document.getElementById('sp-dedup-threshold').value    = dd.similarity_threshold ?? 0.92;
    document.getElementById('sp-dedup-window').value       = dd.window               ?? 50;
    document.getElementById('sp-dedup-penalty').value      = dd.repetition_penalty   ?? -0.05;
    _spTtlHint();
  } catch (e) {
    alertEl.className = 'alert alert-danger mb-3';
    alertEl.textContent = `Could not load session policy from Policy Engine: ${e.message}`;
  }
}

function _spTtlHint() {
  const ttl = parseFloat(document.getElementById('sp-ttl')?.value) || 1800;
  const el  = document.getElementById('sp-ttl-human');
  if (!el) return;
  if (ttl < 60)       el.textContent = `${ttl}s`;
  else if (ttl < 3600) el.textContent = `${Math.round(ttl/60)} minutes`;
  else                 el.textContent = `${(ttl/3600).toFixed(1)} hours`;
}

async function _spSave() {
  const alertEl = document.getElementById('sp-alert');
  alertEl.className = 'alert d-none mb-3';
  const payload = {
    trust_deltas: {
      COERCIVE:   parseFloat(document.getElementById('sp-delta-coercive').value),
      NORMATIVE:  parseFloat(document.getElementById('sp-delta-normative').value),
      PERMISSIVE: parseFloat(document.getElementById('sp-delta-permissive').value),
    },
    trust_floor:          parseFloat(document.getElementById('sp-trust-floor').value),
    trust_ceiling:        parseFloat(document.getElementById('sp-trust-ceiling').value),
    session_ttl_seconds:  parseFloat(document.getElementById('sp-ttl').value),
    dedup: {
      exact_block:          document.getElementById('sp-dedup-exact').checked,
      similarity_threshold: parseFloat(document.getElementById('sp-dedup-threshold').value),
      window:               parseInt(document.getElementById('sp-dedup-window').value, 10),
      repetition_penalty:   parseFloat(document.getElementById('sp-dedup-penalty').value),
    },
  };
  try {
    await apiPut('/v1/session-policy', payload);
    alertEl.className = 'alert alert-success mb-3';
    alertEl.innerHTML = '<i class="bi bi-check-circle me-2"></i>Session policy saved and hot-reloaded in the Policy Engine.';
    showToast('Session policy updated', 'success');
  } catch (e) {
    alertEl.className = 'alert alert-danger mb-3';
    alertEl.textContent = `Save failed: ${e.message}`;
  }
}

// ============================================================
// Tab switching — lazy load
// ============================================================
document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
  tab.addEventListener('shown.bs.tab', e => {
    const target = e.target.getAttribute('href');
    if (target === '#tab-evaluations')    { if (!evalLoaded) loadEvaluations(); else loadMockEvaluators(); }
    if (target === '#tab-policies')       loadPolicies();
    if (target === '#tab-appconfig'      && !appConfigLoaded) loadAppConfigs();
    if (target === '#tab-appstacks')     loadAppStacks();
    if (target === '#tab-dashboard')     { loadMetrics(); loadAppTrust(); loadAgentActivity(); loadCogs(); loadTrustScore(); loadSreMetrics(); }
    if (target === '#tab-evaltail')      loadEvalAudit();
    if (target === '#tab-audit')         { loadAudit(); }
    if (target === '#tab-corpolicy')     loadCorpPolicy();
    if (target === '#tab-session-policy') loadSessionPolicy();
  });
});

// ============================================================
// LLM Token Costs
// ============================================================
async function loadCogs() {
  const el = document.getElementById('cogs-container');
  if (!el) return;
  el.innerHTML = `<div class="text-muted text-center py-3" style="font-size:0.8rem;"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>`;
  try {
    // Map the existing metrics-window (minutes) to a COGS window string
    const mins = document.getElementById('metrics-window')?.value || '1440';
    const w = mins === '15' || mins === '60' ? '1h' : mins === '360' ? '6h' : mins === '' ? '30d' : '24h';

    const data = await apiGet(`/v1/cogs/summary?window=${w}`);
    const grandTotal = data.grand_total_cost_usd || 0;
    const apps = data.apps || [];
    const totalTokens = apps.reduce((s, a) => s + (a.total_tokens || 0), 0);
    const totalEvals  = apps.reduce((s, a) => s + (a.total_evaluations || 0), 0);

    if (apps.length === 0 || totalTokens === 0) {
      el.innerHTML = `<div class="text-muted" style="font-size:0.8rem;padding:0.5rem 0;">
        No token cost data in this window.<br>
        <span style="font-size:0.72rem;">Cost data appears once evaluations carry
        <code>agent_tokens</code> metadata — populated automatically by the RAI Trust SDK.</span></div>`;
      return;
    }

    const summaryHtml = `
      <div class="row g-2 mb-3">
        <div class="col-4">
          <div class="p-2 text-center" style="background:#0a1e10;border:1px solid #1a4a25;border-radius:6px;">
            <div style="font-size:0.65rem;color:#888;text-transform:uppercase;letter-spacing:0.04em;">Total Cost</div>
            <div style="font-size:1.05rem;color:#6fcf97;font-weight:600;">$${grandTotal < 0.001 ? grandTotal.toFixed(6) : grandTotal.toFixed(4)}</div>
          </div>
        </div>
        <div class="col-4">
          <div class="p-2 text-center" style="background:#0d1117;border:1px solid #2d3140;border-radius:6px;">
            <div style="font-size:0.65rem;color:#888;text-transform:uppercase;letter-spacing:0.04em;">Tokens</div>
            <div style="font-size:1rem;color:#c8d8f0;font-weight:500;">${_fmtNum(totalTokens)}</div>
          </div>
        </div>
        <div class="col-4">
          <div class="p-2 text-center" style="background:#0d1117;border:1px solid #2d3140;border-radius:6px;">
            <div style="font-size:0.65rem;color:#888;text-transform:uppercase;letter-spacing:0.04em;">Interactions</div>
            <div style="font-size:1rem;color:#c8d8f0;font-weight:500;">${totalEvals}</div>
          </div>
        </div>
      </div>`;

    const rows = apps.flatMap(app =>
      (app.models || []).map(m => {
        const costHtml = m.cost_usd != null
          ? `<span style="color:#6fcf97;">$${m.cost_usd < 0.0001 ? m.cost_usd.toFixed(7) : m.cost_usd.toFixed(5)}</span>`
          : `<span style="color:#555;" title="Model not in pricing table">–</span>`;
        const unpriced = !m.price_matched
          ? `<span class="badge ms-1" style="font-size:0.58rem;background:#3a2a00;color:#ffc06a;">unpriced</span>` : '';
        return `<tr>
          <td style="font-size:0.75rem;color:#aaa;white-space:nowrap;">${app.app_id}</td>
          <td style="font-size:0.72rem;"><code style="color:#c8d8f0;">${m.model || '–'}</code>${unpriced}</td>
          <td class="text-end" style="font-size:0.72rem;color:#888;">${_fmtNum(m.input_tokens)}</td>
          <td class="text-end" style="font-size:0.72rem;color:#888;">${_fmtNum(m.output_tokens)}</td>
          <td class="text-end" style="font-size:0.78rem;">${costHtml}</td>
        </tr>`;
      })
    ).join('');

    el.innerHTML = summaryHtml + `
      <table class="table table-sm mb-1" style="font-size:0.78rem;">
        <thead><tr>
          <th>App</th><th>Model</th>
          <th class="text-end" title="Prompt tokens">In</th>
          <th class="text-end" title="Completion tokens">Out</th>
          <th class="text-end">Cost USD</th>
        </tr></thead>
        <tbody>${rows || '<tr><td colspan="5" class="text-muted text-center">No data</td></tr>'}</tbody>
      </table>
      <div style="font-size:0.67rem;color:#555;">Window: ${w} · Pricing from config_model_pricing · <span style="color:#ffc06a;">unpriced</span> = model not in table</div>`;
  } catch (e) {
    el.innerHTML = `<div class="alert alert-danger py-2 mb-0" style="font-size:0.8rem;">Failed to load COGS: ${e.message}</div>`;
  }
}

// ============================================================
// App Trust Score (0–100 composite)
// ============================================================
async function loadTrustScore() {
  const el = document.getElementById('trust-score-container');
  if (!el) return;
  el.innerHTML = `<div class="text-muted text-center py-3" style="font-size:0.8rem;"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>`;
  try {
    const data = await apiGet('/v1/trust-score?window=24h&persist=true');
    const apps = data.apps || [];

    if (!apps.length || apps.every(a => a.status === 'no_data')) {
      el.innerHTML = `<div class="text-muted" style="font-size:0.8rem;padding:0.5rem 0;">
        No evaluation data in the last 24h.</div>`;
      return;
    }

    const scoreColor = s => s == null ? '#555' : s >= 90 ? '#2ecc71' : s >= 75 ? '#f1c40f' : s >= 60 ? '#e67e22' : '#e74c3c';
    const scoreBg    = s => s == null ? '#131313' : s >= 90 ? '#0a1e10' : s >= 75 ? '#1e1a00' : s >= 60 ? '#1e0e00' : '#1e0505';

    const catMeta = {
      safety:      { icon: 'bi-shield-fill-check',      label: 'Safety'      },
      security:    { icon: 'bi-lock-fill',               label: 'Security'    },
      compliance:  { icon: 'bi-clipboard2-check-fill',   label: 'Compliance'  },
      operational: { icon: 'bi-gear-fill',               label: 'Ops'         },
      quality:     { icon: 'bi-stars',                   label: 'Quality'     },
    };

    const cards = apps.map(a => {
      const sc = a.trust_score;
      const cats = a.categories || {};
      const catBars = Object.entries(catMeta).map(([cat, meta]) => {
        const info = cats[cat] || {};
        const pct  = info.score != null ? Math.round(info.score * 100) : null;
        const barClr = pct == null ? '#333' : pct >= 90 ? '#2ecc71' : pct >= 70 ? '#f1c40f' : '#e74c3c';
        const label  = pct != null ? `${pct}%` : 'n/a';
        const tip    = info.sample ? `${info.sample} evals` : 'no data';
        return `<div class="d-flex align-items-center mb-1" style="font-size:0.67rem;" title="${meta.label}: ${label} (${tip})">
          <i class="bi ${meta.icon} me-1" style="width:13px;font-size:0.6rem;color:#777;"></i>
          <span style="width:62px;color:#888;">${meta.label}</span>
          <div style="flex:1;height:4px;background:#1a1a2a;border-radius:2px;overflow:hidden;">
            <div style="width:${pct ?? 0}%;height:100%;background:${barClr};border-radius:2px;"></div>
          </div>
          <span style="width:34px;text-align:right;color:${barClr};font-size:0.68rem;">${label}</span>
        </div>`;
      }).join('');

      return `<div class="p-2 mb-2" style="background:${scoreBg(sc)};border:1px solid ${scoreColor(sc)}44;border-radius:8px;">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <code style="font-size:0.78rem;color:#c8d8f0;">${a.app_id}</code>
          <div class="d-flex align-items-baseline gap-1">
            <span style="font-size:0.65rem;color:#666;">${a.total_evals} evals</span>
            <span style="font-size:1.6rem;font-weight:700;color:${scoreColor(sc)};line-height:1;">${sc ?? '–'}</span>
            <span style="font-size:0.65rem;color:#555;">/100</span>
          </div>
        </div>
        ${catBars}
        ${a.status === 'no_data' ? '<div style="font-size:0.66rem;color:#555;margin-top:4px;">No data in window</div>' : ''}
      </div>`;
    }).join('');

    el.innerHTML = cards + `<div style="font-size:0.66rem;color:#555;margin-top:6px;">
      Computed from last 24h · missing categories default to 100%</div>`;
  } catch (e) {
    el.innerHTML = `<div class="alert alert-danger py-2 mb-0" style="font-size:0.8rem;">Failed to load trust score: ${e.message}</div>`;
  }
}

// ============================================================
// SRE Health — PII burn rate + governance latency
// ============================================================
async function loadSreMetrics() {
  const el = document.getElementById('sre-container');
  if (!el) return;
  el.innerHTML = `<div class="text-muted text-center py-3" style="font-size:0.8rem;"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>`;
  try {
    const [sre, alertResp] = await Promise.all([
      apiGet('/v1/sre/metrics?check_alerts=true&persist=true'),
      apiGet('/v1/sre/alerts?status=open&limit=10'),
    ]);
    const openAlerts  = alertResp.total || 0;
    const pii         = sre.pii_exposure_rate || {};
    const lat         = sre.governance_latency || {};
    const thresholds  = sre.thresholds || {};
    const windows     = ['1h', '6h', '24h'];

    const alertBanner = openAlerts > 0
      ? `<div class="alert py-2 mb-3" style="background:#2a0a0a;border:1px solid #e74c3c;color:#e05050;font-size:0.8rem;">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <strong>${openAlerts} open burn-rate alert${openAlerts > 1 ? 's' : ''}</strong> — check below for details.
        </div>` : '';

    const burnBadge = active => active
      ? `<span class="badge ms-2" style="background:#3a0a0a;color:#e74c3c;font-size:0.62rem;vertical-align:middle;"><i class="bi bi-fire me-1"></i>ALERT</span>`
      : `<span class="badge ms-2" style="background:#0a2a0a;color:#2ecc71;font-size:0.62rem;vertical-align:middle;">nominal</span>`;

    const rateCell = (d, thr) => {
      if (!d || d.total === 0) return `<span style="color:#444;">–</span>`;
      const clr = d.breached ? '#e74c3c' : d.rate > 0 ? '#f1c40f' : '#2ecc71';
      return `<span style="color:${clr};" title="Threshold ${(thr*100).toFixed(0)}%">
        ${d.breached ? '▲' : '●'} ${d.rate_pct.toFixed(2)}%</span>`;
    };
    const countCell = d => d
      ? `<span style="color:#666;font-size:0.7rem;">${d.flagged ?? 0}/${d.total ?? 0}</span>`
      : `<span style="color:#444;">–</span>`;

    const latCell = (d, thr) => {
      if (!d || d.sample === 0) return `<span style="color:#444;" title="No SYNC data">–</span>`;
      const clr = d.breached ? '#e74c3c' : (d.p95 > thr * 0.8) ? '#f1c40f' : '#2ecc71';
      return `<span style="color:${clr};" title="${d.sample} SYNC samples · threshold ${thr}ms">
        ${d.breached ? '▲' : '●'} ${d.p95}ms</span>`;
    };
    const latP50 = d => d?.p50 != null
      ? `<span style="color:#666;font-size:0.7rem;">${d.p50}ms p50</span>`
      : `<span style="color:#444;">–</span>`;

    const piiRows = windows.map(w => `<tr>
      <td style="color:#888;">${w}</td>
      <td class="text-center">${rateCell(pii[w], thresholds.pii_rate_1h)}</td>
      <td class="text-center">${countCell(pii[w])}</td>
    </tr>`).join('');

    const latRows = windows.map(w => `<tr>
      <td style="color:#888;">${w}</td>
      <td class="text-center">${latCell(lat[w], thresholds.latency_p95_1h_ms)}</td>
      <td class="text-center">${latP50(lat[w])}</td>
    </tr>`).join('');

    // Recent open alerts list
    const recentAlerts = (alertResp.alerts || []).slice(0, 3).map(a => {
      const typeLabel = a.alert_type === 'pii_burn_rate' ? 'PII Burn Rate' : 'Latency Burn Rate';
      const sev = a.severity === 'CRITICAL' ? '#e74c3c' : a.severity === 'HIGH' ? '#e05c5c' : '#e0a030';
      return `<div class="d-flex align-items-center gap-2 py-1" style="border-top:1px solid #1a1a2a;font-size:0.72rem;">
        <span class="badge" style="background:${sev}22;color:${sev};font-size:0.6rem;">${a.severity}</span>
        <span style="color:#bbb;">${typeLabel}</span>
        <span style="color:#666;margin-left:auto;">${new Date(a.triggered_at).toLocaleTimeString()}</span>
        <button class="btn btn-sm py-0 px-2" style="font-size:0.65rem;background:#1a2a1a;color:#6fcf97;border:1px solid #2a4a2a;"
          onclick="fetch('/v1/sre/alerts/${a.id}/ack',{method:'POST'}).then(()=>loadSreMetrics())">Ack</button>
      </div>`;
    }).join('');

    el.innerHTML = alertBanner + `
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <div class="p-3" style="background:#0d1117;border:1px solid #2d3140;border-radius:8px;height:100%;">
            <div class="mb-2" style="font-size:0.72rem;font-weight:600;color:#ccc;text-transform:uppercase;letter-spacing:0.05em;">
              <i class="bi bi-eye-slash-fill me-2 text-warning"></i>PII Exposure Rate${burnBadge(pii.burn_rate_alert_active)}
            </div>
            <div style="font-size:0.67rem;color:#666;margin-bottom:8px;">
              Alert: 1h &gt;${(thresholds.pii_rate_1h*100).toFixed(0)}% AND 6h &gt;${(thresholds.pii_rate_6h*100).toFixed(0)}% simultaneously
            </div>
            <table class="table table-sm mb-1" style="font-size:0.77rem;">
              <thead><tr><th>Window</th><th class="text-center">Rate</th><th class="text-center">Flagged/Total</th></tr></thead>
              <tbody>${piiRows}</tbody>
            </table>
            <div style="font-size:0.66rem;color:#555;">data_leakage &ge;4 · non-PERMISSIVE verdict</div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="p-3" style="background:#0d1117;border:1px solid #2d3140;border-radius:8px;height:100%;">
            <div class="mb-2" style="font-size:0.72rem;font-weight:600;color:#ccc;text-transform:uppercase;letter-spacing:0.05em;">
              <i class="bi bi-stopwatch-fill me-2 text-info"></i>Governance Latency p95${burnBadge(lat.burn_rate_alert_active)}
            </div>
            <div style="font-size:0.67rem;color:#666;margin-bottom:8px;">
              Alert: 1h &gt;${thresholds.latency_p95_1h_ms}ms AND 6h &gt;${thresholds.latency_p95_6h_ms}ms simultaneously
            </div>
            <table class="table table-sm mb-1" style="font-size:0.77rem;">
              <thead><tr><th>Window</th><th class="text-center">p95</th><th class="text-center">p50</th></tr></thead>
              <tbody>${latRows}</tbody>
            </table>
            <div style="font-size:0.66rem;color:#555;">SYNC evals only · ASYNC excluded from SLOs</div>
          </div>
        </div>
      </div>
      ${recentAlerts ? `<div class="mt-3 p-2" style="background:#0d1117;border:1px solid #2d3140;border-radius:6px;">
        <div style="font-size:0.68rem;color:#888;margin-bottom:4px;text-transform:uppercase;letter-spacing:0.04em;">
          <i class="bi bi-bell-fill me-1 text-danger"></i>Recent Open Alerts
        </div>
        ${recentAlerts}
      </div>` : ''}`;
  } catch (e) {
    el.innerHTML = `<div class="alert alert-danger py-2 mb-0" style="font-size:0.8rem;">Failed to load SRE metrics: ${e.message}</div>`;
  }
}

// ============================================================
// Init
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  // Evaluations is now the landing tab — load it on startup
  loadEvaluations();
  checkServiceStatus();
  refreshMockMode();
  setInterval(checkServiceStatus, 30000);
  setInterval(refreshMockMode, 30000);
});
</script>
</body>
</html>
