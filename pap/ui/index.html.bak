          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-size:0.82rem;"><i class="bi bi-bell me-1 text-danger"></i>Ops Alert on COERCIVE</label>
            <div class="form-check form-switch mt-1">
              <input class="form-check-input" type="checkbox" id="ep-ops-alert" />
              <label class="form-check-label text-muted" for="ep-ops-alert" style="font-size:0.8rem;">Raise ops alert on coercive verdict</label>
            </div>
