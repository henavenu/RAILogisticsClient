<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RAI Trust Platform — Policy Administration</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    body { background-color: #0f1117; color: #e0e0e0; font-size: 0.9rem; }
    .navbar-brand { font-weight: 700; letter-spacing: 0.03em; }
    .nav-tabs .nav-link { color: #aaa; border: none; padding: 0.65rem 1.25rem; }
    .nav-tabs .nav-link.active { color: #fff; background: #1a1d27; border-bottom: 2px solid #6ea8fe; }
    .nav-tabs { border-bottom: 1px solid #2d3140; }
    .tab-content { background: #1a1d27; border: 1px solid #2d3140; border-top: none;
                   border-radius: 0 0 8px 8px; padding: 1.5rem; min-height: 500px; }
    .table { --bs-table-bg: transparent; --bs-table-striped-bg: rgba(255,255,255,0.03); }
    .table thead th { color: #888; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em;
                      border-bottom: 1px solid #2d3140; font-weight: 500; }
    .table td, .table th { vertical-align: middle; border-color: #2d3140; }
    .badge-active   { background: #0f5132; color: #75b798; }
    .badge-deferred { background: #6c3a00; color: #ffc06a; }
    .badge-draft    { background: #4a3200; color: #ffd77a; }
    .badge-published{ background: #0f3b1e; color: #6fcf97; }
    .badge-coercive { background: #500; color: #ff8080; }
    .badge-normative{ background: #3a3000; color: #ffe066; }
    .badge-permissive{background: #0d3320; color: #6fcf97; }
    .card { background: #1e2130; border: 1px solid #2d3140; }
    .card-header { background: #252a3a; border-bottom: 1px solid #2d3140; font-weight: 600; }
    .form-control, .form-select { background: #151820; border-color: #2d3140; color: #e0e0e0; }
    .form-control:focus, .form-select:focus { background: #151820; color: #fff; border-color: #6ea8fe; box-shadow: none; }
    .btn-publish { background: #1d6a3f; border: 1px solid #2a9a5a; color: #fff; font-weight: 600; }
    .btn-publish:hover { background: #21844c; color: #fff; }
    .severity-1 { color: #6fcf97; }
    .severity-2 { color: #ffe066; }
    .severity-3 { color: #ff8080; }
    .threshold-band { font-family: monospace; font-size: 0.82rem; color: #a0b4d0; }
    #toast-container { position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9999; }
    .modal-content { background: #1a1d27; border: 1px solid #2d3140; }
    .modal-header { border-bottom: 1px solid #2d3140; }
    .modal-footer { border-top: 1px solid #2d3140; }
    .service-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 5px; }
    .dot-healthy { background: #2ecc71; }
    .dot-unhealthy { background: #e74c3c; }
    .dot-unknown  { background: #888; }
    .audit-action-CREATE  { color: #6ea8fe; }
    .audit-action-UPDATE  { color: #ffe066; }
    .audit-action-DELETE  { color: #ff8080; }
    .audit-action-PUBLISH { color: #6fcf97; }
    .spinner-sm { width: 1rem; height: 1rem; }
    /* App tiles */
    .app-tile {
      background: #1e2130; border: 1px solid #2d3140; border-radius: 10px;
      padding: 14px 18px; min-width: 170px; cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
    }
    .app-tile:hover { border-color: #6ea8fe; background: #22263a; }
    .app-tile.active { border-color: #6ea8fe; background: #1a2340; }
    .app-tile-name { font-size: 0.78rem; color: #8899bb; text-transform: uppercase;
                     letter-spacing: 0.07em; margin-bottom: 6px; }
    .app-tile-total { font-size: 1.6rem; font-weight: 700; color: #e0e8ff;
                      line-height: 1.1; margin-bottom: 8px; }
    .app-tile-bar { display: flex; height: 5px; border-radius: 3px; overflow: hidden;
                    gap: 1px; margin-bottom: 8px; }
    .app-tile-verdicts { display: flex; gap: 10px; font-size: 0.7rem; }
    .atv-p { color: #6fcf97; }
    .atv-n { color: #ffe066; }
    .atv-c { color: #ff8080; }
    /* Category group header rows in evaluation table */
    .cat-row td { font-size:0.68rem; text-transform:uppercase; letter-spacing:0.08em;
                  font-weight:600; padding:6px 12px !important; border-bottom:none !important; }
    .cat-safety     td { background:#1a0a0a; color:#e74c3c; border-left:3px solid #e74c3c !important; }
    .cat-security   td { background:#1a0f0a; color:#e67e22; border-left:3px solid #e67e22 !important; }
    .cat-trust      td { background:#140a1a; color:#9b59b6; border-left:3px solid #9b59b6 !important; }
    .cat-financial_crime td { background:#1a130a; color:#f39c12; border-left:3px solid #f39c12 !important; }
    .cat-corporate_governance td { background:#0a111a; color:#3498db; border-left:3px solid #3498db !important; }
    .cat-eu_ai_act  td { background:#0a1a0f; color:#2ecc71; border-left:3px solid #2ecc71 !important; }
    .cat-prompt_filter td { background:#0a1a18; color:#1abc9c; border-left:3px solid #1abc9c !important; }
    .cat-session_signals td { background:#0f1020; color:#8e9cc0; border-left:3px solid #8e9cc0 !important; }
    .cat-row + tr td { border-left:3px solid transparent !important; }
    /* App Stacks — pack active/inactive pill toggle */
    .as-toggle { display:inline-flex; align-items:center; cursor:pointer; user-select:none; flex-shrink:0; }
    .as-toggle input[type=checkbox] { display:none; }
    .as-toggle-track {
      width:32px; height:17px; background:#2a2d3e; border-radius:9px;
      position:relative; transition:background 0.18s; border:1px solid #3a3f55;
    }
    .as-toggle input:checked ~ .as-toggle-track { background:#1a5c34; border-color:#2ecc7155; }
    .as-toggle-thumb {
      position:absolute; top:2px; left:2px; width:11px; height:11px;
      background:#666; border-radius:50%; transition:left 0.18s, background 0.18s;
    }
    .as-toggle input:checked ~ .as-toggle-track .as-toggle-thumb { left:17px; background:#2ecc71; }
  </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-dark px-3 py-2" style="background:#12151f; border-bottom:1px solid #2d3140;">
  <span class="navbar-brand">
    <i class="bi bi-shield-lock-fill text-info me-2"></i>RAI Trust Platform
    <span class="text-muted ms-2 fw-normal" style="font-size:0.78rem;">Policy Administration</span>
  </span>
  <div class="d-flex align-items-center gap-3" id="service-status">
    <!-- Mock mode toggle -->
    <div class="d-flex align-items-center gap-2 me-2 border-end border-secondary pe-3">
      <span id="mock-mode-label" style="font-size:0.76rem; color:#aaa;">Mock</span>
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" id="mock-mode-toggle"
               onchange="setMockMode(this.checked)" style="cursor:pointer;" />
      </div>
      <span id="mock-mode-badge" class="badge" style="font-size:0.68rem; display:none;"></span>
    </div>
    <!-- Service dots -->
    <span class="text-muted" style="font-size:0.78rem;">
      <span class="service-dot dot-unknown" id="dot-gs"></span>Guardrail
    </span>
    <span class="text-muted" style="font-size:0.78rem;">
      <span class="service-dot dot-unknown" id="dot-pe"></span>Policy Engine
    </span>
  </div>
</nav>

<!-- Main content -->
<div class="container-fluid px-4 py-3">

  <!-- Tabs -->
  <ul class="nav nav-tabs mt-2" id="mainTabs">
    <li class="nav-item">
      <a class="nav-link active" data-bs-toggle="tab" href="#tab-evaluations">
        <i class="bi bi-diagram-3 me-1"></i>Evaluations
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-policies">
        <i class="bi bi-file-earmark-ruled me-1"></i>Policies
        <span class="badge bg-secondary ms-1" id="badge-policy-count">–</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-stack" onclick="loadPolicyStack()">
        <i class="bi bi-layers me-1"></i>Policy Packs
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-appstacks">
        <i class="bi bi-diagram-2 me-1"></i>App Policy Stack
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-dashboard">
        <i class="bi bi-speedometer2 me-1"></i>Dashboard
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-evaltail" onclick="loadEvalAudit()">
        <i class="bi bi-activity me-1"></i>Eval Trail
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-audit">
        <i class="bi bi-journal-text me-1"></i>Audit
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-platform" onclick="loadPlatformRules()">
        <i class="bi bi-cpu me-1"></i>Platform Rules
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-appconfig">
        <i class="bi bi-gear me-1"></i>App Config
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-livetail" id="livetail-tab">
        <i class="bi bi-terminal me-1"></i>Live Tail
        <span class="badge rounded-pill bg-danger ms-1 d-none" id="livetail-badge">LIVE</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-corpolicy">
        <i class="bi bi-building-gear me-1"></i>Corporate Policy
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#tab-session-policy" onclick="loadSessionPolicy()">
        <i class="bi bi-stopwatch me-1"></i>Session Policy
      </a>
    </li>
  </ul>

  <div class="tab-content">

    <!-- ====================================================== -->
    <!-- TAB 1 — POLICIES                                        -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-policies">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0">Policy Definitions</h6>
          <small class="text-muted">Thresholds and remediations per evaluation dimension.</small>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" onclick="loadPolicies()">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
          </button>
          <button class="btn btn-sm btn-publish" onclick="publishPolicies()">
            <i class="bi bi-cloud-upload me-1"></i>Publish to Policy Engine
          </button>
        </div>
      </div>

      <div id="publish-status" class="alert d-none mb-3" role="alert"></div>

      <div class="table-responsive">
        <table class="table table-hover" id="policies-table">
          <thead>
            <tr>
              <th>Dimension</th>
              <th>Severity</th>
              <th>Permissive</th>
              <th>Normative</th>
              <th>Coercive</th>
              <th>Status</th>
              <th style="width:80px">Actions</th>
            </tr>
          </thead>
          <tbody id="policies-tbody">
            <tr><td colspan="6" class="text-center text-muted py-4">
              <div class="spinner-border spinner-sm text-secondary me-2"></div>Loading...
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ====================================================== -->
    <!-- TAB 1 — EVALUATIONS                                     -->
    <!-- ====================================================== -->
    <div class="tab-pane fade show active" id="tab-evaluations">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0">Evaluation Taxonomy</h6>
          <small class="text-muted">All dimensions registered in the Guardrail Service — each produces a score 1–9 that pack thresholds apply to.</small>
        </div>
        <button class="btn btn-sm btn-outline-secondary" onclick="loadEvaluations()">
          <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
      </div>

      <div class="row mb-3" id="eval-summary"></div>

      <div class="table-responsive mb-4">
        <table class="table table-hover" id="eval-table">
          <thead>
            <tr>
              <th>Dimension</th>
              <th>Status</th>
              <th>Provider</th>
              <th>Roles</th>
              <th>Referenced by Packs</th>
            </tr>
          </thead>
          <tbody id="eval-tbody">
            <tr><td colspan="5" class="text-center text-muted py-4">
              <div class="spinner-border spinner-sm text-secondary me-2"></div>Loading…
            </td></tr>
          </tbody>
        </table>
      </div>

      <!-- Evaluator Catalog (rich card view) -->
      <hr class="border-secondary mb-4" />
      <h6 class="mb-3" style="color:#aaa; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em;">
        <i class="bi bi-cpu me-2"></i>Evaluator Catalog
        <small class="text-muted ms-2 text-lowercase" style="letter-spacing:0;">Cross-referenced with active pack assignments.</small>
      </h6>
      <div id="eval-evaluators-container">
        <div class="text-muted" style="font-size:0.83rem;"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>
      </div>

      <!-- Mock Evaluator Signal Editor -->
      <hr class="border-secondary mb-4 mt-4" />
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0" style="color:#aaa; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em;">
            <i class="bi bi-braces me-2 text-warning"></i>Mock Evaluator Signals
          </h6>
          <small class="text-muted" style="font-size:0.72rem;">Edit keyword lists used by the MockProvider for content-aware scoring in dev/test mode.</small>
        </div>
        <button class="btn btn-sm btn-outline-warning" onclick="loadMockEvaluators()">
          <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
      </div>
      <div id="mock-evaluators-container">
        <div class="text-muted" style="font-size:0.83rem;"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>
      </div>
    </div>

    <!-- ====================================================== -->
    <!-- TAB 3 — APP CONFIG                                      -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-appconfig">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0">App Trust Configuration</h6>
          <small class="text-muted">Per-application trust tier settings. Base tier sets the minimum enforcement floor.</small>
        </div>
        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#appConfigModal" onclick="openAppConfigModal()">
          <i class="bi bi-plus-lg me-1"></i>Add App Config
        </button>
      </div>

      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>App ID</th>
              <th>Display Name</th>
              <th>Base Tier</th>
              <th>Dynamic Eval</th>
              <th>Updated</th>
              <th style="width:100px">Actions</th>
            </tr>
          </thead>
          <tbody id="appconfig-tbody">
            <tr><td colspan="6" class="text-center text-muted py-4">No app configs yet. Add one above.</td></tr>
          </tbody>
        </table>
      </div>

      <div class="card mt-3">
        <div class="card-header"><i class="bi bi-info-circle me-2 text-info"></i>Trust Tier Reference</div>
        <div class="card-body" style="font-size:0.82rem;">
          <div class="row g-3">
            <div class="col-md-4">
              <span class="badge badge-permissive me-1">LOW</span>
              <span class="text-muted">Permissive enforcement — suitable for internal tools and low-risk applications.</span>
            </div>
            <div class="col-md-4">
              <span class="badge badge-normative me-1">MEDIUM</span>
              <span class="text-muted">Balanced enforcement — default for most applications.</span>
            </div>
            <div class="col-md-4">
              <span class="badge badge-coercive me-1">HIGH</span>
              <span class="text-muted">Strict enforcement — customer-facing or high-risk applications.</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- ====================================================== -->
    <!-- TAB — DASHBOARD (Metrics + Trust)                       -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-dashboard">
      <div class="row g-3">

        <!-- ── LEFT COLUMN: Tier 1 Metrics + Trust Scores ── -->
        <div class="col-12 col-xl-8">

          <!-- Tier 1 Metrics -->
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.06em;color:#aaa;">
              <i class="bi bi-bar-chart-line me-2 text-info"></i>Tier 1 Metrics
            </h6>
            <div class="d-flex align-items-center gap-2">
              <select class="form-select form-select-sm" id="metrics-app" style="width:110px;font-size:0.75rem;" onchange="_activeTileApp=this.value||null;loadMetrics()">
                <option value="">All apps</option>
              </select>
              <select class="form-select form-select-sm" id="metrics-window" style="width:100px;font-size:0.75rem;" onchange="loadMetrics()">
                <option value="15">15 min</option>
                <option value="60" selected>1 hour</option>
                <option value="360">6 hours</option>
                <option value="1440">24 hours</option>
                <option value="">All time</option>
              </select>
              <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="loadMetrics()" title="Refresh">
                <i class="bi bi-arrow-clockwise"></i>
              </button>
            </div>
          </div>
          <span class="text-muted d-block mb-2" style="font-size:0.72rem;" id="metrics-computed-from"></span>

          <!-- App tiles -->
          <div id="metrics-app-tiles" class="d-flex flex-wrap gap-2 mb-3"></div>

          <!-- Traffic breakdown -->
          <div class="row g-2 mb-2" id="metrics-breakdown"></div>

          <!-- Metric cards -->
          <div class="row g-2" id="metrics-grid">
            <div class="col-12 text-center text-muted py-4">
              <div class="spinner-border spinner-sm me-2"></div>Loading metrics…
            </div>
          </div>

          <!-- Legend -->
          <div class="mt-2 p-2" style="background:#12151f;border:1px solid #2d3140;border-radius:6px;font-size:0.7rem;">
            <span class="me-3"><span class="badge bg-success me-1" style="font-size:0.6rem;">●</span>Available</span>
            <span class="me-3"><span class="badge me-1" style="background:#4a3200;color:#ffc06a;font-size:0.6rem;">●</span>Deferred</span>
            <span class="me-3"><span class="badge me-1" style="background:#1a3a5c;color:#6ea8fe;font-size:0.6rem;">●</span>Needs Phoenix</span>
            <span><span class="badge me-1" style="background:#2a1a3a;color:#bf8fff;font-size:0.6rem;">●</span>Needs Integration</span>
          </div>

        </div><!-- /col left -->

        <!-- ── RIGHT COLUMN: Agent Activity ── -->
        <div class="col-12 col-xl-4">
          <div style="position:sticky;top:1rem;">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="mb-0" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.06em;color:#aaa;">
                <i class="bi bi-cpu me-2 text-info"></i>Agent Activity
              </h6>
              <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="loadAgentActivity()" title="Refresh">
                <i class="bi bi-arrow-clockwise"></i>
              </button>
            </div>
            <small class="text-muted d-block mb-2" style="font-size:0.7rem;">
              Per-agent evaluation counts, violations, tokens and estimated cost.
            </small>
            <div id="agent-activity-container">
              <div class="text-muted text-center py-3" style="font-size:0.8rem;">
                <div class="spinner-border spinner-sm me-2"></div>Loading…
              </div>
            </div>
          </div>
        </div><!-- /col right -->

      </div><!-- /row -->

      <!-- ── ROW 2: App Trust Score (0-100) + COGS ── -->
      <div class="row g-3 mt-2">

        <!-- App Trust Score — composite 0-100 -->
        <div class="col-12 col-xl-5">
          <div class="card h-100" style="background:#0d1117;border-color:#2d3140;">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.06em;color:#aaa;">
                  <i class="bi bi-shield-check me-2 text-info"></i>App Trust Score
                </h6>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="loadTrustScore()" title="Refresh">
                  <i class="bi bi-arrow-clockwise"></i>
                </button>
              </div>
              <small class="text-muted d-block mb-2" style="font-size:0.7rem;">
                Composite 0–100 · Safety 30%, Security 25%, Compliance 20%, Operational 10%, Quality 15%
              </small>
              <div id="trust-score-container">
                <div class="text-muted text-center py-3"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>
              </div>
            </div>
          </div>
        </div>

        <!-- LLM Token Costs -->
        <div class="col-12 col-xl-7">
          <div class="card h-100" style="background:#0d1117;border-color:#2d3140;">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.06em;color:#aaa;">
                  <i class="bi bi-currency-dollar me-2 text-warning"></i>LLM Token Costs
                  <small class="text-muted ms-2 text-lowercase" style="letter-spacing:0;font-size:0.68rem;">by model · last 24h</small>
                </h6>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="loadCogs()" title="Refresh">
                  <i class="bi bi-arrow-clockwise"></i>
                </button>
              </div>
              <div id="cogs-container">
                <div class="text-muted text-center py-3"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /row 2 -->

      <!-- ── ROW 3: SRE Health ── -->
      <div class="row g-3 mt-2">
        <div class="col-12">
          <div class="card" style="background:#0d1117;border-color:#2d3140;">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.06em;color:#aaa;">
                  <i class="bi bi-activity me-2 text-danger"></i>SRE Health
                  <small class="text-muted ms-2 text-lowercase" style="letter-spacing:0;font-size:0.68rem;">
                    Burn-rate alerts fire when BOTH 1h AND 6h windows exceed threshold simultaneously
                  </small>
                </h6>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="loadSreMetrics()" title="Refresh">
                  <i class="bi bi-arrow-clockwise"></i>
                </button>
              </div>
              <div id="sre-container">
                <div class="text-muted text-center py-3"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>
              </div>
            </div>
          </div>
        </div>
      </div><!-- /row 3 -->

      <!-- ── ROW 4: Session Trust Scores ── -->
      <div class="row g-3 mt-2">
        <div class="col-12">
          <div class="card" style="background:#0d1117;border-color:#2d3140;">
            <div class="card-body p-3">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="mb-0" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.06em;color:#aaa;">
                  <i class="bi bi-graph-down-arrow me-2"></i>Session Trust Scores
                  <small class="text-muted ms-2 text-lowercase" style="letter-spacing:0;">Per-app · derived from verdict history · drives threshold step adjustments</small>
                </h6>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="loadAppTrust()">
                  <i class="bi bi-arrow-clockwise"></i>
                </button>
              </div>
              <div class="d-flex flex-wrap gap-3 mb-3" style="font-size:0.75rem;">
                <span><span style="color:#2ecc71;">&#9632;</span> <strong>Maintaining</strong> ≥0.80</span>
                <span><span style="color:#f1c40f;">&#9632;</span> <strong>Step-Up</strong> 0.60–0.79 (+1)</span>
                <span><span style="color:#e67e22;">&#9632;</span> <strong>Step-Up+</strong> 0.40–0.59 (+2)</span>
                <span><span style="color:#e74c3c;">&#9632;</span> <strong>Critical</strong> &lt;0.40</span>
              </div>
              <div id="pr-app-trust-container">
                <div class="text-muted" style="font-size:0.83rem;">
                  <div class="spinner-border spinner-sm me-2"></div>Loading…
                </div>
              </div>
            </div>
          </div>
        </div>
      </div><!-- /row 4 -->

    </div>

    <!-- ====================================================== -->
    <!-- TAB — EVAL TRAIL                                        -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-evaltail">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0"><i class="bi bi-activity me-2 text-info"></i>Evaluation Trail</h6>
          <small class="text-muted">Real-time log of Policy Engine evaluation decisions — verdict, packs activated, violations detected.</small>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <select class="form-select form-select-sm" id="eval-audit-verdict-filter" style="width:140px;font-size:0.75rem;" onchange="loadEvalAudit()">
            <option value="">All Verdicts</option>
            <option value="PERMISSIVE">PERMISSIVE</option>
            <option value="NORMATIVE">NORMATIVE</option>
            <option value="COERCIVE">COERCIVE</option>
          </select>
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="eval-audit-autorefresh" onchange="toggleEvalAutoRefresh()" />
            <label class="form-check-label text-muted" for="eval-audit-autorefresh" style="font-size:0.72rem;">Auto-refresh</label>
          </div>
          <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="loadEvalAudit()" title="Refresh">
            <i class="bi bi-arrow-clockwise"></i>
          </button>
        </div>
      </div>

      <div class="table-responsive" style="max-height:70vh;overflow-y:auto;">
        <table class="table table-hover table-sm" id="eval-audit-table" style="font-size:0.78rem;">
          <thead style="position:sticky;top:0;background:#1a1d27;z-index:1;">
            <tr>
              <th>Time</th>
              <th>Verdict</th>
              <th>App</th>
              <th>Role</th>
              <th>ms</th>
              <th>Packs</th>
              <th>Violations</th>
            </tr>
          </thead>
          <tbody id="eval-audit-tbody">
            <tr><td colspan="7" class="text-center text-muted py-4">Click Eval Trail tab to load.</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ====================================================== -->
    <!-- TAB — AUDIT (Policy Changes)                           -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-audit">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0"><i class="bi bi-pencil-square me-2 text-secondary"></i>Policy Audit</h6>
          <small class="text-muted">Immutable record of all policy edits and publish events, grouped by app.</small>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <select class="form-select form-select-sm" id="audit-app-filter" style="width:140px" onchange="loadAudit()">
            <option value="">All Apps</option>
          </select>
          <select class="form-select form-select-sm" id="audit-action-filter" style="width:150px" onchange="loadAudit()">
            <option value="">All Actions</option>
            <option value="CREATE">CREATE</option>
            <option value="UPDATE">UPDATE</option>
            <option value="DELETE">DELETE</option>
            <option value="PUBLISH">PUBLISH</option>
          </select>
          <button class="btn btn-sm btn-outline-secondary" onclick="loadAudit()">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
          </button>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>App</th>
              <th>Action</th>
              <th>Dimension</th>
              <th>Actor</th>
              <th>Notes / Summary</th>
            </tr>
          </thead>
          <tbody id="audit-tbody">
            <tr><td colspan="6" class="text-center text-muted py-4">Click Audit tab to load.</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ====================================================== -->
    <!-- TAB 5 — PLATFORM RULES                                   -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-platform">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h6 class="mb-0">Platform Rules</h6>
          <small class="text-muted">Engine configuration and built-in evaluation rules. Configuration is read-only — changes require a service restart.</small>
        </div>
        <button class="btn btn-sm btn-outline-secondary" onclick="loadPlatformRules()">
          <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
      </div>

      <!-- ── Row 1: Runtime toggles ── -->
      <div class="row g-3 mb-4">

        <!-- Fail Mode -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
              <i class="bi bi-shield-exclamation text-warning"></i>Fail Mode
              <span class="badge ms-auto" id="pr-failmode-badge">–</span>
            </div>
            <div class="card-body" style="font-size:0.83rem;">
              <p class="text-muted mb-2">Controls verdict when the Guardrail Service is unreachable.</p>
              <div class="mb-2">
                <span class="badge bg-success me-1">OPEN</span>
                <span class="text-muted">Requests pass (PERMISSIVE) — suitable for dev/test.</span>
              </div>
              <div>
                <span class="badge bg-danger me-1">CLOSED</span>
                <span class="text-muted">Requests blocked (COERCIVE) — required for production.</span>
              </div>
              <div class="mt-3 pt-2 border-top" style="border-color:#2d3140!important; font-size:0.75rem; color:#666;">
                Set via <code>FAIL_MODE</code> env var · requires restart
              </div>
            </div>
          </div>
        </div>

        <!-- Mock Mode -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
              <i class="bi bi-bug text-warning"></i>Mock Mode
              <span class="badge ms-auto" id="pr-mockmode-badge">–</span>
            </div>
            <div class="card-body" style="font-size:0.83rem;">
              <p class="text-muted mb-2">Routes all Guardrail evaluations through the built-in mock provider instead of real AI safety APIs.</p>
              <div class="mb-2">
                <span class="badge bg-warning text-dark me-1">ON</span>
                <span class="text-muted">Mock scores — deterministic, zero API cost.</span>
              </div>
              <div>
                <span class="badge bg-secondary me-1">OFF</span>
                <span class="text-muted">Real provider evaluations (Azure / AWS).</span>
              </div>
              <div class="mt-3 pt-2 border-top" style="border-color:#2d3140!important;">
                <div class="form-check form-switch mb-0">
                  <input class="form-check-input" type="checkbox" id="pr-mock-toggle"
                         onchange="setMockMode(this.checked)" />
                  <label class="form-check-label" for="pr-mock-toggle" style="font-size:0.75rem; color:#aaa;">
                    Toggle at runtime — no restart required
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Session Config -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
              <i class="bi bi-layers text-info"></i>Session Store
            </div>
            <div class="card-body" style="font-size:0.83rem;" id="pr-session-body">
              <div class="text-muted">Loading…</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Row 2: Engine Rules (Tier C) ── -->
      <h6 class="mb-3" style="color:#aaa; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em;">
        <i class="bi bi-journal-code me-2"></i>Built-in Engine Rules
        <small class="text-muted ms-2 text-lowercase" style="letter-spacing:0;">These rules are implemented in code and cannot be changed via PAP.</small>
      </h6>

      <div class="row g-3" id="pr-rules-grid">

        <div class="col-md-6">
          <div class="card">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-danger">MRA Rule 1</span>
                <strong style="font-size:0.85rem;">Verdict Escalation</strong>
              </div>
              <p class="text-muted mb-0" style="font-size:0.82rem;">
                A single COERCIVE dimension score produces a COERCIVE verdict for the entire request. NORMATIVE is returned only when at least one dimension is normative and none are coercive.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-warning text-dark">MRA Rule 2</span>
                <strong style="font-size:0.85rem;">Violation Priority Ordering</strong>
              </div>
              <p class="text-muted mb-0" style="font-size:0.82rem;">
                When multiple dimensions are non-permissive, violations are ordered by verdict level (COERCIVE first) then by severity. This determines which violation and remediation message appears first in the response — it does not change the final verdict.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-secondary">MRA Rule 3</span>
                <strong style="font-size:0.85rem;">All Violations Reported</strong>
              </div>
              <p class="text-muted mb-0" style="font-size:0.82rem;">
                Every dimension that exceeds its permissive threshold is included in the response. Nothing is silently dropped, even when the overall verdict has already been determined by another dimension.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-secondary">MRA Rule 4</span>
                <strong style="font-size:0.85rem;">Policy Thresholds Are Authoritative</strong>
              </div>
              <p class="text-muted mb-0" style="font-size:0.82rem;">
                Verdicts are determined solely by the policy thresholds configured in the Policies tab. Raw scores returned by the Guardrail Service are inputs only — they do not directly determine the verdict. If a provider returns no score, that dimension is excluded from synthesis.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-secondary">MRA Rule 5</span>
                <strong style="font-size:0.85rem;">Deferred Dimensions Are Excluded</strong>
              </div>
              <p class="text-muted mb-0" style="font-size:0.82rem;">
                Dimensions marked <em>deferred</em> in the Guardrail Service are scored but never contribute to violations or verdicts. Use this to register a new dimension and monitor its scores before activating enforcement.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-info text-dark">Session Rule 1</span>
                <strong style="font-size:0.85rem;">Worst-Score Accumulation</strong>
              </div>
              <p class="text-muted mb-0" style="font-size:0.82rem;">
                The Policy Engine retains the highest score seen per dimension across all turns in a session. A subsequent clean message cannot reduce a previously elevated score — risk signals only accumulate.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-info text-dark">Session Rule 2</span>
                <strong style="font-size:0.85rem;">Per-Turn Verdict Is Always Returned</strong>
              </div>
              <p class="text-muted mb-0" style="font-size:0.82rem;">
                The verdict returned to the application always reflects the current turn only. Session-level escalation patterns are recorded in the audit trail for observability but do not modify the verdict. Applications do not need to interpret session state.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card">
            <div class="card-body p-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-info text-dark">Session Rule 3</span>
                <strong style="font-size:0.85rem;">Session Composite Score Formula</strong>
              </div>
              <p class="text-muted mb-0" style="font-size:0.82rem;">
                The session trust score is the mean of per-dimension safety values computed from worst-case scores:
                <br><code style="font-size:0.8rem;">safety(d) = 1 − (worst_score(d) − 1) / 8</code>
                <br><code style="font-size:0.8rem;">composite = mean(safety) across all tracked dimensions</code>
                <br>Result: <strong>1.0</strong> = fully trusted, <strong>0.0</strong> = maximum risk. Score updates after every turn and is visible in the application trace panel.
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- ── Row 3: Policy Pack Inspector ── -->
      <hr class="border-secondary mt-4 mb-4" />
      <h6 class="mb-3" style="color:#aaa; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.06em;">
        <i class="bi bi-stack me-2"></i>Policy Pack Inspector
        <small class="text-muted ms-2 text-lowercase" style="letter-spacing:0;">Loaded packs and their dimensions. Pack selection is context-driven (transaction metadata → tags → packs).</small>
      </h6>
      <div id="pr-packs-container">
        <div class="text-muted" style="font-size:0.83rem;">
          <div class="spinner-border spinner-sm me-2"></div>Loading policy packs…
        </div>
      </div>

    </div>

    <!-- tab-metrics is now merged into tab-dashboard; this stub prevents dead-link 404s -->
    <div class="tab-pane fade" id="tab-metrics" style="display:none!important;"></div>

    <!-- ====================================================== -->
    <!-- TAB 6 — LIVE TAIL                                        -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-livetail">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0"><i class="bi bi-terminal me-2 text-info"></i>Live Evaluation Tail
            <span class="badge bg-danger ms-2 d-none" id="lt-live-badge" style="font-size:0.65rem;letter-spacing:0.08em;">● LIVE</span>
            <span class="badge bg-secondary ms-2 d-none" id="lt-paused-badge" style="font-size:0.65rem;">PAUSED</span>
          </h6>
          <small class="text-muted">Real-time stream of evaluation records. Connect once, watch forever.</small>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <select class="form-select form-select-sm" id="lt-verdict-filter" style="width:160px">
            <option value="">All Verdicts</option>
            <option value="PERMISSIVE">PERMISSIVE</option>
            <option value="NORMATIVE">NORMATIVE</option>
            <option value="COERCIVE">COERCIVE</option>
          </select>
          <button class="btn btn-sm btn-success" id="lt-btn-connect" onclick="ltConnect()">
            <i class="bi bi-play-fill me-1"></i>Connect
          </button>
          <button class="btn btn-sm btn-warning d-none" id="lt-btn-pause" onclick="ltTogglePause()">
            <i class="bi bi-pause-fill me-1"></i>Pause
          </button>
          <button class="btn btn-sm btn-outline-danger d-none" id="lt-btn-disconnect" onclick="ltDisconnect()">
            <i class="bi bi-stop-fill me-1"></i>Disconnect
          </button>
          <button class="btn btn-sm btn-outline-secondary" onclick="ltClear()">
            <i class="bi bi-trash me-1"></i>Clear
          </button>
        </div>
      </div>

      <!-- Stats bar -->
      <div class="d-flex gap-3 mb-2" id="lt-stats" style="font-size:0.78rem;">
        <span class="text-muted">Total: <strong id="lt-count-total">0</strong></span>
        <span class="severity-1">Permissive: <strong id="lt-count-p">0</strong></span>
        <span class="severity-2">Normative: <strong id="lt-count-n">0</strong></span>
        <span class="severity-3">Coercive: <strong id="lt-count-c">0</strong></span>
        <span class="text-muted ms-auto" id="lt-status-msg">Not connected</span>
      </div>

      <!-- Terminal output -->
      <div id="lt-terminal"
           style="background:#0a0c10; border:1px solid #2d3140; border-radius:6px;
                  font-family:'Cascadia Code','Fira Code','Consolas',monospace;
                  font-size:0.8rem; line-height:1.6; padding:12px 14px;
                  height:520px; overflow-y:auto; color:#c9d1d9; white-space:pre-wrap;
                  word-break:break-all;">
        <span class="text-muted">── Evaluation Live Tail ready. Click Connect to start streaming. ──
</span>
      </div>
    </div>

    <!-- ====================================================== -->
    <!-- TAB — POLICY STACK                                      -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-stack">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0"><i class="bi bi-layers me-2 text-info"></i>Policy Packs</h6>
          <small class="text-muted">Evaluation tiers, pack library, and composer.</small>
        </div>
        <button class="btn btn-sm btn-outline-secondary" onclick="loadPolicyStack()">
          <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
      </div>

      <!-- ── Sub-tab Navigation ────────────────────────────── -->
      <ul class="nav nav-tabs mb-4" style="border-bottom:1px solid #2d3140;">
        <li class="nav-item">
          <a class="nav-link active" data-bs-toggle="tab" href="#ps-sub-library"
            style="font-size:0.8rem;padding:6px 14px;">
            <i class="bi bi-journal-code me-1"></i>Pack Library
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" data-bs-toggle="tab" href="#ps-sub-builder" id="ps-builder-subtab"
            style="font-size:0.8rem;padding:6px 14px;">
            <i class="bi bi-tools me-1"></i>Pack Builder
          </a>
        </li>
      </ul>

      <!-- ps-stack-container kept in DOM (off-screen) so _renderStackExecution() doesn't error -->
      <div id="ps-stack-container" style="display:none;"></div>

      <div class="tab-content">

        <!-- ── Sub-tab 1: Pack Library ──────────────────────── -->
        <div class="tab-pane fade show active" id="ps-sub-library">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <small class="text-muted" style="font-size:0.8rem;">All loaded packs — click Edit to open in Pack Builder, or compose a new one.</small>
            <button onclick="_switchToBuilder()" style="font-size:0.72rem;background:#1a3a2a;color:#2ecc71;border:1px solid #2ecc7144;border-radius:4px;padding:3px 12px;cursor:pointer;">
              <i class="bi bi-plus me-1"></i>New Pack
            </button>
          </div>
          <div id="ps-library-container">
            <div class="text-muted" style="font-size:0.83rem;"><div class="spinner-border spinner-sm me-2"></div>Loading…</div>
          </div>
        </div>

        <!-- ── Sub-tab 3: Pack Builder ──────────────────────── -->
        <div class="tab-pane fade" id="ps-sub-builder">
          <div id="ps-builder-container">
        <div class="row g-3">

          <!-- Left: Evaluator Library -->
          <div class="col-md-4">
            <div style="border:1px solid #2d3140;border-radius:6px;overflow:hidden;height:100%;">
              <div style="background:#1a1d2b;padding:8px 12px;border-bottom:1px solid #2d3140;">
                <span style="font-size:0.72rem;font-weight:600;color:#aaa;text-transform:uppercase;letter-spacing:0.05em;">Evaluator Library</span>
                <input id="pb-eval-filter" oninput="_filterBuilderLibrary()" class="form-control form-control-sm mt-2"
                  style="font-size:0.75rem;background:#0d1017;border-color:#2d3140;color:#ccc;" placeholder="Filter evaluators…"/>
              </div>
              <div id="pb-eval-library" style="max-height:480px;overflow-y:auto;">
                <div style="padding:12px;color:#555;font-size:0.78rem;">Load Policy Stack to populate library.</div>
              </div>
            </div>
          </div>

          <!-- Right: Pack Composer -->
          <div class="col-md-8">
            <div style="border:1px solid #2d3140;border-radius:6px;overflow:hidden;">
              <div style="background:#1a1d2b;padding:8px 14px;border-bottom:1px solid #2d3140;display:flex;align-items:center;justify-content:space-between;">
                <span id="pb-composer-title" style="font-size:0.72rem;font-weight:600;color:#aaa;text-transform:uppercase;letter-spacing:0.05em;">New Pack</span>
                <button onclick="resetPackBuilder()" style="font-size:0.7rem;background:#1a2330;color:#888;border:1px solid #2d3140;border-radius:4px;padding:1px 10px;cursor:pointer;">
                  <i class="bi bi-plus me-1"></i>New
                </button>
              </div>
              <div style="padding:14px 16px;">

                <!-- Pack Metadata -->
                <div class="row g-2 mb-3">
                  <div class="col-md-4">
                    <label style="font-size:0.68rem;color:#666;display:block;margin-bottom:2px;">Pack ID <span style="color:#e74c3c;">*</span></label>
                    <input id="pb-pack-id" class="form-control form-control-sm"
                      style="font-size:0.78rem;background:#0d1017;border-color:#2d3140;color:#ccc;font-family:monospace;"
                      placeholder="my_custom_pack"/>
                  </div>
                  <div class="col-md-4">
                    <label style="font-size:0.68rem;color:#666;display:block;margin-bottom:2px;">
                      Layer
                      <span style="cursor:help;color:#555;font-size:0.75rem;" title="Controls which execution tier this pack runs in. Tier 1 packs run on every request before any domain pack. Tier 2 packs are domain or regulatory add-ons. Tier 3 packs are regional or advisory overlays.">ⓘ</span>
                    </label>
                    <select id="pb-layer" class="form-select form-select-sm" style="font-size:0.78rem;background:#0d1017;border-color:#2d3140;color:#ccc;">
                      <option value="domain-addon">Tier 2 — Domain Add-on</option>
                      <option value="regulatory">Tier 2 — Regulatory</option>
                      <option value="domain-mandatory">Tier 1 — Domain Mandatory</option>
                      <option value="regional">Tier 3 — Regional</option>
                      <option value="advisory">Tier 3 — Advisory</option>
                      <option value="mandatory">Tier 1 — Mandatory (protected)</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label style="font-size:0.68rem;color:#666;display:block;margin-bottom:2px;">Enforcement</label>
                    <select id="pb-enforcement" class="form-select form-select-sm" style="font-size:0.78rem;background:#0d1017;border-color:#2d3140;color:#ccc;">
                      <option value="flexible">Flexible (can enable/disable)</option>
                      <option value="always-on">Always-On (cannot disable)</option>
                      <option value="flexible-threshold-only">Sensitivity-Adjustable (threshold only)</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label style="font-size:0.68rem;color:#666;display:block;margin-bottom:2px;display:flex;align-items:center;gap:4px;">
                      Mode
                      <span style="cursor:help;color:#555;font-size:0.75rem;"
                        title="Pack-level execution mode. Collect All: all dimensions run, results aggregated. Abort on Violation: pack stops at the first COERCIVE result. Individual dimensions can override this with their own Abort flag — a dimension with Abort checked will always stop the pack on COERCIVE, even in Collect All mode.">ⓘ</span>
                    </label>
                    <select id="pb-mode" class="form-select form-select-sm" style="font-size:0.78rem;background:#0d1017;border-color:#2d3140;color:#ccc;">
                      <option value="collect-all">⊕ Collect All — aggregate all results</option>
                      <option value="abort-on-first-coercive">⚡ Abort on Violation — stop at first COERCIVE</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label style="font-size:0.68rem;color:#666;display:block;margin-bottom:2px;">Version</label>
                    <input id="pb-version" class="form-control form-control-sm" value="1.0.0"
                      style="font-size:0.78rem;background:#0d1017;border-color:#2d3140;color:#ccc;"/>
                  </div>
                  <div class="col-md-8">
                    <label style="font-size:0.68rem;color:#666;display:block;margin-bottom:2px;">Owner</label>
                    <input id="pb-owner" class="form-control form-control-sm"
                      style="font-size:0.78rem;background:#0d1017;border-color:#2d3140;color:#ccc;" placeholder="team-name"/>
                  </div>
                  <div class="col-12">
                    <label style="font-size:0.68rem;color:#666;display:block;margin-bottom:2px;">Description</label>
                    <textarea id="pb-description" class="form-control form-control-sm" rows="2"
                      style="font-size:0.78rem;background:#0d1017;border-color:#2d3140;color:#ccc;resize:none;"
                      placeholder="What does this pack govern?"></textarea>
                  </div>
                </div>

                <!-- Mandatory lock banner -->
                <div id="pb-locked-banner" style="display:none;background:#2a1a00;border:1px solid #f39c1244;border-radius:4px;padding:8px 12px;margin-bottom:12px;font-size:0.78rem;color:#f39c12;">
                  <i class="bi bi-shield-lock me-2"></i>
                  <strong>Inspect mode</strong> — this is a mandatory pack. Fields are read-only. To change its dimensions, edit <code>policy_packs.yaml</code> directly.
                </div>

                <!-- Dimensions -->
                <div style="font-size:0.68rem;color:#555;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">
                  Dimensions <span id="pb-dim-count" style="color:#3498db;"></span>
                </div>
                <div id="pb-dims-container">
                  <p style="color:#555;font-size:0.78rem;font-style:italic;padding:8px 0;">No evaluators added yet — click <strong style="color:#2ecc71;">+</strong> in the library to add.</p>
                </div>

                <!-- Trust-Signal Adjustments (read-only display) -->
                <div id="pb-adj-section" style="display:none;margin-top:10px;padding:8px 10px;background:#0a0c12;border:1px solid #2d3140;border-radius:4px;">
                  <div style="font-size:0.65rem;color:#444;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px;display:flex;align-items:center;gap:4px;">
                    Trust-Signal Adjustments (read-only)
                    <span style="cursor:help;color:#555;font-size:0.75rem;text-transform:none;letter-spacing:0;"
                      title="Threshold step-shifts driven by session or app trust scores. These are preserved on save but cannot be edited in the UI yet — modify context_adjustments in policy_packs.yaml directly.">ⓘ</span>
                  </div>
                  <div id="pb-adj-rows" style="font-size:0.72rem;color:#888;"></div>
                </div>

                <!-- Action buttons -->
                <div class="d-flex gap-2 mt-3 flex-wrap align-items-center">
                  <button id="pb-save-btn" onclick="savePackBuilder()"
                    style="font-size:0.78rem;background:#1a3a2a;color:#2ecc71;border:1px solid #2ecc7144;border-radius:4px;padding:4px 16px;cursor:pointer;">
                    <i class="bi bi-cloud-upload me-1"></i>Save Pack
                  </button>
                  <button id="pb-delete-btn" onclick="_deleteStep1()" style="display:none;font-size:0.78rem;background:#3a1a1a;color:#e74c3c;border:1px solid #e74c3c44;border-radius:4px;padding:4px 16px;cursor:pointer;">
                    <i class="bi bi-trash me-1"></i>Delete Pack
                  </button>
                  <span id="pb-delete-confirm" style="display:none;align-items:center;gap:6px;">
                    <span style="font-size:0.75rem;color:#e74c3c;">Delete permanently?</span>
                    <button onclick="deletePackBuilder()" style="font-size:0.75rem;background:#5a1a1a;color:#e74c3c;border:1px solid #e74c3c88;border-radius:4px;padding:2px 12px;cursor:pointer;">Yes, delete</button>
                    <button onclick="_deleteCancel()" style="font-size:0.75rem;background:#1a1d2b;color:#888;border:1px solid #2d3140;border-radius:4px;padding:2px 10px;cursor:pointer;">Cancel</button>
                  </span>
                  <button onclick="resetPackBuilder()"
                    style="font-size:0.78rem;background:#1a1d2b;color:#888;border:1px solid #2d3140;border-radius:4px;padding:4px 14px;cursor:pointer;">
                    New Pack
                  </button>
                </div>

              </div>
            </div>
          </div>

        </div>
          </div><!-- end ps-builder-container -->
        </div><!-- end ps-sub-builder -->

      </div><!-- end sub tab-content -->
    </div><!-- end tab-stack -->

    <!-- ====================================================== -->
    <!-- TAB — APP STACKS                                        -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-appstacks">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0"><i class="bi bi-diagram-2 me-2 text-info"></i>App Policy Stack</h6>
          <small class="text-muted">Register applications and manage their policy pack assignments.</small>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" onclick="loadAppStacks()">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
          </button>
          <button class="btn btn-sm" onclick="_asShowNewAppInput()"
            style="background:#1a3a2a;color:#2ecc71;border:1px solid #2ecc7144;">
            <i class="bi bi-plus-circle me-1"></i>Register New App
          </button>
        </div>
      </div>

      <!-- New app input bar (hidden by default) -->
      <div id="as-new-app-bar" style="display:none;background:#13161f;border:1px solid #2ecc7133;border-radius:6px;padding:12px 16px;margin-bottom:12px;display:none;">
        <div class="d-flex gap-2 align-items-center">
          <span style="font-size:0.82rem;color:#aaa;white-space:nowrap;">App ID:</span>
          <input id="as-new-app-id" type="text" placeholder="e.g. mybank"
            style="flex:1;background:#0d0f18;border:1px solid #3a4060;border-radius:4px;color:#e0e0e0;font-family:monospace;font-size:0.82rem;padding:4px 10px;"
            onkeydown="if(event.key==='Enter') _asStartOnboarding(document.getElementById('as-new-app-id').value.trim())"/>
          <button onclick="_asStartOnboarding(document.getElementById('as-new-app-id').value.trim())"
            style="background:#1a3a2a;color:#2ecc71;border:1px solid #2ecc7144;border-radius:4px;padding:4px 14px;font-size:0.8rem;cursor:pointer;">
            Continue
          </button>
          <button onclick="document.getElementById('as-new-app-bar').style.display='none'"
            style="background:transparent;color:#666;border:1px solid #2d3140;border-radius:4px;padding:4px 10px;font-size:0.8rem;cursor:pointer;">
            Cancel
          </button>
        </div>
      </div>

      <div class="row g-3">
        <!-- Left: App list -->
        <div class="col-12 col-md-3">
          <div style="background:#13161f;border:1px solid #3a4060;border-radius:6px;overflow:hidden;">
            <div id="as-app-list" style="min-height:120px;">
              <div style="padding:20px 12px;color:#8899aa;font-size:0.8rem;">Loading…</div>
            </div>
          </div>
        </div>

        <!-- Right: Stack for selected app -->
        <div class="col-12 col-md-9">
          <div id="as-stack-panel" style="background:#13161f;border:1px solid #3a4060;border-radius:6px;min-height:200px;">
            <div style="padding:20px;color:#8899aa;font-size:0.85rem;text-align:center;margin-top:20px;">
              <i class="bi bi-arrow-left me-1"></i>Select an app to view its policy stack
            </div>
          </div>
        </div>
      </div>

      <!-- Propagation modal -->
      <div class="modal fade" id="as-propagate-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
          <div class="modal-content" style="background:#0d0f18;border:1px solid #2d3140;color:#ccc;">
            <div class="modal-header" style="border-bottom:1px solid #2d3140;padding:12px 16px;">
              <h6 class="modal-title mb-0" style="font-size:0.9rem;">
                <i class="bi bi-share me-2 text-info"></i>Propagate Overrides
              </h6>
              <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:16px;">
              <p id="as-prop-desc" style="font-size:0.82rem;color:#aaa;margin-bottom:12px;"></p>
              <div id="as-prop-app-list" style="display:flex;flex-direction:column;gap:6px;"></div>
              <p style="font-size:0.75rem;color:#e67e22;margin-top:12px;margin-bottom:0;">
                <i class="bi bi-exclamation-triangle me-1"></i>Existing overrides in selected apps will be replaced.
              </p>
            </div>
            <div class="modal-footer" style="border-top:1px solid #2d3140;padding:10px 16px;">
              <button class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button class="btn btn-sm" id="as-prop-confirm-btn"
                style="background:#1a3a4a;color:#3498db;border:1px solid #3498db44;"
                onclick="_asPropagateConfirm()">
                <i class="bi bi-share me-1"></i>Propagate
              </button>
            </div>
          </div>
        </div>
      </div>
    </div><!-- end tab-appstacks -->

    <!-- ====================================================== -->
    <!-- TAB — CORPORATE POLICY                                  -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-corpolicy">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0"><i class="bi bi-building-gear me-2 text-info"></i>Corporate AI Usage Policy</h6>
          <small class="text-muted">Manage the signal list that drives the <code>corporate_policy</code> dimension (mandatory pack, in-process classifier).</small>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span id="cp-count" class="badge bg-secondary" style="font-size:0.72rem;">–</span>
          <button class="btn btn-sm btn-outline-secondary" onclick="loadCorpPolicy()">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
          </button>
          <button id="cp-save-btn" class="btn btn-sm btn-publish" onclick="_cpSave()">
            <i class="bi bi-cloud-upload me-1"></i>Save &amp; Reload Classifier
          </button>
        </div>
      </div>

      <!-- Status bar -->
      <div style="font-size:0.72rem;color:#6688aa;margin-bottom:14px;font-style:italic;" id="cp-status"></div>

      <!-- Enforcement mode -->
      <div class="card mb-3">
        <div class="card-header" style="font-size:0.8rem;">
          <i class="bi bi-shield-half me-2"></i>Enforcement Mode
        </div>
        <div class="card-body py-3 px-3" style="display:flex;align-items:center;gap:16px;">
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="cp-enforce-toggle"
                   onchange="_cpToggleEnforce(this.checked)" style="cursor:pointer;" />
          </div>
          <div>
            <div id="cp-enforce-label" style="font-size:0.85rem;font-weight:600;color:#ffe066;">Warn only (NORMATIVE, no hard block)</div>
            <div style="font-size:0.72rem;color:#6688aa;margin-top:2px;">
              <b>Off</b> = score capped at 6 (NORMATIVE warn) &nbsp;·&nbsp;
              <b>On</b> = score 8 on 2+ signals (COERCIVE block) &nbsp;·&nbsp;
              Recommended: keep Off until AUP is finalised
            </div>
          </div>
        </div>
      </div>

      <!-- Signal chips -->
      <div class="card mb-3">
        <div class="card-header" style="font-size:0.8rem;">
          <i class="bi bi-tags me-2"></i>Signal List
          <span style="font-size:0.7rem;color:#6688aa;font-weight:400;margin-left:8px;">
            Matched case-insensitively as substrings. 1 hit = warn, 2+ hits = enforce action above.
          </span>
        </div>
        <div class="card-body">
          <!-- Chips -->
          <div id="cp-chips" style="min-height:48px;line-height:2.2;margin-bottom:12px;">
            <span style="color:#555;font-size:0.8rem;">Loading…</span>
          </div>
          <!-- Add new signal -->
          <div style="display:flex;gap:8px;align-items:center;margin-top:8px;">
            <input id="cp-new-signal" type="text" class="form-control form-control-sm"
                   style="max-width:360px;font-size:0.82rem;"
                   placeholder="e.g. strictly confidential"
                   onkeydown="if(event.key==='Enter') _cpAddSignal();" />
            <button class="btn btn-sm btn-outline-info" onclick="_cpAddSignal()">
              <i class="bi bi-plus me-1"></i>Add Signal
            </button>
          </div>
        </div>
      </div>

      <!-- Pack config (read-only) -->
      <div class="card">
        <div class="card-header" style="font-size:0.8rem;">
          <i class="bi bi-layers me-2"></i>Mandatory Pack Entry <span style="font-size:0.7rem;color:#6688aa;font-weight:400;">(read-only — edit policy_packs.yaml directly)</span>
        </div>
        <div class="card-body py-2">
          <table class="table table-sm mb-0" style="font-size:0.78rem;">
            <tbody>
              <tr><td class="text-muted" style="width:150px;">Pack</td><td><code>mandatory</code></td></tr>
              <tr><td class="text-muted">Dimension</td><td><code>corporate_policy</code></td></tr>
              <tr><td class="text-muted">Provider</td><td><code>local_policy_classifier</code> — in-process, zero latency</td></tr>
              <tr><td class="text-muted">Profile</td><td><code>standard</code> — permissive 1–3, normative 4–6, coercive 7–9</td></tr>
              <tr><td class="text-muted">Severity</td><td>2 — Medium</td></tr>
              <tr><td class="text-muted">Abort on COERCIVE</td><td>No — chain continues, verdict recorded in audit</td></tr>
              <tr><td class="text-muted">Roles evaluated</td><td><code>user_prompt</code> only</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div><!-- end tab-corpolicy -->

    <!-- ====================================================== -->
    <!-- TAB — SESSION POLICY                                    -->
    <!-- ====================================================== -->
    <div class="tab-pane fade" id="tab-session-policy">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h6 class="mb-0">Session Tracking Policy</h6>
          <small class="text-muted">Controls per-session trust scoring, idle timeout, and prompt deduplication thresholds. Writes to <code>policy-engine/config/session_policy.yaml</code> with hot-reload.</small>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" onclick="loadSessionPolicy()">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
          </button>
          <button class="btn btn-sm btn-publish" onclick="_spSave()">
            <i class="bi bi-floppy me-1"></i>Save &amp; Reload
          </button>
        </div>
      </div>

      <div id="sp-alert" class="alert d-none mb-3" role="alert"></div>

      <div class="row g-4">

        <!-- Trust Score Deltas -->
        <div class="col-md-5">
          <div class="card">
            <div class="card-header"><i class="bi bi-graph-down-arrow me-2 text-warning"></i>Trust Score Deltas</div>
            <div class="card-body">
              <p class="text-muted mb-3" style="font-size:0.8rem;">Adjustments applied to the per-session trust score (starts at 1.0) after each turn verdict. The trust score feeds the <code>session_guard</code> pack's <code>session_risk_signal</code> policy.</p>
              <div class="row g-2 mb-2">
                <div class="col-4">
                  <label class="form-label mb-1" style="font-size:0.75rem; color:#ff8080;">COERCIVE</label>
                  <input type="number" class="form-control form-control-sm" id="sp-delta-coercive" step="0.01" min="-1" max="0">
                </div>
                <div class="col-4">
                  <label class="form-label mb-1" style="font-size:0.75rem; color:#ffe066;">NORMATIVE</label>
                  <input type="number" class="form-control form-control-sm" id="sp-delta-normative" step="0.01" min="-1" max="0">
                </div>
                <div class="col-4">
                  <label class="form-label mb-1" style="font-size:0.75rem; color:#6fcf97;">PERMISSIVE</label>
                  <input type="number" class="form-control form-control-sm" id="sp-delta-permissive" step="0.01" min="0" max="1">
                </div>
              </div>
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label mb-1" style="font-size:0.75rem; color:#aaa;">Trust Floor</label>
                  <input type="number" class="form-control form-control-sm" id="sp-trust-floor" step="0.01" min="0" max="1">
                  <div class="form-text" style="font-size:0.7rem;">Session terminated when reached.</div>
                </div>
                <div class="col-6">
                  <label class="form-label mb-1" style="font-size:0.75rem; color:#aaa;">Trust Ceiling</label>
                  <input type="number" class="form-control form-control-sm" id="sp-trust-ceiling" step="0.01" min="0" max="1">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TTL + Dedup -->
        <div class="col-md-7">
          <div class="card mb-3">
            <div class="card-header"><i class="bi bi-clock me-2 text-info"></i>Session Timeout</div>
            <div class="card-body">
              <div class="row g-2 align-items-end">
                <div class="col-5">
                  <label class="form-label mb-1" style="font-size:0.75rem; color:#aaa;">Idle TTL (seconds)</label>
                  <input type="number" class="form-control form-control-sm" id="sp-ttl" step="60" min="60">
                </div>
                <div class="col-7">
                  <div class="text-muted" style="font-size:0.75rem;" id="sp-ttl-human">—</div>
                </div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header"><i class="bi bi-fingerprint me-2 text-primary"></i>Prompt Deduplication</div>
            <div class="card-body">
              <p class="text-muted mb-3" style="font-size:0.8rem;">Detects identical or near-identical prompts within a session using SHA-256 (exact) and cosine similarity (near-duplicate). Near-duplicate prompts add a <em>repetition penalty</em> to the session trust score.</p>
              <div class="row g-2">
                <div class="col-12 mb-2">
                  <div class="d-flex align-items-center gap-3">
                    <label class="form-label mb-0" style="font-size:0.75rem;color:#aaa;min-width:120px;">Exact-match block</label>
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" id="sp-dedup-exact" onchange="_spTtlHint()">
                    </div>
                    <span class="text-muted" style="font-size:0.73rem;">Block identical prompts (SHA-256) without calling guardrails.</span>
                  </div>
                </div>
                <div class="col-5">
                  <label class="form-label mb-1" style="font-size:0.75rem;color:#aaa;">Similarity Threshold</label>
                  <input type="number" class="form-control form-control-sm" id="sp-dedup-threshold" step="0.01" min="0.5" max="1.0">
                  <div class="form-text" style="font-size:0.7rem;">Cosine sim above which prompts are near-duplicates. 0.92 = tight.</div>
                </div>
                <div class="col-3">
                  <label class="form-label mb-1" style="font-size:0.75rem;color:#aaa;">Window</label>
                  <input type="number" class="form-control form-control-sm" id="sp-dedup-window" step="5" min="5" max="500">
                  <div class="form-text" style="font-size:0.7rem;">Past prompts to compare against.</div>
                </div>
                <div class="col-4">
                  <label class="form-label mb-1" style="font-size:0.75rem;color:#aaa;">Repetition Penalty</label>
                  <input type="number" class="form-control form-control-sm" id="sp-dedup-penalty" step="0.01" min="-1" max="0">
                  <div class="form-text" style="font-size:0.7rem;">Extra trust delta on near-dup detection.</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- row -->
    </div><!-- end tab-session-policy -->

  </div><!-- end tab-content -->
</div>

<!-- Toast Container -->
<div id="toast-container"></div>

<!-- ============================================================ -->
<!-- POLICY EDIT MODAL                                            -->
<!-- ============================================================ -->
<div class="modal fade" id="policyModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-pencil-square me-2 text-info"></i>Edit Policy — <span id="modal-dim-name"></span></h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="modal-dimension" />
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label text-muted" style="font-size:0.78rem;">Severity</label>
            <select class="form-select" id="modal-severity">
              <option value="1">1 — Low</option>
              <option value="2">2 — Medium</option>
              <option value="3">3 — High</option>
            </select>
          </div>
          <div class="col-12"><hr class="border-secondary" /></div>
          <div class="col-12">
            <label class="form-label text-muted" style="font-size:0.78rem;">THRESHOLDS (canonical scale 1-9)</label>
          </div>
          <div class="col-md-4">
            <label class="form-label" style="font-size:0.82rem;"><span class="badge badge-permissive me-1">PERMISSIVE</span> Range</label>
            <div class="input-group input-group-sm">
              <input type="number" class="form-control" id="modal-perm-lo" min="1" max="9" step="0.5" placeholder="lo" />
              <span class="input-group-text bg-dark border-secondary">–</span>
              <input type="number" class="form-control" id="modal-perm-hi" min="1" max="9" step="0.5" placeholder="hi" />
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label" style="font-size:0.82rem;"><span class="badge badge-normative me-1">NORMATIVE</span> Range</label>
            <div class="input-group input-group-sm">
              <input type="number" class="form-control" id="modal-norm-lo" min="1" max="9" step="0.5" placeholder="lo" />
              <span class="input-group-text bg-dark border-secondary">–</span>
              <input type="number" class="form-control" id="modal-norm-hi" min="1" max="9" step="0.5" placeholder="hi" />
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label" style="font-size:0.82rem;"><span class="badge badge-coercive me-1">COERCIVE</span> Range</label>
            <div class="input-group input-group-sm">
              <input type="number" class="form-control" id="modal-coer-lo" min="1" max="9" step="0.5" placeholder="lo" />
              <span class="input-group-text bg-dark border-secondary">–</span>
              <input type="number" class="form-control" id="modal-coer-hi" min="1" max="9" step="0.5" placeholder="hi" />
            </div>
          </div>
          <div class="col-12"><hr class="border-secondary" /></div>
          <div class="col-12">
            <label class="form-label text-muted" style="font-size:0.78rem;">REMEDIATIONS</label>
          </div>
          <div class="col-12">
            <label class="form-label" style="font-size:0.82rem;"><span class="badge badge-normative me-1">NORMATIVE</span> Message <small class="text-muted">(returned to SDK)</small></label>
            <textarea class="form-control" id="modal-rem-norm" rows="2" placeholder="Guidance shown to SDK caller on normative verdict…"></textarea>
          </div>
          <div class="col-12">
            <label class="form-label" style="font-size:0.82rem;"><span class="badge badge-coercive me-1">COERCIVE</span> Message <small class="text-muted">(returned to SDK)</small></label>
            <textarea class="form-control" id="modal-rem-coer" rows="2" placeholder="Guidance shown to SDK caller on coercive verdict…"></textarea>
          </div>
          <div class="col-12"><hr class="border-secondary" /></div>
          <div class="col-12">
            <label class="form-label text-muted" style="font-size:0.78rem;">REMEDIATION ACTIONS</label>
            <small class="text-muted d-block mb-2" style="font-size:0.72rem;">Ops-level actions triggered on non-permissive verdicts for this dimension.</small>
          </div>
          <div class="col-12">
            <label class="form-label" style="font-size:0.82rem;"><i class="bi bi-sticky me-1 text-warning"></i>Human Note <small class="text-muted">(context included with verdict payload to SDK)</small></label>
            <textarea class="form-control" id="modal-human-note" rows="2" placeholder="Plain-language context for operators and downstream systems…"></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-size:0.82rem;"><i class="bi bi-bell me-1 text-danger"></i>Ops Alert on COERCIVE</label>
            <div class="form-check form-switch mt-1">
              <input class="form-check-input" type="checkbox" id="modal-ops-alert" />
              <label class="form-check-label text-muted" for="modal-ops-alert" style="font-size:0.8rem;">Raise ops alert when this dimension triggers COERCIVE</label>
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-size:0.82rem;"><i class="bi bi-ticket me-1 text-info"></i>Incident Routing</label>
            <select class="form-select form-select-sm" id="modal-incident-routing">
              <option value="none">None — no incident</option>
              <option value="servicenow">ServiceNow — ITSM ticket</option>
              <option value="pagerduty">PagerDuty — on-call alert</option>
              <option value="email">Email — ops distribution list</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <small class="text-muted me-auto" id="modal-version-info"></small>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="savePolicy()">
          <i class="bi bi-check2 me-1"></i>Save Changes
        </button>
      </div>
    </div>
  </div>
</div>

