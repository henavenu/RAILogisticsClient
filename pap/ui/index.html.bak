          <div class="col-md-6">
            <label class="form-label" style="font-size:0.82rem;"><i class="bi bi-ticket me-1 text-info"></i>Incident Routing</label>
            <select class="form-select form-select-sm" id="ep-incident-routing">
              <option value="none">None — no incident</option>
              <option value="servicenow">ServiceNow — ITSM ticket</option>
              <option value="pagerduty">PagerDuty — on-call alert</option>
              <option value="email">Email — ops distribution list</option>
