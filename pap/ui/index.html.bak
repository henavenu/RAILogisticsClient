            <label class="form-label" style="font-size:0.82rem;"><span class="badge badge-coercive me-1">COERCIVE</span> Message <small class="text-muted">(returned to SDK)</small></label>
            <textarea class="form-control" id="ep-rem-coer" rows="2" placeholder="Guidance shown on coercive verdict… e.g. Request blocked [{ref_id}] — …"></textarea>
          </div>
