              <span class="input-group-text bg-dark border-secondary">–</span>
              <input type="number" class="form-control" id="ep-coer-hi" min="1" max="9" step="0.5" value="9" />
            </div>
          </div>
          <div class="col-12"><hr class="border-secondary" /></div>
          <div class="col-12">
            <label class="form-label text-muted" style="font-size:0.78rem;">REMEDIATIONS <small class="ms-1" style="font-size:0.7rem;">Supports <code>{ref_id}</code>, <code>{app_id}</code>, <code>{session_id}</code> tokens</small></label>
          </div>
