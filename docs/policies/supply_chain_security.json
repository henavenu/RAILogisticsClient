                  "pattern": "'temp_excursion': True",
                  "case_sensitive": true
                }
              }
            },
            "score": 5,
            "reason": "Product left its storage band in transit: hold for Quality disposition"
          }
        ],
        "otherwise": {
          "score": 1,
          "reason": "not applicable"
        }
      }
    }
  ],
