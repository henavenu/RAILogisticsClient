                "value": {
                  "pattern": "'cold_chain_validated': False",
                  "case_sensitive": true
                }
              }
            },
            "score": 8,
            "reason": "Temperature-sensitive product on a non-validated lane (EU GDP ch. 9)"
          }
        ],
        "otherwise": {
          "score": 1,
          "reason": "not applicable"
        }
      }
    },
    {
      "dimension_id": "temperature_excursion",
      "display_name": "Temperature excursion recorded",
      "category": "custom",
      "roles": [
        "tool_call",
        "agent_to_agent"
      ],
      "rule": {
