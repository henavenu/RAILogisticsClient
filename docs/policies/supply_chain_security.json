{
  "pack": {
    "id": "supply_chain_security",
    "definition": {
      "display_name": "Supply Chain Security",
      "description": "DEA suspicious-order monitoring, DSCSA verification, trading-partner authorisation and cold-chain integrity",
      "layer": "domain-addon",
      "enforcement": "flexible",
      "mode": "collect-all",
      "combining_algorithm": "worst_case",
      "hitl_trigger": false,
      "owner": "pharmalogistics",
      "version": "1.0.0",
      "active": true,
      "dimensions": [
        {
          "id": "dea_som_threshold",
          "profile": "standard",
          "severity": 3,
          "abort": false,
          "roles": [
            "tool_call",
            "agent_to_agent"
          ],
          "note": "Controlled-substance volume over SOM threshold"
        },
        {
          "id": "dea_registrant_unverified",
          "profile": "standard",
          "severity": 3,
          "abort": false,
          "roles": [
            "tool_call",
            "agent_to_agent"
          ],
          "note": "Buyer DEA registration not verified"
        },
        {
          "id": "dea_order_of_interest",
          "profile": "standard",
          "severity": 2,
          "abort": false,
          "roles": [
            "tool_call",
            "agent_to_agent"
          ],
          "note": "Order far above the buyer's normal volume"
        },
        {
          "id": "dscsa_product_unverified",
          "profile": "standard",
          "severity": 3,
          "abort": false,
          "roles": [
            "tool_call",
            "agent_to_agent"
          ],
          "note": "Product identifier not verified (DSCSA)"
        },
        {
          "id": "unauthorized_trading_partner",
          "profile": "standard",
          "severity": 3,
          "abort": false,
          "roles": [
            "tool_call",
            "agent_to_agent"
          ],
          "note": "Trading partner not authorised"
        },
        {
          "id": "cold_chain_unvalidated",
          "profile": "standard",
          "severity": 3,
          "abort": false,
          "roles": [
            "tool_call",
            "agent_to_agent"
          ],
          "note": "Cold-chain lane not validated"
        },
        {
          "id": "temperature_excursion",
          "profile": "standard",
          "severity": 2,
          "abort": false,
          "roles": [
            "tool_call",
            "agent_to_agent"
          ],
          "note": "Temperature excursion recorded"
        }
      ],
      "context_adjustments": []
    }
  },
  "app_id": "pharmalogistics",
  "rules": [
    {
      "dimension_id": "dea_som_threshold",
      "display_name": "Controlled-substance volume over SOM threshold",
      "category": "custom",
      "roles": [
        "tool_call",
        "agent_to_agent"
      ],
      "rule": {
        "rule_id": "dea_som_threshold_v1",
        "dimension": "dea_som_threshold",
        "hit_policy": "F",
        "columns": [
          {
            "field": "content.text",
            "type": "string"
          }
        ],
        "rows": [
          {
            "cells": {
              "content.text": {
                "op": "regex",
                "value": {
                  "pattern": "'cumulative_units_24h': (85(0[1-9]|[1-9]\\d)|8[6-9]\\d\\d|9\\d{3}|[1-9]\\d{4,})(?!\\d)",
                  "case_sensitive": true
                }
              }
            },
            "score": 8,
            "reason": "Cumulative Schedule II orders exceed the 8,500-unit DEA suspicious-order threshold (21 CFR 1301.74)"
          }
        ],
        "otherwise": {
          "score": 1,
          "reason": "not applicable"
        }
      }
    },
    {
      "dimension_id": "dea_registrant_unverified",
      "display_name": "Buyer DEA registration not verified",
      "category": "custom",
      "roles": [
        "tool_call",
        "agent_to_agent"
      ],
      "rule": {
        "rule_id": "dea_registrant_unverified_v1",
        "dimension": "dea_registrant_unverified",
        "hit_policy": "F",
        "columns": [
          {
            "field": "content.text",
            "type": "string"
          }
        ],
        "rows": [
          {
            "cells": {
              "content.text": {
                "op": "regex",
                "value": {
                  "pattern": "'buyer_dea_verified': False",
                  "case_sensitive": true
                }
              }
            },
            "score": 8,
            "reason": "Controlled substances may only ship to a verified DEA registrant"
          }
        ],
        "otherwise": {
          "score": 1,
          "reason": "not applicable"
        }
      }
    },
    {
      "dimension_id": "dea_order_of_interest",
      "display_name": "Order far above the buyer's normal volume",
      "category": "custom",
      "roles": [
        "tool_call",
        "agent_to_agent"
      ],
      "rule": {
        "rule_id": "dea_order_of_interest_v1",
        "dimension": "dea_order_of_interest",
        "hit_policy": "F",
        "columns": [
          {
            "field": "content.text",
            "type": "string"
          }
        ],
        "rows": [
          {
            "cells": {
              "content.text": {
                "op": "regex",
                "value": {
                  "pattern": "'order_vs_baseline_pct': ([3-9]\\d\\d|\\d{4,})(?!\\d)",
                  "case_sensitive": true
                }
              }
            },
            "score": 5,
            "reason": "Order is 300%+ of this buyer's baseline: hold for the SOM compliance officer"
          }
        ],
        "otherwise": {
          "score": 1,
          "reason": "not applicable"
        }
      }
    },
    {
      "dimension_id": "dscsa_product_unverified",
      "display_name": "Product identifier not verified (DSCSA)",
      "category": "custom",
      "roles": [
        "tool_call",
        "agent_to_agent"
      ],
      "rule": {
        "rule_id": "dscsa_product_unverified_v1",
        "dimension": "dscsa_product_unverified",
        "hit_policy": "F",
        "columns": [
          {
            "field": "content.text",
            "type": "string"
          }
        ],
        "rows": [
          {
            "cells": {
              "content.text": {
                "op": "regex",
                "value": {
                  "pattern": "'serial_verified': False",
                  "case_sensitive": true
                }
              }
            },
            "score": 8,
            "reason": "Unit serial number not verified against the manufacturer (DSCSA)"
          }
        ],
        "otherwise": {
          "score": 1,
          "reason": "not applicable"
        }
      }
    },
    {
      "dimension_id": "unauthorized_trading_partner",
      "display_name": "Trading partner not authorised",
      "category": "custom",
      "roles": [
        "tool_call",
        "agent_to_agent"
      ],
      "rule": {
        "rule_id": "unauthorized_trading_partner_v1",
        "dimension": "unauthorized_trading_partner",
        "hit_policy": "F",
        "columns": [
          {
            "field": "content.text",
            "type": "string"
          }
        ],
        "rows": [
          {
            "cells": {
              "content.text": {
                "op": "regex",
                "value": {
                  "pattern": "'trading_partner_authorized': False",
                  "case_sensitive": true
                }
              }
            },
            "score": 8,
            "reason": "Supplier or buyer is not an authorised trading partner (DSCSA / EU GDP)"
          }
        ],
        "otherwise": {
          "score": 1,
          "reason": "not applicable"
        }
      }
    },
    {
      "dimension_id": "cold_chain_unvalidated",
