# policy-engine — environment template.
# Copy to .env and fill in real values. NEVER commit real secrets here.

# Policy Engine — service-level environment config
#
# OWNERSHIP: This file belongs to the Policy Engine ONLY.
# It holds orchestration config — NOT provider credentials.
# Provider credentials live in guardrail-service/.env and are never
# visible to this service.
#
# LAYERING: Values here override anything in the root .env.

# ── Guardrail Service connection ─────────────────────────────────
# The Guardrail Service is a PRIVATE internal dependency of the Policy Engine.
# It must be running before the Policy Engine starts.
#
# Local dev:   http://127.0.0.1:3001  (GS binds to localhost only)
# Docker:      http://guardrail-service:3001  (internal Docker network name)
# Production:  http://<internal-hostname>:3001
GUARDRAIL_SERVICE_URL=http://127.0.0.1:3001

# Timeout for calls to the Guardrail Service (seconds).
# Tune based on real provider latency when MOCK_MODE=false.
GUARDRAIL_TIMEOUT_S=10

# ── Fail Mode (SRS NFR-03) ────────────────────────────────────────
# Controls what verdict is returned when the Guardrail Service is unreachable.
#
#   open   → verdict=PERMISSIVE  — execution proceeds unguarded
#            Suitable for: development and non-critical internal tools
#            Risk: content passes without any evaluation
#
#   closed → verdict=COERCIVE   — execution blocked as a precaution
#            Suitable for: production and customer-facing applications
#            Risk: false positives during Guardrail Service outages
#
# This setting is logged prominently at startup. Change requires restart.
FAIL_MODE=closed

# ── Session Store (Phase 4 — SRS §4.5.5) ─────────────────────────
# SESSION_STORE_TYPE controls where multi-turn session state is persisted.
#
#   sqlite  → SqliteSessionStore    — shared PAP DB; survives restarts, PAP-visible
#                                     DEFAULT when AUDIT_SQLITE_PATH is set
#   memory  → InMemorySessionStore  — zero deps, lost on restart, dev-friendly
#                                     DEFAULT when AUDIT_SQLITE_PATH is not set
#   disk    → DiskSessionStore      — JSON files, survives restarts,
#                                     single-process only (no cross-instance locking)
#
# Explicitly set here to override auto-detection if desired.
# SESSION_STORE_TYPE=sqlite

# Session inactivity TTL in seconds.  Sessions idle longer than this are
# expired and purged.  Default: 1800s (30 minutes).
SESSION_TTL_S=1800

# Path for DiskSessionStore session files (only used when SESSION_STORE_TYPE=disk).
# Relative paths are resolved from the policy-engine/ directory.
# SESSION_DISK_PATH=sessions

# ── Network binding ──────────────────────────────────────────────
# 0.0.0.0 = all interfaces — the Policy Engine IS externally accessible
#           (it is the public-facing API called by the RAI SDK).
PE_HOST=0.0.0.0
PE_PORT=3003

# ── Audit SQLite sink (PAP shared database) ──────────────────────────────────
# Absolute path to the PAP's rai_trust.db.  The SqliteAuditWriter fans out
# every AuditRecord here in addition to the JSONL file.  Metrics APIs in the
# PAP then query this table instead of scanning the JSONL file.
# Leave blank (or unset) to disable the SQLite writer — JSONL-only mode.
AUDIT_SQLITE_PATH=/absolute/path/to/pap.db

# ── Sentinel Agent webhook ───────────────────────────────────────────────────
# When set, the Policy Engine fires an async HTTP POST to the Sentinel Agent
# after each evaluation that meets a trigger condition:
#   (a) verdict == COERCIVE  — immediate high-severity signal
#   (b) turn_number % SENTINEL_TRIGGER_N == 0 — periodic blind-spot scan
#
# The POST is non-blocking (daemon thread) and non-fatal.
# Leave SENTINEL_WEBHOOK_URL blank (or unset) to disable entirely.
#
SENTINEL_WEBHOOK_URL=http://127.0.0.1:3012/evaluate
SENTINEL_TRIGGER_N=5

# ── Sentinel sync client (inline A2A conflict/deadlock detection) ─────────────
# When set, the Policy Engine calls POST /evaluate-sync on the Sentinel Agent
# synchronously (blocking, with timeout) when accumulated agent_to_agent messages
# reach A2A_HITL_THRESHOLD.  Sentinel classifies the exchange as conflict or
# deadlock and returns a NORMATIVE/PERMISSIVE verdict.  A NORMATIVE verdict queues
# a REQUIRE_HUMAN_REVIEW directive that the SDK raises as a HITLInterrupt.
#
# This is completely decoupled from the async observer path above:
#   Sync mode    → PE-initiated, pure evaluator response, no Trust Radar post.
#   Async mode   → Fire-and-forget webhook, Trust Radar as usual.
#
# A2A_HITL_THRESHOLD — total accumulated A2A messages before sync eval fires.
#                      Set to 5 to match the card_advisor 5-step flow:
#                        steps 1-3 (profile/search/suitability) = 3 research evals
#                        steps 4-5 (criteria/suitability positions) = 2 conflict evals
#                      → 5th eval triggers Sentinel sync which sees the deadlock
#                        language in messages 4-5 and returns NORMATIVE → HITL.
# Leave SENTINEL_SYNC_URL blank (or unset) to disable A2A conflict detection.
#
SENTINEL_SYNC_URL=http://127.0.0.1:3012
# Threshold = 5: matches the card_advisor 5-round card_profiler ↔ card_researcher
# negotiation.  Each call to request_card_research = one A2A count.
# Rounds 1-4 proceed normally; Round 5 triggers the sync Sentinel eval.
# Sentinel's LLM infers deadlock from the circular card-result pattern
# (Round 4 repeats Round 1 → no new candidates → portfolio exhausted)
# and returns NORMATIVE → HITLInterrupt fires BEFORE round 5 tool executes.
A2A_HITL_THRESHOLD=5

# ── Content snippets (for Sentinel content-based analysis) ───────────────────
# When true, the SqliteAuditWriter stores up to CONTENT_SNIPPET_MAX_CHARS
# characters of the evaluated text and a SHA-256 hash in the audit table.
# Sentinel's /v1/audit/events response includes content_snippet so the LLM
# judge can reason about actual prompt/response content, not just metadata.
# Default: false (opt-in — snippets add ~2 KB per row to the audit DB).
STORE_CONTENT_SNIPPETS=true
CONTENT_SNIPPET_MAX_CHARS=2000
