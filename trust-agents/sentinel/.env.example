# Sentinel Agent — environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Policy Engine connection ──────────────────────────────────────────────────
# Base URL of the Policy Engine (Sentinel pulls audit events from here).
SENTINEL_PE_URL=http://localhost:3003

# ── LLM provider — priority: Gemini (Vertex) → Anthropic → Azure → Groq → heuristic
# CLOUD = Gemini / Anthropic / Azure; LOCAL = Groq or Anthropic. To force Anthropic,
# set ANTHROPIC_API_KEY and leave GOOGLE_CLOUD_PROJECT UNSET.

# 1) Google Gemini via Vertex AI (cloud) — Application Default Credentials, no key.
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=global          # default 'global'; or a region, e.g. us-central1
# GEMINI_MODEL=gemini-2.5-flash

# 2) Anthropic (cloud fallback / local).  Get key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6     # overrides policy.yaml anthropic_model

# 3) Azure OpenAI (cloud) — set all three (api version optional):
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# OPENAI_API_VERSION=2024-08-01-preview

# 4) Groq — LLaMA (local dev).  Get key at https://console.groq.com
# GROQ_API_KEY=gsk_...

# ── Network binding ───────────────────────────────────────────────────────────
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=3012

# ── Coordinator auto-escalation ──────────────────────────────────────────────
# When set, Sentinel auto-escalates ALERT verdicts to the Coordinator.
# Leave blank to disable (Coordinator can still poll Sentinel independently).
# SENTINEL_COORDINATOR_URL=http://localhost:3013

# ── Tuning ────────────────────────────────────────────────────────────────────
# Path to the policy YAML file (default: ./policy.yaml next to main.py)
# SENTINEL_POLICY_PATH=./policy.yaml

# Timeout for PE audit pull requests (seconds)
# SENTINEL_HTTP_TIMEOUT=5

# ── Emergent-risk detectors (Phase 2/2b/2c) ──────────────────────────────────
# Which always-on specialist detectors the async loop runs (comma-separated):
#   structuring,collusion  (default) | add 'conflict' for async-conflict mode.
# SENTINEL_DETECTORS=structuring,collusion

# ── Platform Agent Activity lens (governance plane as its own graph) ─────────
# ON BY DEFAULT. Mirrors the gate + Sentinel + specialist detectors into the
# Agent Activity UI under app_id=trust-platform (read-only; never affects
# detection). Set to false to disable the mirror entirely.
# PLATFORM_ACTIVITY=false
# Scope/lens name and PAP location (defaults shown):
# PLATFORM_ACTIVITY_APP=trust-platform
# PAP_URL=http://127.0.0.1:3002
