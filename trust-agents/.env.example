# trust-agents — environment template.
# Copy to .env and fill in real values. NEVER commit real secrets here.

# Trust Agents Service — local config
# Overrides root .env for service-specific values

# ── Service ───────────────────────────────────────────────────────────────────
PORT=3005
TA_DB_PATH=./ta.db

# ── PAP (data source) ─────────────────────────────────────────────────────────
PAP_URL=http://localhost:3002
COLLECT_TIMEOUT_SECONDS=10

# ── LLM — Ollama local (default) ─────────────────────────────────────────────
# Swap LLM_BASE_URL to use external API (Claude, OpenAI) without code changes
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=phi3:mini
#LLM_MODEL=mistral:7b-instruct-q4_K_M
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=300

# ── Schedule ──────────────────────────────────────────────────────────────────
# 30-min interval: LLM findings are persisted; run on-demand (Run Now) for immediacy.
# Increase further (60, 120) if Ollama CPU load is still too high.
SNAPSHOT_INTERVAL_MINUTES=30
CONTEXT_RUNS=4
