# guardrail-service — environment template.
# Copy to .env and fill in real values. NEVER commit real secrets here.

# Guardrail Service — service-level environment config
#
# OWNERSHIP: This file belongs to the Guardrail Service ONLY.
# The Policy Engine and PAP must NOT have access to these credentials.
# Provider API keys live here and nowhere else.
#
# LAYERING: Values here override anything in the root .env.

# ── Mock Mode ────────────────────────────────────────────────────
# true  = route ALL dimensions to MockProvider (content-aware keyword scoring,
#         no credentials needed, realistic non-PASS responses for bad content).
#         USE THIS in dev until Azure/AWS credentials are configured.
#
# false = route dimensions to their assigned providers (Azure, AWS, etc.).
#         Providers with missing credentials fail-open (score=1/PASS) by default.
#         The startup log will show a ★ WARNING for each unconfigured provider.
MOCK_MODE=true

# Named mock scenario (only used when MOCK_MODE=true).
# Leave BLANK for content-aware keyword scoring.
# Options: clean | borderline | data_breach | hate_speech | multi_violation
MOCK_SCENARIO=

# ── Azure Content Safety ─────────────────────────────────────────
# Required when MOCK_MODE=false and any dimension routes to azure_content_safety.
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_API_KEY=your-azure-api-key

# ── AWS Bedrock Guardrail ────────────────────────────────────────
# Required when MOCK_MODE=false and any dimension routes to aws_bedrock_guardrail.
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_BEDROCK_GUARDRAIL_ARN=arn:aws:bedrock:us-east-2:123456789012:guardrail/your-guardrail-id

# ── Network binding ──────────────────────────────────────────────
# 127.0.0.1 = localhost only — private, unreachable from outside this machine.
#             Recommended for local dev and bare-metal deployments.
#             The Policy Engine calls this service on localhost.
#
# 0.0.0.0   = all interfaces — required for Docker / containerised deployments
#             where GS and PE run in separate containers on a private network.
GS_HOST=127.0.0.1
GS_PORT=3001

# ── PAP shared database ──────────────────────────────────────────
# Absolute path to the PAP's pap.db.  When set, the GS reads its
# evaluation taxonomy and provider/mock config from the DB instead
# of YAML files.  Leave blank to use YAML-only fallback mode.
PAP_DB_PATH=/absolute/path/to/pap.db
