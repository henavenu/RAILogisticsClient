{
  "_comment": [
    "RAI Trust Platform — Claude Code hooks template.",
    "Deploy this as ~/.claude/settings.json (per-user) or as a project-level",
    ".claude/settings.json in the repository root.",
    "",
    "Environment variables used by rai_governance_check.py:",
    "  RAI_PE_URL      Policy Engine URL  (default: http://localhost:3000)",
    "  RAI_APP_ID      App identifier     (default: claude-code)",
    "  RAI_FAIL_MODE   open | closed      (default: open)",
    "  RAI_TIMEOUT     HTTP timeout secs  (default: 5)",
    "",
    "The script requires only Python stdlib — no extra packages.",
    "Replace the command path with the absolute path to rai_governance_check.py",
    "on your machine, or add the tools/ directory to PATH."
  ],

  "env": {
    "RAI_PE_URL":    "http://localhost:3000",
    "RAI_APP_ID":    "claude-code",
    "RAI_FAIL_MODE": "open"
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/shara/Cursor Projects/rai-trust-platform/tools/rai_governance_check.py",
            "_note": "Replace path with actual location. Exit 2 = block tool call."
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/shara/Cursor Projects/rai-trust-platform/tools/rai_governance_check.py post",
            "_note": "Evaluates tool output (llm_response role). Exit 2 = suppress response."
          }
        ]
      }
    ]
  }
}
